@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:MarissaNadler a owl:NamedIndividual,
        ns1:FineArtist,
        ns1:SingerSongwriter ;
    rdfs:label "Marissa Nadler"^^xsd:string ;
    ns1:activeFrom 2000 ;
    ns1:associatedWithGenre ns1:BlackMetalGenre,
        ns1:CountryGenre,
        ns1:DreamFolkGenre,
        ns1:ExperimentalGenre,
        ns1:FolkGenre ;
    ns1:basedIn ns1:Boston ;
    ns1:birthDate "April 5, 1981"^^xsd:string ;
    ns1:hasNationality ns1:UnitedStates ;
    ns1:hasVocalDescription ns1:BostonGlobeVocalDescription,
        ns1:PitchforkVocalDescription ;
    ns1:hasVoiceType ns1:MezzoSoprano ;
    ns1:releasedAlbum ns1:StrangersAlbum ;
    ns1:reviewedBy ns1:Pitchfork,
        ns1:TheBostonGlobe ;
    ns1:signedTo ns1:BellaUnion,
        ns1:SacredBonesRecords ;
    ns1:styleLabel "dream folk"^^xsd:string .

ns1:activeFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range xsd:integer .

ns1:albumNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:StudioAlbum ;
    rdfs:range xsd:integer .

ns1:associatedWithGenre a owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:MusicGenre .

ns1:basedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:City .

ns1:birthDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:descriptionText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VocalDescription ;
    rdfs:range xsd:string .

ns1:hasNationality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Country .

ns1:hasVocalDescription a owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:VocalDescription .

ns1:hasVoiceType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:VoiceType .

ns1:locatedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:City ;
    rdfs:range ns1:Place .

ns1:publishedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VocalDescription ;
    rdfs:range ns1:Publication .

ns1:releaseDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range xsd:string .

ns1:releasedAlbum a owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:Album .

ns1:reviewedBy a owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:Publication .

ns1:signedTo a owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:RecordLabel .

ns1:styleLabel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range xsd:string .

ns1:AdministrativeDivision a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:BellaUnion a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Bella Union"^^xsd:string .

ns1:BlackMetalGenre a owl:NamedIndividual,
        ns1:MusicGenre ;
    rdfs:label "black metal"^^xsd:string .

ns1:Boston a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Boston"^^xsd:string ;
    ns1:locatedIn ns1:Massachusetts .

ns1:BostonGlobeVocalDescription a owl:NamedIndividual,
        ns1:VocalDescription ;
    rdfs:label "The Boston Globe vocal description"^^xsd:string ;
    ns1:descriptionText "She has a voice that, in mythological times, could have lured men to their deaths at sea, an intoxicating soprano drenched in gauzy reverb that hits bell-clear heights, lingers, and tapers off like rings of smoke"^^xsd:string ;
    ns1:publishedBy ns1:TheBostonGlobe .

ns1:CountryGenre a owl:NamedIndividual,
        ns1:MusicGenre ;
    rdfs:label "country"^^xsd:string .

ns1:CreativeWork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:DreamFolkGenre a owl:NamedIndividual,
        ns1:MusicGenre ;
    rdfs:label "dream folk"^^xsd:string .

ns1:ExperimentalGenre a owl:NamedIndividual,
        ns1:MusicGenre ;
    rdfs:label "experimental"^^xsd:string .

ns1:FineArtist a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:FolkGenre a owl:NamedIndividual,
        ns1:MusicGenre ;
    rdfs:label "folk"^^xsd:string .

ns1:Massachusetts a owl:NamedIndividual,
        ns1:AdministrativeDivision ;
    rdfs:label "Massachusetts"^^xsd:string .

ns1:MezzoSoprano a owl:NamedIndividual,
        ns1:VoiceType ;
    rdfs:label "mezzo-soprano"^^xsd:string .

ns1:PitchforkVocalDescription a owl:NamedIndividual,
        ns1:VocalDescription ;
    rdfs:label "Pitchfork vocal description"^^xsd:string ;
    ns1:descriptionText "you would follow straight into Hades; textured and angelic, with just a hint of pain captured within her iridescent falsetto"^^xsd:string ;
    ns1:publishedBy ns1:Pitchfork .

ns1:SacredBonesRecords a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Sacred Bones Records"^^xsd:string .

ns1:SingerSongwriter a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:StrangersAlbum a owl:NamedIndividual,
        ns1:StudioAlbum ;
    rdfs:label "Strangers"^^xsd:string ;
    ns1:albumNumber 7 ;
    ns1:releaseDate "May 2016"^^xsd:string .

ns1:UnitedStates a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "United States"^^xsd:string .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Organisation a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Pitchfork a owl:NamedIndividual,
        ns1:Publication ;
    rdfs:label "Pitchfork"^^xsd:string .

ns1:StudioAlbum a owl:Class ;
    rdfs:subClassOf ns1:Album .

ns1:TheBostonGlobe a owl:NamedIndividual,
        ns1:Publication ;
    rdfs:label "The Boston Globe"^^xsd:string .

ns1:VoiceType a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Album a owl:Class ;
    rdfs:subClassOf ns1:CreativeWork .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:RecordLabel a owl:Class ;
    rdfs:subClassOf ns1:Organisation .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Publication a owl:Class ;
    rdfs:subClassOf ns1:Organisation .

ns1:VocalDescription a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:MusicGenre a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Musician a owl:Class ;
    rdfs:subClassOf ns1:Person .