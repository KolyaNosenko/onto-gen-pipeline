@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:BoomBloxBashParty a owl:NamedIndividual,
        ns1:PhysicsBasedPuzzleGame ;
    rdfs:label "Boom Blox Bash Party"^^xsd:string ;
    ns1:alternativeTitle "Boom Blox Smash Party"^^xsd:string ;
    ns1:announcedOn "28 January 2009"^^xsd:string ;
    ns1:countsAsOriginalProperty false ;
    ns1:createdUnderDeal ns1:EASpielbergDeal ;
    ns1:designedBy ns1:StevenSpielberg ;
    ns1:developedBy ns1:AmblinEntertainment,
        ns1:EALosAngeles ;
    ns1:developmentBeganAfterCompletionOf ns1:BoomBlox ;
    ns1:hasGameMode ns1:ShootingMode ;
    ns1:hasOnlineFeature ns1:LevelDownload,
        ns1:LevelUpload ;
    ns1:hasReleaseEvent ns1:EuropeRelease,
        ns1:NorthAmericaRelease ;
    ns1:isSequelTo ns1:BoomBlox ;
    ns1:leastFavoriteMode ns1:ShootingMode ;
    ns1:levelCount "more than 400"^^xsd:string ;
    ns1:onlineServersShutDownDate "April 2012"^^xsd:string ;
    ns1:publishedBy ns1:ElectronicArts ;
    ns1:releasedForPlatform ns1:Wii .

ns1:alternativeTitle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:string .

ns1:announcedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:string .

ns1:countsAsOriginalProperty a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:createdUnderDeal a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Deal .

ns1:designedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Person .

ns1:developedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Company .

ns1:developmentBeganAfterCompletionOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGame .

ns1:hasDealParticipant a owl:ObjectProperty ;
    rdfs:domain ns1:Deal ;
    rdfs:range ns1:Company,
        ns1:Person .

ns1:hasGameMode a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameMode .

ns1:hasNewMechanic a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameMechanic .

ns1:hasOnlineFeature a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:OnlineFeature .

ns1:hasReleaseEvent a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:ReleaseEvent .

ns1:inRegion a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:ReleaseEvent ;
    rdfs:range ns1:Region .

ns1:isSequelTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGame .

ns1:leastFavoriteMode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameMode .

ns1:levelCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:string .

ns1:onlineServersShutDownDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:string .

ns1:publishedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Company .

ns1:releaseDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:ReleaseEvent ;
    rdfs:range xsd:string .

ns1:releasedForPlatform a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Platform .

ns1:targetOriginalPropertyCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Deal ;
    rdfs:range xsd:integer .

ns1:AmblinEntertainment a owl:NamedIndividual,
        ns1:Company ;
    rdfs:label "Amblin Entertainment"^^xsd:string .

ns1:EALosAngeles a owl:NamedIndividual,
        ns1:Company ;
    rdfs:label "EA Los Angeles"^^xsd:string .

ns1:EASpielbergDeal a owl:NamedIndividual,
        ns1:Deal ;
    rdfs:label "EA-Spielberg deal"^^xsd:string ;
    ns1:hasDealParticipant ns1:ElectronicArts,
        ns1:StevenSpielberg ;
    ns1:targetOriginalPropertyCount 3 .

ns1:Europe a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "Europe"^^xsd:string .

ns1:EuropeRelease a owl:NamedIndividual,
        ns1:ReleaseEvent ;
    rdfs:label "Europe release"^^xsd:string ;
    ns1:inRegion ns1:Europe ;
    ns1:releaseDate "29 May 2009"^^xsd:string .

ns1:FilmDirector a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:GameMechanic a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:LevelDownload a owl:NamedIndividual,
        ns1:OnlineFeature ;
    rdfs:label "level download"^^xsd:string .

ns1:LevelUpload a owl:NamedIndividual,
        ns1:OnlineFeature ;
    rdfs:label "level upload"^^xsd:string .

ns1:NorthAmerica a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "North America"^^xsd:string .

ns1:NorthAmericaRelease a owl:NamedIndividual,
        ns1:ReleaseEvent ;
    rdfs:label "North America release"^^xsd:string ;
    ns1:inRegion ns1:NorthAmerica ;
    ns1:releaseDate "19 May 2009"^^xsd:string .

ns1:PhysicsBasedPuzzleGame a owl:Class ;
    rdfs:subClassOf ns1:VideoGame .

ns1:Wii a owl:NamedIndividual,
        ns1:Platform ;
    rdfs:label "Wii"^^xsd:string .

ns1:BoomBlox a owl:NamedIndividual,
        ns1:VideoGame ;
    rdfs:label "Boom Blox"^^xsd:string ;
    ns1:designedBy ns1:StevenSpielberg .

ns1:ElectronicArts a owl:NamedIndividual,
        ns1:Company ;
    rdfs:label "Electronic Arts"^^xsd:string .

ns1:Platform a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ShootingMode a owl:NamedIndividual,
        ns1:GameMode ;
    rdfs:label "shooting mode"^^xsd:string .

ns1:GameMode a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:OnlineFeature a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Region a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:StevenSpielberg a owl:NamedIndividual,
        ns1:FilmDirector ;
    rdfs:label "Steven Spielberg"^^xsd:string .

ns1:Deal a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ReleaseEvent a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Company a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VideoGame a owl:Class ;
    rdfs:subClassOf owl:Thing .