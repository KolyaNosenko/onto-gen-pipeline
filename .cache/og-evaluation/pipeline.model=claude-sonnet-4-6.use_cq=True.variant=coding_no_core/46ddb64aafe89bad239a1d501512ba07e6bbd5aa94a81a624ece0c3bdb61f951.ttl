@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:CerebralCortexInst a owl:NamedIndividual,
        ns1:CerebralCortex ;
    rdfs:label "cerebral cortex"^^xsd:string .

ns1:PlaceCellConceptInst a owl:NamedIndividual,
        ns1:PlaceCell ;
    rdfs:label "place cell"^^xsd:string ;
    ns1:foundInRegion ns1:HippocampusInst .

ns1:RatInst a owl:NamedIndividual,
        ns1:Animal ;
    rdfs:label "rat"^^xsd:string ;
    ns1:usedInExperiment ns1:GridCellConceptInst .

ns1:awardedPrize a owl:ObjectProperty ;
    rdfs:domain ns1:Researcher ;
    rdfs:range ns1:Award .

ns1:discoveredAt a owl:ObjectProperty ;
    rdfs:domain ns1:GridCell ;
    rdfs:range ns1:ResearchInstitution .

ns1:discoveryYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:GridCell ;
    rdfs:range xsd:integer .

ns1:firingFieldsAtEqualDistances a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:GridCell ;
    rdfs:range xsd:boolean .

ns1:hasAbbreviation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Institution ;
    rdfs:range xsd:string .

ns1:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:Institution ;
    rdfs:range ns1:Country .

ns1:prizeCategory a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Award ;
    rdfs:range xsd:string .

ns1:prizeYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Award ;
    rdfs:range xsd:integer .

ns1:sharedPrizeWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain ns1:Researcher ;
    rdfs:range ns1:Researcher .

ns1:supportsComputation a owl:ObjectProperty ;
    rdfs:domain ns1:GridCell ;
    rdfs:range ns1:Computation .

ns1:usedInExperiment a owl:ObjectProperty ;
    rdfs:domain ns1:Animal ;
    rdfs:range owl:Thing .

ns1:usesRecordingInstrument a owl:ObjectProperty ;
    rdfs:domain ns1:Neuron ;
    rdfs:range ns1:RecordingInstrument .

ns1:CBMInst a owl:NamedIndividual,
        ns1:ResearchInstitution ;
    rdfs:label "Centre for the Biology of Memory"^^xsd:string ;
    ns1:hasAbbreviation "CBM"^^xsd:string ;
    ns1:locatedIn ns1:NorwayInst .

ns1:DorsomedialEntorhinalCortexInst a owl:NamedIndividual,
        ns1:EntorhinalCortex ;
    rdfs:label "dorsomedial entorhinal cortex"^^xsd:string .

ns1:Electrode a owl:Class ;
    rdfs:subClassOf ns1:RecordingInstrument .

ns1:ElectrodeInst a owl:NamedIndividual,
        ns1:Electrode ;
    rdfs:label "electrode"^^xsd:string .

ns1:EquilateralTrianglePatternInst a owl:NamedIndividual,
        ns1:EquilateralTrianglePattern ;
    rdfs:label "equilateral triangle grid pattern"^^xsd:string .

ns1:EuclideanSpace a owl:Class ;
    rdfs:subClassOf ns1:CognitiveRepresentation .

ns1:EuclideanSpaceInst a owl:NamedIndividual,
        ns1:EuclideanSpace ;
    rdfs:label "Euclidean space"^^xsd:string .

ns1:GridCellConceptInst a owl:NamedIndividual,
        ns1:GridCell ;
    rdfs:label "grid cell"^^xsd:string ;
    ns1:discoveredAt ns1:CBMInst ;
    ns1:discoveredBy ns1:EdvardMoser,
        ns1:MarianneFyhn,
        ns1:MayBrittMoser,
        ns1:SturlaMolden,
        ns1:TorkelHafting ;
    ns1:discoveryYear 2005 ;
    ns1:encodesRepresentation ns1:EuclideanSpaceInst ;
    ns1:firingFieldsAtEqualDistances true ;
    ns1:formsFiringPattern ns1:EquilateralTrianglePatternInst ;
    ns1:recordedInRegion ns1:DorsomedialEntorhinalCortexInst ;
    ns1:supportsComputation ns1:SelfPositionComputationInst ;
    ns1:usesRecordingInstrument ns1:ElectrodeInst .

ns1:HippocampusInst a owl:NamedIndividual,
        ns1:Hippocampus ;
    rdfs:label "hippocampus"^^xsd:string .

ns1:MarianneFyhn a owl:NamedIndividual,
        ns1:Student ;
    rdfs:label "Marianne Fyhn"^^xsd:string .

ns1:NobelPrize a owl:Class ;
    rdfs:subClassOf ns1:Award .

ns1:NorwayInst a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Norway"^^xsd:string .

ns1:PlaceCell a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:foundInRegion ;
            owl:someValuesFrom ns1:Hippocampus ],
        ns1:Neuron .

ns1:SelfPositionComputationInst a owl:NamedIndividual,
        ns1:Computation ;
    rdfs:label "dynamic computation of self-position"^^xsd:string .

ns1:SturlaMolden a owl:NamedIndividual,
        ns1:Student ;
    rdfs:label "Sturla Molden"^^xsd:string .

ns1:TorkelHafting a owl:NamedIndividual,
        ns1:Student ;
    rdfs:label "Torkel Hafting"^^xsd:string .

ns1:discoveredBy a owl:ObjectProperty ;
    rdfs:domain ns1:GridCell ;
    rdfs:range ns1:Person .

ns1:encodesRepresentation a owl:ObjectProperty ;
    rdfs:domain ns1:GridCell ;
    rdfs:range ns1:CognitiveRepresentation .

ns1:formsFiringPattern a owl:ObjectProperty ;
    rdfs:domain ns1:Neuron ;
    rdfs:range ns1:SpatialFiringPattern .

ns1:foundInRegion a owl:ObjectProperty ;
    rdfs:domain ns1:Neuron ;
    rdfs:range ns1:BrainRegion .

ns1:recordedInRegion a owl:ObjectProperty ;
    rdfs:domain ns1:Neuron ;
    rdfs:range ns1:BrainRegion .

ns1:Animal a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:CerebralCortex a owl:Class ;
    rdfs:subClassOf ns1:BrainRegion .

ns1:Computation a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Country a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:EdvardMoser a owl:NamedIndividual,
        ns1:Researcher ;
    rdfs:label "Edvard Moser"^^xsd:string ;
    ns1:awardedPrize ns1:NobelPrize2014Physiology ;
    ns1:sharedPrizeWith ns1:JohnOKeefe .

ns1:EntorhinalCortex a owl:Class ;
    rdfs:subClassOf ns1:CerebralCortex .

ns1:EquilateralTrianglePattern a owl:Class ;
    rdfs:subClassOf ns1:SpatialFiringPattern .

ns1:Hippocampus a owl:Class ;
    rdfs:subClassOf ns1:BrainRegion .

ns1:JohnOKeefe a owl:NamedIndividual,
        ns1:Researcher ;
    rdfs:label "John O'Keefe"^^xsd:string ;
    ns1:awardedPrize ns1:NobelPrize2014Physiology ;
    ns1:sharedPrizeWith ns1:EdvardMoser,
        ns1:MayBrittMoser .

ns1:MayBrittMoser a owl:NamedIndividual,
        ns1:Researcher ;
    rdfs:label "May-Britt Moser"^^xsd:string ;
    ns1:awardedPrize ns1:NobelPrize2014Physiology ;
    ns1:sharedPrizeWith ns1:JohnOKeefe .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:RecordingInstrument a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ResearchInstitution a owl:Class ;
    rdfs:subClassOf ns1:Institution .

ns1:SpatialFiringPattern a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:CognitiveRepresentation a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Institution a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:NobelPrize2014Physiology a owl:NamedIndividual,
        ns1:NobelPrize ;
    rdfs:label "2014 Nobel Prize in Physiology or Medicine"^^xsd:string ;
    ns1:prizeCategory "Physiology or Medicine"^^xsd:string ;
    ns1:prizeYear 2014 .

ns1:Student a owl:Class ;
    rdfs:subClassOf ns1:Researcher .

ns1:Award a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:BrainRegion a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Neuron a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:GridCell a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:discoveredBy ;
            owl:someValuesFrom ns1:Researcher ],
        [ a owl:Restriction ;
            owl:onProperty ns1:encodesRepresentation ;
            owl:someValuesFrom ns1:CognitiveRepresentation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:formsFiringPattern ;
            owl:someValuesFrom ns1:EquilateralTrianglePattern ],
        [ a owl:Restriction ;
            owl:onProperty ns1:recordedInRegion ;
            owl:someValuesFrom ns1:EntorhinalCortex ],
        ns1:Neuron .

ns1:Researcher a owl:Class ;
    rdfs:subClassOf ns1:Person .