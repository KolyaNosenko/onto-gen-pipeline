@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:JoosVanCleve a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Joos van Cleve"^^xsd:string ;
    ns1:activeFromYear 1511 ;
    ns1:activeIn ns1:Antwerp ;
    ns1:activeToYear 1540 ;
    ns1:alternativeName "Joos van der Beke"^^xsd:string ;
    ns1:approximateBirthYear "c. 1485"^^xsd:string ;
    ns1:approximateDeathYear "1540/1541"^^xsd:string ;
    ns1:combinesTechnique ns1:NetherlandishPaintingTechnique ;
    ns1:fatherOf ns1:CornelisVanCleve ;
    ns1:hasArtisticCharacteristic "sensitivity to color"^^xsd:string,
        "unique solidarity of figures"^^xsd:string ;
    ns1:hasGuildRole ns1:CoDeacon ;
    ns1:influencedByStyle ns1:RenaissancePaintingStyle ;
    ns1:introducedTechnique ns1:BroadLandscapesTechnique ;
    ns1:knownFor ns1:PortraitsOfRoyalty,
        ns1:ReligiousWorks ;
    ns1:memberOf ns1:GuildOfSaintLukeOfAntwerp .

ns1:activeFromYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:integer .

ns1:activeIn a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Place .

ns1:activeToYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:integer .

ns1:alternativeName a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:approximateBirthYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:approximateDeathYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:becameMentallyIll a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:boolean .

ns1:becamePopularIn a owl:ObjectProperty ;
    rdfs:domain ns1:PaintingTechnique ;
    rdfs:range ns1:ArtisticMovement .

ns1:birthYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:integer .

ns1:combinesTechnique a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingTechnique .

ns1:deathYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:integer .

ns1:fatherOf a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Person .

ns1:hasArtisticCharacteristic a owl:DatatypeProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:string .

ns1:hasGuildRole a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:GuildRole .

ns1:influencedByStyle a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingStyle .

ns1:introducedTechnique a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingTechnique .

ns1:knownFor a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:ArtisticWork .

ns1:locatedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Guild ;
    rdfs:range ns1:City .

ns1:memberOf a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Guild .

ns1:nickname a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:residedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:BroadLandscapesTechnique a owl:NamedIndividual,
        ns1:PaintingTechnique ;
    rdfs:label "broad landscapes in the backgrounds"^^xsd:string ;
    ns1:becamePopularIn ns1:SixteenthCenturyNorthernRenaissance .

ns1:CoDeacon a owl:NamedIndividual,
        ns1:GuildRole ;
    rdfs:label "co-deacon"^^xsd:string .

ns1:CornelisVanCleve a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Cornelis van Cleve"^^xsd:string ;
    ns1:becameMentallyIll true ;
    ns1:birthYear 1520 ;
    ns1:deathYear 1567 ;
    ns1:nickname "Sotte Cleef"^^xsd:string ;
    ns1:residedIn ns1:England .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:England a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "England"^^xsd:string .

ns1:GuildOfSaintLukeOfAntwerp a owl:NamedIndividual,
        ns1:Guild ;
    rdfs:label "Guild of Saint Luke of Antwerp"^^xsd:string ;
    ns1:locatedIn ns1:Antwerp .

ns1:NetherlandishPaintingTechnique a owl:NamedIndividual,
        ns1:PaintingTechnique ;
    rdfs:label "traditional Netherlandish painting techniques"^^xsd:string .

ns1:Portrait a owl:Class ;
    rdfs:subClassOf ns1:Painting .

ns1:PortraitsOfRoyalty a owl:NamedIndividual,
        ns1:Portrait ;
    rdfs:label "portraits of royalty"^^xsd:string .

ns1:ReligiousWork a owl:Class ;
    rdfs:subClassOf ns1:Painting .

ns1:ReligiousWorks a owl:NamedIndividual,
        ns1:ReligiousWork ;
    rdfs:label "religious works"^^xsd:string .

ns1:RenaissancePaintingStyle a owl:NamedIndividual,
        ns1:PaintingStyle ;
    rdfs:label "Renaissance painting style"^^xsd:string .

ns1:SixteenthCenturyNorthernRenaissance a owl:NamedIndividual,
        ns1:ArtisticMovement ;
    rdfs:label "sixteenth century northern Renaissance"^^xsd:string .

ns1:Antwerp a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Antwerp"^^xsd:string .

ns1:ArtisticMovement a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ArtisticWork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:GuildRole a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Painting a owl:Class ;
    rdfs:subClassOf ns1:ArtisticWork .

ns1:PaintingStyle a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Guild a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PaintingTechnique a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Painter a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .