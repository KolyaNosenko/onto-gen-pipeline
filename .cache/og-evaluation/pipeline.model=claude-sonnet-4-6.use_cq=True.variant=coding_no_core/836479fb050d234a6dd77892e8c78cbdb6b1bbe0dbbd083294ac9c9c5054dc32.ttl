@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:airedIn a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:Country .

ns1:airedOn a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:TVNetwork .

ns1:coCreatedBy a owl:ObjectProperty ;
    rdfs:domain ns1:TVSeries ;
    rdfs:range ns1:Person .

ns1:directedBy a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:Person .

ns1:explores a owl:DatatypeProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:string .

ns1:features a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:FictionalCharacter .

ns1:firstAiredDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:string .

ns1:hasEpisode a owl:ObjectProperty ;
    rdfs:domain ns1:TVSeason ;
    rdfs:range ns1:TVEpisode .

ns1:hasEpisodeNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:integer .

ns1:hasOverallEpisodeNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:integer .

ns1:hasSeason a owl:ObjectProperty ;
    rdfs:domain ns1:TVSeries ;
    rdfs:range ns1:TVSeason .

ns1:hasSeasonNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TVSeason ;
    rdfs:range xsd:integer .

ns1:hasTitle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:string .

ns1:isAdopted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:FictionalCharacter ;
    rdfs:range xsd:boolean .

ns1:isFired a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:FictionalCharacter ;
    rdfs:range xsd:boolean .

ns1:isYoungerBrotherOf a owl:ObjectProperty ;
    rdfs:domain ns1:FictionalCharacter ;
    rdfs:range ns1:FictionalCharacter .

ns1:originatesFrom a owl:ObjectProperty ;
    rdfs:domain ns1:FictionalCharacter ;
    rdfs:range ns1:Country .

ns1:partOfSeason a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:TVSeason .

ns1:partOfSeries a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:TVSeries .

ns1:receivedCriticalResponse a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:string .

ns1:satirizes a owl:DatatypeProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range xsd:string .

ns1:turnsToDrugs a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:FictionalCharacter ;
    rdfs:range xsd:boolean .

ns1:writtenBy a owl:ObjectProperty ;
    rdfs:domain ns1:TVEpisode ;
    rdfs:range ns1:Person .

ns1:AnimatedTVSeries a owl:Class ;
    rdfs:subClassOf ns1:TVSeries .

ns1:CanadaCountry a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Canada"^^xsd:string .

ns1:ComedyCentralNetwork a owl:NamedIndividual,
        ns1:TVNetwork ;
    rdfs:label "Comedy Central"^^xsd:string .

ns1:IkeCharacter a owl:NamedIndividual,
        ns1:FictionalCharacter ;
    rdfs:label "Ike"^^xsd:string ;
    ns1:isAdopted true ;
    ns1:isYoungerBrotherOf ns1:KyleCharacter ;
    ns1:originatesFrom ns1:CanadaCountry .

ns1:IkesWeeWeeEpisode a owl:NamedIndividual,
        ns1:TVEpisode ;
    rdfs:label "Ike's Wee Wee"^^xsd:string ;
    ns1:airedIn ns1:UnitedStatesCountry ;
    ns1:airedOn ns1:ComedyCentralNetwork ;
    ns1:directedBy ns1:TreyParkerPerson ;
    ns1:explores "whether family can only mean those who are related by blood"^^xsd:string ;
    ns1:features ns1:IkeCharacter,
        ns1:KyleCharacter,
        ns1:MrMackeyCharacter ;
    ns1:firstAiredDate "May 27, 1998"^^xsd:string ;
    ns1:hasEpisodeNumber 4 ;
    ns1:hasOverallEpisodeNumber 18 ;
    ns1:hasTitle "Ike's Wee Wee"^^xsd:string ;
    ns1:partOfSeason ns1:SouthParkSeason2 ;
    ns1:partOfSeries ns1:SouthParkSeries ;
    ns1:receivedCriticalResponse "positive"^^xsd:string ;
    ns1:satirizes "attitudes towards drug users"^^xsd:string ;
    ns1:writtenBy ns1:TreyParkerPerson .

ns1:MrMackeyCharacter a owl:NamedIndividual,
        ns1:SchoolCounselor ;
    rdfs:label "Mr. Mackey"^^xsd:string ;
    ns1:isFired true ;
    ns1:turnsToDrugs true .

ns1:SchoolCounselor a owl:Class ;
    rdfs:subClassOf ns1:FictionalCharacter .

ns1:SouthParkSeries a owl:NamedIndividual,
        ns1:AnimatedTVSeries ;
    rdfs:label "South Park"^^xsd:string ;
    ns1:coCreatedBy ns1:TreyParkerPerson ;
    ns1:hasSeason ns1:SouthParkSeason2 .

ns1:UnitedStatesCountry a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "United States"^^xsd:string .

ns1:KyleCharacter a owl:NamedIndividual,
        ns1:FictionalCharacter ;
    rdfs:label "Kyle"^^xsd:string .

ns1:SouthParkSeason2 a owl:NamedIndividual,
        ns1:TVSeason ;
    rdfs:label "second season"^^xsd:string ;
    ns1:hasEpisode ns1:IkesWeeWeeEpisode ;
    ns1:hasSeasonNumber 2 .

ns1:TVNetwork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TreyParkerPerson a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Trey Parker"^^xsd:string .

ns1:Country a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TVSeries a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TVSeason a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:FictionalCharacter a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TVEpisode a owl:Class ;
    rdfs:subClassOf owl:Thing .