@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:AANR a owl:NamedIndividual,
        ns1:NaturistOrganization ;
    rdfs:label "American Association for Nude Recreation"^^xsd:string ;
    ns1:acronym "AANR"^^xsd:string ;
    ns1:affiliatedFacilityCount 200 ;
    ns1:approvedSettings "sanctioned nude beaches, public lands, homes, private backyards, AANR-affiliated clubs, campgrounds and resorts"^^xsd:string ;
    ns1:basedIn ns1:UnitedStates ;
    ns1:foundedInYear 1931 ;
    ns1:fullName "American Association for Nude Recreation"^^xsd:string ;
    ns1:largestInRegion ns1:NorthAmerica ;
    ns1:lobbiesGovernmentIn ns1:Canada,
        ns1:UnitedStates ;
    ns1:memberCount 30000 ;
    ns1:previousName "American Sunbathing Association"^^xsd:string ;
    ns1:promotes "benefits of wholesome nude family recreation"^^xsd:string ;
    ns1:protectsRights "rights of nudists in appropriate settings"^^xsd:string ;
    ns1:rankAmongKind "largest, longest-established"^^xsd:string ;
    ns1:servesMembers ns1:Canada,
        ns1:FrenchWestIndies,
        ns1:Mexico,
        ns1:StMartin,
        ns1:UnitedStates,
        ns1:VirginIslands ;
    ns1:usesMembershipFeesFor "political activity by campaigning and lobbying governments"^^xsd:string .

ns1:Campground a owl:Class ;
    rdfs:subClassOf ns1:NudistFacility .

ns1:Club a owl:Class ;
    rdfs:subClassOf ns1:NudistFacility .

ns1:NudeBeach a owl:Class ;
    rdfs:subClassOf ns1:NudistSetting .

ns1:NudistBusiness a owl:Class ;
    rdfs:subClassOf ns1:NudistFacility .

ns1:PrivateProperty a owl:Class ;
    rdfs:subClassOf ns1:NudistSetting .

ns1:PublicLand a owl:Class ;
    rdfs:subClassOf ns1:NudistSetting .

ns1:Resort a owl:Class ;
    rdfs:subClassOf ns1:NudistFacility .

ns1:acronym a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:affiliatedFacilityCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:integer .

ns1:affiliatedWith a owl:ObjectProperty ;
    rdfs:domain ns1:NudistFacility ;
    rdfs:range ns1:Organization .

ns1:approvedSettings a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:basedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:Country .

ns1:foundedInYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:integer .

ns1:fullName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:largestInRegion a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:GeographicArea .

ns1:lobbiesGovernmentIn a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:Country .

ns1:memberCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:integer .

ns1:previousName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:promotes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:protectsRights a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:rankAmongKind a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:servesMembers a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:GeographicArea .

ns1:usesMembershipFeesFor a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range xsd:string .

ns1:FrenchWestIndies a owl:NamedIndividual,
        ns1:IslandTerritory ;
    rdfs:label "French West Indies"^^xsd:string .

ns1:GeographicRegion a owl:Class ;
    rdfs:subClassOf ns1:GeographicArea .

ns1:Mexico a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Mexico"^^xsd:string .

ns1:NaturistOrganization a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:NorthAmerica a owl:NamedIndividual,
        ns1:GeographicRegion ;
    rdfs:label "North America"^^xsd:string .

ns1:StMartin a owl:NamedIndividual,
        ns1:IslandTerritory ;
    rdfs:label "St. Martin"^^xsd:string .

ns1:VirginIslands a owl:NamedIndividual,
        ns1:IslandTerritory ;
    rdfs:label "Virgin Islands"^^xsd:string .

ns1:Canada a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Canada"^^xsd:string .

ns1:IslandTerritory a owl:Class ;
    rdfs:subClassOf ns1:GeographicArea .

ns1:NudistSetting a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:UnitedStates a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "United States"^^xsd:string .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:GeographicArea .

ns1:GeographicArea a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:NudistFacility a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .