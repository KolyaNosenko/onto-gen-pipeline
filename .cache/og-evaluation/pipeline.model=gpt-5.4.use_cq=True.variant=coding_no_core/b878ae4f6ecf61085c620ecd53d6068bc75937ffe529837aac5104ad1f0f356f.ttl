@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:BedAndBreakfastBusiness a owl:Class ;
    rdfs:subClassOf ns1:Business .

ns1:BoutiqueStore a owl:Class ;
    rdfs:subClassOf ns1:Business .

ns1:Cafe a owl:Class ;
    rdfs:subClassOf ns1:Business .

ns1:HousingEstate a owl:Class ;
    rdfs:subClassOf ns1:Development .

ns1:MiltonUlladullaDistrict a owl:NamedIndividual,
        ns1:District ;
    rdfs:label "Milton - Ulladulla district"^^xsd:string ;
    ns1:hasMainCommercialCentre ns1:Milton ;
    ns1:mainCommercialCentreCount 2 .

ns1:PropertyAsset a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Resident a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:TourismIndustry a owl:Class ;
    rdfs:subClassOf ns1:Industry .

ns1:Traveller a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:becameImportantRegionalCentreDuring a owl:ObjectProperty ;
    rdfs:domain ns1:RegionalCentre ;
    rdfs:range ns1:Century .

ns1:foundedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range ns1:Year .

ns1:hasBedAndBreakfastBusinesses a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:boolean .

ns1:hasBoutiqueStores a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:boolean .

ns1:hasCafes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:boolean .

ns1:hasHousingEstateDevelopmentOnFringes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:boolean .

ns1:hasMainCommercialCentre a owl:ObjectProperty ;
    rdfs:domain ns1:District ;
    rdfs:range ns1:MainCommercialCentre .

ns1:hasPopulation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range ns1:PopulationQuantity .

ns1:hasRecentResurgence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:boolean .

ns1:isPopularStoppingPlaceForTravellers a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:boolean .

ns1:isPopularStoppingPlaceOn a owl:ObjectProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range ns1:TransportationRoute .

ns1:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:Place .

ns1:mainCommercialCentreCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:District ;
    rdfs:range xsd:integer .

ns1:namedAfterPropertyOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range ns1:Person .

ns1:newBusinessType a owl:DatatypeProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:string .

ns1:newDevelopmentType a owl:DatatypeProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:string .

ns1:numericValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulationQuantity,
        ns1:Year ;
    rdfs:range xsd:integer .

ns1:recentResurgenceDriver a owl:DatatypeProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:string .

ns1:residentInfluxMotivation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:string .

ns1:runsThrough a owl:ObjectProperty ;
    rdfs:domain ns1:TransportationRoute ;
    rdfs:range ns1:PopulatedPlace .

ns1:stoppingPlaceReason a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range xsd:string .

ns1:withinLocalGovernmentArea a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:PopulatedPlace ;
    rdfs:range ns1:LocalGovernmentArea .

ns1:CityOfShoalhaven a owl:NamedIndividual,
        ns1:LocalGovernmentArea ;
    rdfs:label "City of Shoalhaven"^^xsd:string .

ns1:CommercialCentre a owl:Class ;
    rdfs:subClassOf ns1:PopulatedPlace .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Development a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:GeorgeKnight a owl:NamedIndividual,
        ns1:PostMaster ;
    rdfs:label "George Knight"^^xsd:string .

ns1:Highway a owl:Class ;
    rdfs:subClassOf ns1:TransportationRoute .

ns1:ImportantRegionalCentre a owl:Class ;
    rdfs:subClassOf ns1:RegionalCentre .

ns1:Industry a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:NineteenthCentury a owl:NamedIndividual,
        ns1:Century ;
    rdfs:label "19th Century"^^xsd:string .

ns1:Population1663 a owl:NamedIndividual,
        ns1:PopulationQuantity ;
    rdfs:label "1,663"^^xsd:string ;
    ns1:numericValue 1663 .

ns1:PostMaster a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:PrincesHighway a owl:NamedIndividual,
        ns1:Highway ;
    rdfs:label "Princes Highway"^^xsd:string ;
    ns1:runsThrough ns1:Milton .

ns1:Quantity a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Region a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:SouthCoastRegion a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "South Coast region"^^xsd:string ;
    ns1:locatedIn ns1:Australia,
        ns1:NewSouthWales .

ns1:State a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Town a owl:Class ;
    rdfs:subClassOf ns1:PopulatedPlace .

ns1:Village a owl:Class ;
    rdfs:subClassOf ns1:PopulatedPlace .

ns1:Year1860 a owl:NamedIndividual,
        ns1:Year ;
    rdfs:label "1860"^^xsd:string ;
    ns1:numericValue 1860 .

ns1:Century a owl:Class ;
    rdfs:subClassOf ns1:TimeReference .

ns1:LocalGovernmentArea a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:MainCommercialCentre a owl:Class ;
    rdfs:subClassOf ns1:CommercialCentre .

ns1:Milton a owl:NamedIndividual,
        ns1:ImportantRegionalCentre,
        ns1:MainCommercialCentre,
        ns1:Town,
        ns1:Village ;
    rdfs:label "Milton"^^xsd:string ;
    ns1:becameImportantRegionalCentreDuring ns1:NineteenthCentury ;
    ns1:foundedIn ns1:Year1860 ;
    ns1:hasBedAndBreakfastBusinesses true ;
    ns1:hasBoutiqueStores true ;
    ns1:hasCafes true ;
    ns1:hasHousingEstateDevelopmentOnFringes true ;
    ns1:hasPopulation ns1:Population1663 ;
    ns1:hasRecentResurgence true ;
    ns1:isPopularStoppingPlaceForTravellers true ;
    ns1:isPopularStoppingPlaceOn ns1:PrincesHighway ;
    ns1:locatedIn ns1:Australia,
        ns1:NewSouthWales,
        ns1:SouthCoastRegion ;
    ns1:namedAfterPropertyOf ns1:GeorgeKnight ;
    ns1:newBusinessType "bed and breakfast type businesses"^^xsd:string,
        "boutique stores"^^xsd:string,
        "cafes"^^xsd:string ;
    ns1:newDevelopmentType "new housing estates"^^xsd:string ;
    ns1:recentResurgenceDriver "an influx of residents to the district seeking a seachange"^^xsd:string,
        "local tourism industry"^^xsd:string ;
    ns1:residentInfluxMotivation "seeking a seachange"^^xsd:string ;
    ns1:stoppingPlaceReason "the Princes Highway runs through the centre of town"^^xsd:string ;
    ns1:withinLocalGovernmentArea ns1:CityOfShoalhaven .

ns1:NewSouthWales a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "New South Wales"^^xsd:string ;
    ns1:locatedIn ns1:Australia .

ns1:RegionalCentre a owl:Class ;
    rdfs:subClassOf ns1:PopulatedPlace .

ns1:TimeReference a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Australia a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Australia"^^xsd:string .

ns1:Business a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:District a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:PopulationQuantity a owl:Class ;
    rdfs:subClassOf ns1:Quantity .

ns1:TransportationRoute a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Year a owl:Class ;
    rdfs:subClassOf ns1:TimeReference .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PopulatedPlace a owl:Class ;
    rdfs:subClassOf ns1:Place .