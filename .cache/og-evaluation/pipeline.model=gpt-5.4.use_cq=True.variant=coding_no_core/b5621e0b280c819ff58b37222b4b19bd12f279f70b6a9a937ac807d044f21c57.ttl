@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:FilmTitle a owl:Class ;
    rdfs:subClassOf ns1:Film .

ns1:OdeonAcronymEntity a owl:NamedIndividual,
        ns1:OrganizationAlias ;
    rdfs:label "ODEON"^^xsd:string ;
    ns1:aliasFor ns1:OdeonCinemasEntity .

ns1:SkyAcronymEntity a owl:NamedIndividual,
        ns1:OrganizationAlias ;
    rdfs:label "SKY"^^xsd:string ;
    ns1:aliasFor ns1:BritishSkyBroadcastingEntity .

ns1:SkyNameEntity a owl:NamedIndividual,
        ns1:OrganizationAlias ;
    rdfs:label "Sky"^^xsd:string ;
    ns1:aliasFor ns1:BritishSkyBroadcastingEntity .

ns1:SkyViewer a owl:Class ;
    rdfs:subClassOf ns1:HomeAudience .

ns1:aliasFor a owl:ObjectProperty ;
    rdfs:domain ns1:EntityName ;
    rdfs:range owl:Thing .

ns1:jointVenturesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:Organization .

ns1:makesTitlesAvailableThrough a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:HomeViewingService .

ns1:plannedFilmsPerYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range xsd:integer .

ns1:precedesChannel a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:DistributionChannel ;
    rdfs:range ns1:DistributionChannel .

ns1:retainsTvRightsFor a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:BusinessEntity .

ns1:retainsTvRightsInCountry a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:Country .

ns1:BoxOfficeService a owl:Class ;
    rdfs:subClassOf ns1:HomeViewingService .

ns1:CinemaAudience a owl:Class ;
    rdfs:subClassOf ns1:AudienceGroup .

ns1:DownloadService a owl:Class ;
    rdfs:subClassOf ns1:HomeViewingService .

ns1:Film a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:FilmDistributionJointVenture a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasJointVenturePartner ;
            owl:someValuesFrom ns1:Organization ],
        [ a owl:Restriction ;
            owl:onProperty ns1:usesTheatricalReleaseVenue ;
            owl:someValuesFrom ns1:CinemaChain ],
        [ a owl:Restriction ;
            owl:onProperty ns1:usesTheatricalReleaseVenue ;
            owl:someValuesFrom ns1:OtherCinemaChain ],
        [ a owl:Restriction ;
            owl:onProperty ns1:usesDvdRetailChannel ;
            owl:someValuesFrom ns1:RetailChannel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:usesDvdRentalChannel ;
            owl:someValuesFrom ns1:RentalChannel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:usesHomeViewingService ;
            owl:someValuesFrom ns1:HomeViewingService ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTelevisionPremiereOn ;
            owl:someValuesFrom ns1:TelevisionChannel ],
        [ a owl:Restriction ;
            owl:onProperty ns1:operatesUnderName ;
            owl:someValuesFrom ns1:CollaborationName ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasAcronym ;
            owl:someValuesFrom ns1:Acronym ],
        [ a owl:Restriction ;
            owl:onProperty ns1:basedInCountry ;
            owl:someValuesFrom ns1:Country ],
        [ a owl:Restriction ;
            owl:onProperty ns1:acquiresFilmTitlesFrom ;
            owl:someValuesFrom ns1:Filmmaker ],
        [ a owl:Restriction ;
            owl:onProperty ns1:servesAudienceType ;
            owl:someValuesFrom ns1:CinemaAudience ],
        [ a owl:Restriction ;
            owl:onProperty ns1:servesAudienceType ;
            owl:someValuesFrom ns1:HomeAudience ],
        [ a owl:Restriction ;
            owl:onProperty ns1:bringsFilmTitlesToCinemaAudienceIn ;
            owl:someValuesFrom ns1:Country ],
        [ a owl:Restriction ;
            owl:onProperty ns1:bringsFilmTitlesToHomeAudienceIn ;
            owl:someValuesFrom ns1:Country ],
        ns1:FilmDistributor,
        ns1:JointVenture .

ns1:FilmworksAcronymEntity a owl:NamedIndividual,
        ns1:Acronym ;
    rdfs:label "FILMWORKS"^^xsd:string ;
    ns1:aliasFor ns1:OdeonSkyFilmworksEntity .

ns1:OdeonAndSkyFilmworksQuotedName a owl:NamedIndividual,
        ns1:CollaborationName ;
    rdfs:label "‘ Odeon and Sky Filmworks’"^^xsd:string ;
    ns1:aliasFor ns1:OdeonSkyFilmworksEntity .

ns1:OtherCinemaChain a owl:Class ;
    rdfs:subClassOf ns1:CinemaChain .

ns1:acquiresFilmTitlesFrom a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:Filmmaker .

ns1:basedInCountry a owl:ObjectProperty ;
    rdfs:domain ns1:BusinessEntity ;
    rdfs:range ns1:Country .

ns1:bringsFilmTitlesToCinemaAudienceIn a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:Country .

ns1:bringsFilmTitlesToHomeAudienceIn a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:Country .

ns1:hasAcronym a owl:ObjectProperty ;
    rdfs:domain ns1:BusinessEntity ;
    rdfs:range ns1:Acronym .

ns1:hasJointVenturePartner a owl:ObjectProperty ;
    rdfs:domain ns1:JointVenture ;
    rdfs:range ns1:Organization .

ns1:hasTelevisionPremiereOn a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:TelevisionChannel .

ns1:operatesUnderName a owl:ObjectProperty ;
    rdfs:domain ns1:BusinessEntity ;
    rdfs:range ns1:CollaborationName .

ns1:usesDvdRentalChannel a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:RentalChannel .

ns1:usesDvdRetailChannel a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:RetailChannel .

ns1:usesHomeViewingService a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:HomeViewingService .

ns1:Filmmaker a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:HomeAudience a owl:Class ;
    rdfs:subClassOf ns1:AudienceGroup .

ns1:JointVenture a owl:Class ;
    rdfs:subClassOf ns1:BusinessEntity .

ns1:OdeonDirectService a owl:NamedIndividual,
        ns1:RentalChannel ;
    rdfs:label "ODEON Direct"^^xsd:string .

ns1:OdeonFoyerSalesChannel a owl:NamedIndividual,
        ns1:RetailChannel ;
    rdfs:label "ODEON foyer sales"^^xsd:string .

ns1:SkyBoxOfficeService a owl:NamedIndividual,
        ns1:BoxOfficeService ;
    rdfs:label "Sky Box Office"^^xsd:string ;
    ns1:precedesChannel ns1:SkyMoviesChannel .

ns1:SkyMoviesByBroadbandService a owl:NamedIndividual,
        ns1:DownloadService ;
    rdfs:label "Sky Movies By Broadband"^^xsd:string ;
    ns1:precedesChannel ns1:SkyMoviesChannel .

ns1:servesAudienceType a owl:ObjectProperty ;
    rdfs:domain ns1:BusinessEntity ;
    rdfs:range ns1:AudienceGroup .

ns1:usesTheatricalReleaseVenue a owl:ObjectProperty ;
    rdfs:domain ns1:FilmDistributor ;
    rdfs:range ns1:CinemaChain .

ns1:Acronym a owl:Class ;
    rdfs:subClassOf ns1:EntityName .

ns1:AudienceGroup a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:CollaborationName a owl:Class ;
    rdfs:subClassOf ns1:EntityName .

ns1:OdeonSkyFilmworksEntity a owl:NamedIndividual,
        ns1:FilmDistributionJointVenture ;
    rdfs:label "Odeon Sky Filmworks"^^xsd:string ;
    ns1:basedInCountry ns1:UKCountryEntity ;
    ns1:bringsFilmTitlesToCinemaAudienceIn ns1:UKCountryEntity ;
    ns1:bringsFilmTitlesToHomeAudienceIn ns1:UKCountryEntity ;
    ns1:hasAcronym ns1:FilmworksAcronymEntity ;
    ns1:hasJointVenturePartner ns1:BritishSkyBroadcastingEntity,
        ns1:OdeonCinemasEntity ;
    ns1:hasTelevisionPremiereOn ns1:SkyMoviesChannel ;
    ns1:operatesUnderName ns1:OdeonAndSkyFilmworksQuotedName ;
    ns1:plannedFilmsPerYear 6 ;
    ns1:usesDvdRentalChannel ns1:OdeonDirectService ;
    ns1:usesDvdRetailChannel ns1:OdeonFoyerSalesChannel ;
    ns1:usesHomeViewingService ns1:SkyBoxOfficeService,
        ns1:SkyMoviesByBroadbandService ;
    ns1:usesTheatricalReleaseVenue ns1:OdeonCinemasEntity .

ns1:OrganizationAlias a owl:Class ;
    rdfs:subClassOf ns1:EntityName .

ns1:RentalChannel a owl:Class ;
    rdfs:subClassOf ns1:DistributionChannel .

ns1:RetailChannel a owl:Class ;
    rdfs:subClassOf ns1:DistributionChannel .

ns1:SkyMoviesChannel a owl:NamedIndividual,
        ns1:TelevisionChannel ;
    rdfs:label "Sky Movies"^^xsd:string .

ns1:TelevisionChannel a owl:Class ;
    rdfs:subClassOf ns1:HomeViewingService .

ns1:BritishSkyBroadcastingEntity a owl:NamedIndividual,
        ns1:BusinessEntity ;
    rdfs:label "British Sky Broadcasting"^^xsd:string ;
    ns1:jointVenturesWith ns1:OdeonCinemasEntity ;
    ns1:makesTitlesAvailableThrough ns1:SkyBoxOfficeService,
        ns1:SkyMoviesByBroadbandService ;
    ns1:retainsTvRightsFor ns1:OdeonSkyFilmworksEntity ;
    ns1:retainsTvRightsInCountry ns1:UKCountryEntity .

ns1:CinemaChain a owl:Class ;
    rdfs:subClassOf ns1:BusinessEntity,
        ns1:DistributionChannel .

ns1:EntityName a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:OdeonCinemasEntity a owl:NamedIndividual,
        ns1:CinemaChain ;
    rdfs:label "Odeon Cinemas"^^xsd:string ;
    ns1:jointVenturesWith ns1:BritishSkyBroadcastingEntity ;
    ns1:precedesChannel ns1:OdeonDirectService,
        ns1:OdeonFoyerSalesChannel .

ns1:UKCountryEntity a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "UK"^^xsd:string .

ns1:DistributionChannel a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:HomeViewingService a owl:Class ;
    rdfs:subClassOf ns1:DistributionChannel .

ns1:Country a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:BusinessEntity a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:FilmDistributor a owl:Class ;
    rdfs:subClassOf ns1:BusinessEntity .