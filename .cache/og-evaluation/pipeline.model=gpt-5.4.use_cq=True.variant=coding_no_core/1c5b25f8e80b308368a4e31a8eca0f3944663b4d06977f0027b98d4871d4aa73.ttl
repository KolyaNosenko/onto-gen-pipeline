@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Guitarist a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:albumNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:StudioAlbum ;
    rdfs:range xsd:integer .

ns1:containsMusicalElement a owl:DatatypeProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range xsd:string .

ns1:departsStylisticallyFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Album .

ns1:descriptiveQuote a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range xsd:string .

ns1:firstReleaseByBandFeaturing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:Album .

ns1:firstSingle a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Single .

ns1:hasBassist a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Musician .

ns1:hasDrummer a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Musician .

ns1:hasGuitarist a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Musician .

ns1:hasLyricVideo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Song ;
    rdfs:range xsd:boolean .

ns1:hasMember a owl:ObjectProperty ;
    rdfs:domain ns1:Band ;
    rdfs:range ns1:Musician .

ns1:hasOfficialVideo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Song ;
    rdfs:range xsd:boolean .

ns1:hasVocalist a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Musician .

ns1:isOriginalMemberFromDebutAlbum a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range xsd:boolean .

ns1:lacksMusicalElement a owl:DatatypeProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range xsd:string .

ns1:memberOfBand a owl:ObjectProperty ;
    rdfs:domain ns1:Musician ;
    rdfs:range ns1:Band .

ns1:musicalStyleDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range xsd:string .

ns1:onlyOriginalMemberFromDebutAlbum a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Musician .

ns1:previousAlbum a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Album .

ns1:promotesAlbum a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Single ;
    rdfs:range ns1:Album .

ns1:quoteSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Musician .

ns1:recordingEndDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:DatePoint .

ns1:recordingStartDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:DatePoint .

ns1:releasedByBand a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:MusicalWork ;
    rdfs:range ns1:Band .

ns1:releasedOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:MusicalWork ;
    rdfs:range ns1:DatePoint .

ns1:releasedThrough a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:RecordLabel .

ns1:August28_2012 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "August 28 , 2012"^^xsd:string .

ns1:Bassist a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:Drummer a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:GuitaristVocalist a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:June17 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "June 17"^^xsd:string .

ns1:May21 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "May 21"^^xsd:string .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:September18_2012 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "September 18 , 2012"^^xsd:string .

ns1:SolidStateRecords a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Solid State Records"^^xsd:string .

ns1:TheTimeBender a owl:NamedIndividual,
        ns1:Single ;
    rdfs:label "The Time Bender"^^xsd:string ;
    ns1:hasLyricVideo true ;
    ns1:hasOfficialVideo true ;
    ns1:promotesAlbum ns1:IAmAlbum ;
    ns1:releasedByBand ns1:BecomingTheArchetype ;
    ns1:releasedOn ns1:August28_2012 .

ns1:Vocalist a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:CelestialCompletion a owl:NamedIndividual,
        ns1:StudioAlbum ;
    rdfs:label "Celestial Completion"^^xsd:string ;
    ns1:containsMusicalElement "horns"^^xsd:string,
        "sitars"^^xsd:string ;
    ns1:releasedByBand ns1:BecomingTheArchetype .

ns1:ChrisHeaton a owl:NamedIndividual,
        ns1:Drummer ;
    rdfs:label "Chris Heaton"^^xsd:string ;
    ns1:firstReleaseByBandFeaturing ns1:IAmAlbum ;
    ns1:memberOfBand ns1:BecomingTheArchetype .

ns1:ChrisMcCane a owl:NamedIndividual,
        ns1:Vocalist ;
    rdfs:label "Chris McCane"^^xsd:string ;
    ns1:firstReleaseByBandFeaturing ns1:IAmAlbum ;
    ns1:memberOfBand ns1:BecomingTheArchetype .

ns1:CodeyWatkins a owl:NamedIndividual,
        ns1:Bassist ;
    rdfs:label "Codey Watkins"^^xsd:string ;
    ns1:firstReleaseByBandFeaturing ns1:IAmAlbum ;
    ns1:memberOfBand ns1:BecomingTheArchetype .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:RecordLabel a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Single a owl:Class ;
    rdfs:subClassOf ns1:Song .

ns1:Song a owl:Class ;
    rdfs:subClassOf ns1:MusicalWork .

ns1:StudioAlbum a owl:Class ;
    rdfs:subClassOf ns1:Album .

ns1:Band a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:IAmAlbum a owl:NamedIndividual,
        ns1:StudioAlbum ;
    rdfs:label "I Am"^^xsd:string ;
    ns1:albumNumber 5 ;
    ns1:departsStylisticallyFrom ns1:CelestialCompletion ;
    ns1:descriptiveQuote "gone are the sitars and horns of Celestial Completion . Instead , we 've crafted an album full of the heaviest and most technical songs we 've ever written ."^^xsd:string ;
    ns1:firstSingle ns1:TheTimeBender ;
    ns1:hasBassist ns1:CodeyWatkins ;
    ns1:hasDrummer ns1:ChrisHeaton ;
    ns1:hasGuitarist ns1:SethHecox ;
    ns1:hasVocalist ns1:ChrisMcCane,
        ns1:SethHecox ;
    ns1:lacksMusicalElement "horns"^^xsd:string,
        "sitars"^^xsd:string ;
    ns1:musicalStyleDescription "full of the heaviest and most technical songs we've ever written"^^xsd:string ;
    ns1:onlyOriginalMemberFromDebutAlbum ns1:SethHecox ;
    ns1:previousAlbum ns1:CelestialCompletion ;
    ns1:quoteSource ns1:SethHecox ;
    ns1:recordingEndDate ns1:June17 ;
    ns1:recordingStartDate ns1:May21 ;
    ns1:releasedByBand ns1:BecomingTheArchetype ;
    ns1:releasedOn ns1:September18_2012 ;
    ns1:releasedThrough ns1:SolidStateRecords .

ns1:MusicalWork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:SethHecox a owl:NamedIndividual,
        ns1:GuitaristVocalist ;
    rdfs:label "Seth Hecox"^^xsd:string ;
    ns1:isOriginalMemberFromDebutAlbum true ;
    ns1:memberOfBand ns1:BecomingTheArchetype .

ns1:BecomingTheArchetype a owl:NamedIndividual,
        ns1:Band ;
    rdfs:label "Becoming the Archetype"^^xsd:string ;
    ns1:hasMember ns1:ChrisHeaton,
        ns1:ChrisMcCane,
        ns1:CodeyWatkins,
        ns1:SethHecox .

ns1:DatePoint a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Musician a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:Album a owl:Class ;
    rdfs:subClassOf ns1:MusicalWork .