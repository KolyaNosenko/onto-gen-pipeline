@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:PortraitOfRoyalty a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:depicts ;
            owl:someValuesFrom ns1:Royalty ],
        ns1:Portrait .

ns1:ReligiousWork a owl:Class ;
    rdfs:subClassOf ns1:Painting .

ns1:activeFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:TimeReference .

ns1:activeInPlace a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Place .

ns1:activeTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:TimeReference .

ns1:alsoKnownAs a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:AlternativeName .

ns1:becameMentallyIllDuringResidenceIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:bornAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:TimeReference .

ns1:combinesStyle a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingStyle .

ns1:combinesTechnique a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingTechnique .

ns1:diedAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:TimeReference .

ns1:hasArtisticQualityDescription a owl:DatatypeProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:string .

ns1:hasChild a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Person .

ns1:hasFather a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Person .

ns1:introducedBroadLandscapeBackgrounds a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:boolean .

ns1:introducedTechniqueDescription a owl:DatatypeProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:string .

ns1:isApproximate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TimeReference ;
    rdfs:range xsd:boolean .

ns1:knownForArtworkDescription a owl:DatatypeProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:string .

ns1:locatedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:Place .

ns1:mentalStateDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:nicknameMeaning a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Nickname ;
    rdfs:range xsd:string .

ns1:nicknameReasonDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Nickname ;
    rdfs:range xsd:string .

ns1:referredToAs a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Nickname .

ns1:residesIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:techniqueBecamePopularIn a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingTradition .

ns1:Artwork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Circa1485 a owl:NamedIndividual,
        ns1:TimeReference ;
    rdfs:label "c. 1485"^^xsd:string ;
    ns1:isApproximate true .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:CornelisVanClevePerson a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Cornelis van Cleve"^^xsd:string ;
    ns1:becameMentallyIllDuringResidenceIn ns1:EnglandCountry ;
    ns1:bornAt ns1:Year1520 ;
    ns1:diedAt ns1:Year1567 ;
    ns1:hasFather ns1:JoosVanClevePerson ;
    ns1:mentalStateDescription "mentally ill"^^xsd:string ;
    ns1:referredToAs ns1:SotteCleefNickname ;
    ns1:residesIn ns1:EnglandCountry .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:JoosVanClevePerson a owl:NamedIndividual,
        ns1:GuildCoDeacon,
        ns1:Painter ;
    rdfs:label "Joos van Cleve"^^xsd:string ;
    ns1:activeFrom ns1:Year1511 ;
    ns1:activeInPlace ns1:AntwerpCity ;
    ns1:activeTo ns1:Year1540 ;
    ns1:alsoKnownAs ns1:JoosVanDerBekeName ;
    ns1:bornAt ns1:Circa1485 ;
    ns1:coDeaconOf ns1:GuildOfSaintLukeOfAntwerp ;
    ns1:combinesStyle ns1:MoreContemporaryRenaissancePaintingStyles ;
    ns1:combinesTechnique ns1:TraditionalNetherlandishPaintingTechniques ;
    ns1:diedAt ns1:Year1540Or1541 ;
    ns1:hasArtisticQualityDescription "a unique solidarity of figures"^^xsd:string,
        "sensitivity to color"^^xsd:string ;
    ns1:hasChild ns1:CornelisVanClevePerson ;
    ns1:introducedBroadLandscapeBackgrounds true ;
    ns1:introducedTechniqueDescription "broad landscapes in the backgrounds of his paintings"^^xsd:string ;
    ns1:knownForArtworkDescription "portraits of royalty"^^xsd:string,
        "religious works"^^xsd:string ;
    ns1:memberOf ns1:GuildOfSaintLukeOfAntwerp ;
    ns1:techniqueBecamePopularIn ns1:SixteenthCenturyNorthernRenaissancePaintings .

ns1:JoosVanDerBekeName a owl:NamedIndividual,
        ns1:AlternativeName ;
    rdfs:label "Joos van der Beke"^^xsd:string .

ns1:MoreContemporaryRenaissancePaintingStyles a owl:NamedIndividual,
        ns1:PaintingStyle ;
    rdfs:label "more contemporary Renaissance painting styles"^^xsd:string .

ns1:Royalty a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:SixteenthCenturyNorthernRenaissancePaintings a owl:NamedIndividual,
        ns1:PaintingTradition ;
    rdfs:label "sixteenth century northern Renaissance paintings"^^xsd:string .

ns1:SotteCleefNickname a owl:NamedIndividual,
        ns1:Nickname ;
    rdfs:label "' Sotte Cleef '"^^xsd:string ;
    ns1:nicknameMeaning "mad Cleef"^^xsd:string ;
    ns1:nicknameReasonDescription "Cornelis became mentally ill during a residence in England"^^xsd:string .

ns1:TraditionalNetherlandishPaintingTechniques a owl:NamedIndividual,
        ns1:PaintingTechnique ;
    rdfs:label "traditional Netherlandish painting techniques"^^xsd:string .

ns1:Year1511 a owl:NamedIndividual,
        ns1:TimeReference ;
    rdfs:label "1511"^^xsd:string .

ns1:Year1520 a owl:NamedIndividual,
        ns1:TimeReference ;
    rdfs:label "1520"^^xsd:string .

ns1:Year1540 a owl:NamedIndividual,
        ns1:TimeReference ;
    rdfs:label "1540"^^xsd:string .

ns1:Year1540Or1541 a owl:NamedIndividual,
        ns1:TimeReference ;
    rdfs:label "1540/1541"^^xsd:string .

ns1:Year1567 a owl:NamedIndividual,
        ns1:TimeReference ;
    rdfs:label "1567"^^xsd:string .

ns1:coDeaconOf a owl:ObjectProperty ;
    rdfs:domain ns1:GuildCoDeacon ;
    rdfs:range ns1:Guild .

ns1:creates a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Painting .

ns1:depicts a owl:ObjectProperty ;
    rdfs:domain ns1:Portrait ;
    rdfs:range ns1:Person .

ns1:memberOf a owl:ObjectProperty ;
    rdfs:domain ns1:GuildMember ;
    rdfs:range ns1:Guild .

ns1:AlternativeName a owl:Class ;
    rdfs:subClassOf ns1:Name .

ns1:AntwerpCity a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Antwerp"^^xsd:string .

ns1:ArtisticApproach a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:EnglandCountry a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "England"^^xsd:string .

ns1:GuildCoDeacon a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:coDeaconOf ;
            owl:someValuesFrom ns1:Guild ],
        ns1:GuildMember .

ns1:GuildMember a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:memberOf ;
            owl:someValuesFrom ns1:Guild ],
        ns1:Person .

ns1:GuildOfSaintLukeOfAntwerp a owl:NamedIndividual,
        ns1:Guild ;
    rdfs:label "Guild of Saint Luke of Antwerp"^^xsd:string ;
    ns1:locatedIn ns1:AntwerpCity .

ns1:Name a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PaintingStyle a owl:Class ;
    rdfs:subClassOf ns1:ArtisticApproach .

ns1:PaintingTechnique a owl:Class ;
    rdfs:subClassOf ns1:ArtisticApproach .

ns1:PaintingTradition a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Portrait a owl:Class ;
    rdfs:subClassOf ns1:Painting .

ns1:Nickname a owl:Class ;
    rdfs:subClassOf ns1:Name .

ns1:Painting a owl:Class ;
    rdfs:subClassOf ns1:Artwork .

ns1:Guild a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TimeReference a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Painter a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:creates ;
            owl:someValuesFrom ns1:Painting ],
        ns1:Person .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .