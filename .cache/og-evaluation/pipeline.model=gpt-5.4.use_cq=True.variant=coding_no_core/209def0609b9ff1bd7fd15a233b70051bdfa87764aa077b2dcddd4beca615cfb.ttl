@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:colloquialNameReasonDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range xsd:string .

ns1:currentAssociationDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range xsd:string .

ns1:hasSection a owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:StreetSection .

ns1:helpedEstablish a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Settlement .

ns1:inCentreOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:City .

ns1:laidOutInSurvey a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:Survey .

ns1:led a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Group .

ns1:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:Place .

ns1:mostDesiredAddressOf a owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:City .

ns1:mostDesiredAddressTimeDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range xsd:string .

ns1:namedAfter a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:Person .

ns1:surveyOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Survey ;
    rdfs:range ns1:City .

ns1:Bank a owl:Class ;
    rdfs:subClassOf ns1:FinancialInstitution .

ns1:Cafe a owl:Class ;
    rdfs:subClassOf ns1:UrbanFeature .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:DavidCollinsPerson a owl:NamedIndividual,
        ns1:LieutenantGovernor ;
    rdfs:label "David Collins"^^xsd:string,
        "Lieutenant - Governor David Collins"^^xsd:string ;
    ns1:helpedEstablish ns1:SorrentoSettlement ;
    ns1:led ns1:SettlerGroupForSorrento .

ns1:FinancialStreetSection a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:occurredIn ;
            owl:someValuesFrom ns1:Century ],
        [ a owl:Restriction ;
            owl:onProperty ns1:preferredHomeOf ;
            owl:someValuesFrom ns1:Bank ],
        [ a owl:Restriction ;
            owl:onProperty ns1:preferredHomeOf ;
            owl:someValuesFrom ns1:InsuranceCompany ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasStructure ;
            owl:someValuesFrom ns1:OfficeBlock ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasStructure ;
            owl:someValuesFrom ns1:Skyscraper ],
        [ a owl:Restriction ;
            owl:onProperty ns1:partOf ;
            owl:someValuesFrom ns1:Street ],
        [ a owl:Restriction ;
            owl:onProperty ns1:centredAround ;
            owl:someValuesFrom ns1:Street ],
        [ a owl:Restriction ;
            owl:onProperty ns1:financialHeartOf ;
            owl:someValuesFrom ns1:City ],
        ns1:StreetSection .

ns1:GovernmentOfficial a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:HeritageBuilding a owl:Class ;
    rdfs:subClassOf ns1:UrbanFeature .

ns1:InsuranceCompany a owl:Class ;
    rdfs:subClassOf ns1:FinancialInstitution .

ns1:LieutenantGovernor a owl:Class ;
    rdfs:subClassOf ns1:GovernmentOfficial .

ns1:MajorStreet a owl:Class ;
    rdfs:subClassOf ns1:Street .

ns1:NineteenthCentury a owl:NamedIndividual,
        ns1:Century ;
    rdfs:label "19th century"^^xsd:string .

ns1:OfficeBlock a owl:Class ;
    rdfs:subClassOf ns1:Building .

ns1:ParisEndPrecinct a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:partOf ;
            owl:someValuesFrom ns1:Street ],
        [ a owl:Restriction ;
            owl:onProperty ns1:knownSince ;
            owl:someValuesFrom ns1:Decade ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasFeature ;
            owl:someValuesFrom ns1:HeritageBuilding ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasFeature ;
            owl:someValuesFrom ns1:StreetTree ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasFeature ;
            owl:someValuesFrom ns1:ShoppingBoutique ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locationOf ;
            owl:someValuesFrom ns1:SidewalkCafe ],
        ns1:StreetSection .

ns1:ParisEndSection a owl:NamedIndividual,
        ns1:ParisEndPrecinct ;
    rdfs:label "' Paris End '"^^xsd:string,
        "Paris End"^^xsd:string,
        "eastern end of Collins Street"^^xsd:string ;
    ns1:colloquialNameReasonDescription "due to its numerous heritage buildings, old street trees, high - end shopping boutiques, and as the location for the first sidewalk cafes in the city"^^xsd:string ;
    ns1:knownSince ns1:The1950s ;
    ns1:partOf ns1:CollinsStreetIndividual .

ns1:QueenStreetIndividual a owl:NamedIndividual,
        ns1:Street ;
    rdfs:label "Queen Street"^^xsd:string ;
    ns1:locatedIn ns1:AustraliaCountry,
        ns1:MelbourneCity,
        ns1:VictoriaState .

ns1:SettlerGroup a owl:Class ;
    rdfs:subClassOf ns1:Group .

ns1:SettlerGroupForSorrento a owl:NamedIndividual,
        ns1:SettlerGroup ;
    rdfs:label "group of settlers"^^xsd:string .

ns1:ShoppingBoutique a owl:Class ;
    rdfs:subClassOf ns1:UrbanFeature .

ns1:ShortLivedSettlement a owl:Class ;
    rdfs:subClassOf ns1:Settlement .

ns1:SidewalkCafe a owl:Class ;
    rdfs:subClassOf ns1:Cafe .

ns1:Skyscraper a owl:Class ;
    rdfs:subClassOf ns1:Building .

ns1:SorrentoSettlement a owl:NamedIndividual,
        ns1:ShortLivedSettlement ;
    rdfs:label "short - lived settlement at Sorrento"^^xsd:string ;
    ns1:locatedIn ns1:AustraliaCountry,
        ns1:SorrentoTown,
        ns1:VictoriaState ;
    ns1:occurredIn ns1:Year1803 .

ns1:SorrentoTown a owl:NamedIndividual,
        ns1:Town ;
    rdfs:label "Sorrento"^^xsd:string ;
    ns1:locatedIn ns1:AustraliaCountry,
        ns1:VictoriaState .

ns1:State a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:StreetTree a owl:Class ;
    rdfs:subClassOf ns1:UrbanFeature .

ns1:The1950s a owl:NamedIndividual,
        ns1:Decade ;
    rdfs:label "1950s"^^xsd:string .

ns1:Town a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:UrbanGridSurvey a owl:Class ;
    rdfs:subClassOf ns1:Survey .

ns1:WesternBlocksOfCollinsStreet a owl:NamedIndividual,
        ns1:FinancialStreetSection ;
    rdfs:label "Blocks further west centred around Queen Street"^^xsd:string ;
    ns1:centredAround ns1:QueenStreetIndividual ;
    ns1:currentAssociationDescription "the tradition continues today with the most prestigious office blocks and skyscrapers found along its length"^^xsd:string ;
    ns1:financialHeartOf ns1:MelbourneCity ;
    ns1:occurredIn ns1:NineteenthCentury ;
    ns1:partOf ns1:CollinsStreetIndividual .

ns1:Year1803 a owl:NamedIndividual,
        ns1:Year ;
    rdfs:label "1803"^^xsd:string .

ns1:Year1837 a owl:NamedIndividual,
        ns1:Year ;
    rdfs:label "1837"^^xsd:string .

ns1:centredAround a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range ns1:Street .

ns1:financialHeartOf a owl:ObjectProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range ns1:City .

ns1:knownSince a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:TimePeriod .

ns1:locationOf a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:UrbanFeature .

ns1:occurredIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:TimePeriod .

ns1:Century a owl:Class ;
    rdfs:subClassOf ns1:TimePeriod .

ns1:CollinsStreetIndividual a owl:NamedIndividual,
        ns1:MajorStreet ;
    rdfs:label "Collins Street"^^xsd:string ;
    ns1:hasSection ns1:ParisEndSection,
        ns1:WesternBlocksOfCollinsStreet ;
    ns1:inCentreOf ns1:MelbourneCity ;
    ns1:laidOutInSurvey ns1:Original1837HoddleGrid ;
    ns1:locatedIn ns1:AustraliaCountry,
        ns1:MelbourneCity,
        ns1:VictoriaState ;
    ns1:mostDesiredAddressOf ns1:MelbourneCity ;
    ns1:mostDesiredAddressTimeDescription "soon after it was laid out"^^xsd:string ;
    ns1:namedAfter ns1:DavidCollinsPerson ;
    ns1:partOf ns1:Original1837HoddleGrid .

ns1:Decade a owl:Class ;
    rdfs:subClassOf ns1:TimePeriod .

ns1:FinancialInstitution a owl:Class ;
    rdfs:subClassOf ns1:Institution .

ns1:Group a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Institution a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Original1837HoddleGrid a owl:NamedIndividual,
        ns1:UrbanGridSurvey ;
    rdfs:label "Hoddle Grid"^^xsd:string,
        "first survey of Melbourne"^^xsd:string,
        "the original 1837 Hoddle Grid"^^xsd:string ;
    ns1:occurredIn ns1:Year1837 ;
    ns1:surveyOf ns1:MelbourneCity .

ns1:Settlement a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Year a owl:Class ;
    rdfs:subClassOf ns1:TimePeriod .

ns1:hasStructure a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:Building .

ns1:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ns1:preferredHomeOf a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:Institution .

ns1:Building a owl:Class ;
    rdfs:subClassOf ns1:UrbanFeature .

ns1:Survey a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:hasFeature a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:UrbanFeature .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TimePeriod a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VictoriaState a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "Victoria"^^xsd:string ;
    ns1:locatedIn ns1:AustraliaCountry .

ns1:AustraliaCountry a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Australia"^^xsd:string .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:MelbourneCity a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Melbourne"^^xsd:string ;
    ns1:locatedIn ns1:AustraliaCountry,
        ns1:VictoriaState .

ns1:StreetSection a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:UrbanFeature a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Street a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .