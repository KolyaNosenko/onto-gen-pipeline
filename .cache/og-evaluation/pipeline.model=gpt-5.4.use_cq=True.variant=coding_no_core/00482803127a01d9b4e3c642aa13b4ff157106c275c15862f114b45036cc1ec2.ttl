@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Pitchfork a owl:NamedIndividual,
        ns1:Publication ;
    rdfs:label "Pitchfork"^^xsd:string ;
    ns1:describesVoiceOf ns1:MarissaNadler ;
    ns1:referencesPlace ns1:Hades ;
    ns1:voiceCharacterization "textured and angelic , with just a hint of pain captured within her iridescent falsetto"^^xsd:string,
        "you would follow straight into Hades"^^xsd:string .

ns1:TheBostonGlobe a owl:NamedIndividual,
        ns1:Publication ;
    rdfs:label "The Boston Globe"^^xsd:string ;
    ns1:describesVoiceOf ns1:MarissaNadler ;
    ns1:voiceCharacterization "She has a voice that , in mythological times , could have lured men to their deaths at sea , an intoxicating soprano drenched in gauzy reverb that hits bell - clear heights , lingers , and tapers off like rings of smoke"^^xsd:string .

ns1:activeSince a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Year .

ns1:basedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:bornOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:CalendarDate .

ns1:currentlySignedTo a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:RecordLabel .

ns1:describedAsGenre a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Genre .

ns1:describesVoiceOf a owl:ObjectProperty ;
    rdfs:domain ns1:Publication ;
    rdfs:range ns1:Person .

ns1:hasNationality a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Nationality .

ns1:hasOrdinalPosition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:OrdinalPosition .

ns1:hasReceivedAcclaimForVocals a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:boolean .

ns1:locatedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:Place .

ns1:musicClassificationDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:musicIncorporatesElementOfGenre a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Genre .

ns1:musicRootedInGenre a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Genre .

ns1:referencesPlace a owl:ObjectProperty ;
    rdfs:domain ns1:Publication ;
    rdfs:range ns1:Place .

ns1:releasedAlbum a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Album .

ns1:releasedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:TimePoint .

ns1:singsInVoiceType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:VoiceType .

ns1:voiceCharacterization a owl:DatatypeProperty ;
    rdfs:domain ns1:Publication ;
    rdfs:range xsd:string .

ns1:AmericanNationality a owl:NamedIndividual,
        ns1:Nationality ;
    rdfs:label "American"^^xsd:string .

ns1:April51981 a owl:NamedIndividual,
        ns1:CalendarDate ;
    rdfs:label "April 5 , 1981"^^xsd:string .

ns1:BellaUnion a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Bella Union"^^xsd:string .

ns1:BlackMetal a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "black metal"^^xsd:string .

ns1:Boston a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Boston"^^xsd:string ;
    ns1:locatedIn ns1:Massachusetts .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:CreativeWork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:DreamFolk a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "dream folk"^^xsd:string .

ns1:Experimental a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "experimental"^^xsd:string .

ns1:FineArtist a owl:Class ;
    rdfs:subClassOf ns1:Artist .

ns1:Folk a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "folk"^^xsd:string .

ns1:FullLengthStudioAlbum a owl:Class ;
    rdfs:subClassOf ns1:StudioAlbum .

ns1:Hades a owl:NamedIndividual,
        ns1:MythologicalPlace ;
    rdfs:label "Hades"^^xsd:string .

ns1:Massachusetts a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "Massachusetts"^^xsd:string .

ns1:May2016 a owl:NamedIndividual,
        ns1:MonthYear ;
    rdfs:label "May 2016"^^xsd:string .

ns1:MezzoSoprano a owl:NamedIndividual,
        ns1:VoiceType ;
    rdfs:label "mezzo - soprano"^^xsd:string .

ns1:MonthYear a owl:Class ;
    rdfs:subClassOf ns1:TimePoint .

ns1:Musician a owl:Class ;
    rdfs:subClassOf ns1:Artist .

ns1:MythologicalPlace a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:OldSchoolCountry a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "old - school country"^^xsd:string .

ns1:SacredBonesRecords a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Sacred Bones Records"^^xsd:string .

ns1:Seventh a owl:NamedIndividual,
        ns1:OrdinalPosition ;
    rdfs:label "seventh"^^xsd:string .

ns1:SingerSongwriter a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:State a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Strangers a owl:NamedIndividual,
        ns1:FullLengthStudioAlbum ;
    rdfs:label "Strangers"^^xsd:string ;
    ns1:hasOrdinalPosition ns1:Seventh ;
    ns1:releasedIn ns1:May2016 .

ns1:StudioAlbum a owl:Class ;
    rdfs:subClassOf ns1:Album .

ns1:Year2000 a owl:NamedIndividual,
        ns1:Year ;
    rdfs:label "2000"^^xsd:string .

ns1:Artist a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:CalendarDate a owl:Class ;
    rdfs:subClassOf ns1:TimePoint .

ns1:MarissaNadler a owl:NamedIndividual,
        ns1:FineArtist,
        ns1:SingerSongwriter ;
    rdfs:label "Marissa Nadler"^^xsd:string ;
    ns1:activeSince ns1:Year2000 ;
    ns1:basedIn ns1:Boston ;
    ns1:bornOn ns1:April51981 ;
    ns1:currentlySignedTo ns1:BellaUnion,
        ns1:SacredBonesRecords ;
    ns1:describedAsGenre ns1:DreamFolk ;
    ns1:hasNationality ns1:AmericanNationality ;
    ns1:hasReceivedAcclaimForVocals true ;
    ns1:musicClassificationDescription "defies simple classification"^^xsd:string ;
    ns1:musicIncorporatesElementOfGenre ns1:BlackMetal,
        ns1:Experimental ;
    ns1:musicRootedInGenre ns1:Folk,
        ns1:OldSchoolCountry ;
    ns1:releasedAlbum ns1:Strangers ;
    ns1:singsInVoiceType ns1:MezzoSoprano .

ns1:Nationality a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:OrdinalPosition a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VoiceType a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Year a owl:Class ;
    rdfs:subClassOf ns1:TimePoint .

ns1:RecordLabel a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Album a owl:Class ;
    rdfs:subClassOf ns1:CreativeWork .

ns1:TimePoint a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Publication a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Genre a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .