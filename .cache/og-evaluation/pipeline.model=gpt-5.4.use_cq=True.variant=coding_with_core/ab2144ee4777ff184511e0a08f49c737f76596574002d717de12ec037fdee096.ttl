@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Accomplishment a owl:Class ;
    rdfs:label "Accomplishment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:temporallyLocatedAt ;
                    owl:someValuesFrom ns1:Atom ] ],
        ns1:Event ;
    owl:disjointWith ns1:Achievement .

ns1:AmountOfMatter a owl:Class ;
    rdfs:label "Amount of Matter"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointWith ns1:Feature,
        ns1:PhysicalObject .

ns1:Dialogue a owl:NamedIndividual,
        ns1:DialogueConcept ;
    rdfs:label "dialogue"^^xsd:string ;
    ns1:baseOf ns1:MultipleParadigmSociology ;
    ns1:horizonOf ns1:MultipleParadigmSociology .

ns1:GeorgyFotev a owl:NamedIndividual,
        ns1:Sociologist ;
    rdfs:label "G.Fotev"^^xsd:string,
        "Georgy Fotev"^^xsd:string ;
    ns1:authorOf ns1:BulgarianMelancholy,
        ns1:TheLongNightOfCommunismInBulgaria ;
    ns1:characterizesSociologyAs ns1:MultipleParadigmScience ;
    ns1:hasDateOfBirth ns1:August24_1941 ;
    ns1:hasNationality ns1:Bulgaria ;
    ns1:hasPublicationInField ns1:CrisisOfLegitimacy,
        ns1:Ethnosociology,
        ns1:HistoricalSociology,
        ns1:SociologyOfPolitics,
        ns1:SociologyOfValues ;
    ns1:hasResearchInterest ns1:DialogueAsABaseAndHorizonOfMultipleParadigmSociology,
        ns1:NatureOfSociologyAsAMultipleParadigmScience ;
    ns1:hasScientificWorkInArea ns1:HistoryOfSociology,
        ns1:ModernSociology,
        ns1:TheoryOfSociology ;
    ns1:heldGovernmentOffice ns1:MinisterOfEducationAndScience ;
    ns1:professorEmeritusAt ns1:NewBulgarianUniversity ;
    ns1:receivedAward ns1:DistinguishedServiceAward .

ns1:MentalObject a owl:Class ;
    rdfs:label "Mental Object"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:specificallyDependsOn ;
            owl:someValuesFrom ns1:AgentivePhysicalObject ],
        ns1:NonPhysicalObject ;
    owl:disjointWith ns1:SocialObject .

ns1:Process a owl:Class ;
    rdfs:label "Process"^^xsd:string ;
    rdfs:subClassOf ns1:Stative ;
    owl:disjointWith ns1:State .

ns1:SocialAgent a owl:Class ;
    rdfs:label "Social Agent"^^xsd:string ;
    rdfs:subClassOf ns1:AgentiveSocialObject ;
    owl:disjointWith ns1:Society .

ns1:atomicPartOf a owl:ObjectProperty ;
    rdfs:label "atomic part of"^^xsd:string ;
    rdfs:domain ns1:Atom ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:partOf .

ns1:authorOf a owl:ObjectProperty ;
    rdfs:label "author of"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ScientificWork .

ns1:awardedIn a owl:ObjectProperty ;
    rdfs:label "awarded in"^^xsd:string ;
    rdfs:domain ns1:Award ;
    rdfs:range ns1:CalendarYear ;
    rdfs:subPropertyOf ns1:temporallyLocatedAt .

ns1:baseOf a owl:ObjectProperty ;
    rdfs:label "base of"^^xsd:string ;
    rdfs:domain ns1:DialogueConcept ;
    rdfs:range ns1:ScientificArea .

ns1:characterizesSociologyAs a owl:ObjectProperty ;
    rdfs:label "characterizes sociology as"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ScientificCharacterization .

ns1:concernsSociety a owl:ObjectProperty ;
    rdfs:label "concerns society"^^xsd:string ;
    rdfs:domain ns1:BookTheme ;
    rdfs:range ns1:NationalSociety .

ns1:dateValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "date value"^^xsd:string ;
    rdfs:domain ns1:CalendarDate ;
    rdfs:range xsd:string .

ns1:disciplinaryFieldOf a owl:ObjectProperty ;
    rdfs:label "disciplinary field of"^^xsd:string ;
    rdfs:domain ns1:DisciplinaryField ;
    rdfs:range ns1:ScientificArea ;
    rdfs:subPropertyOf ns1:partOf .

ns1:endYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "end year"^^xsd:string ;
    rdfs:domain ns1:YearRange ;
    rdfs:range xsd:integer .

ns1:hasDateOfBirth a owl:ObjectProperty ;
    rdfs:label "has date of birth"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:CalendarDate ;
    rdfs:subPropertyOf ns1:temporallyLocatedAt .

ns1:hasNationality a owl:ObjectProperty ;
    rdfs:label "has nationality"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Country .

ns1:hasPublicationInField a owl:ObjectProperty ;
    rdfs:label "has publication in field"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:DisciplinaryField .

ns1:hasResearchInterest a owl:ObjectProperty ;
    rdfs:label "has research interest"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ResearchInterest .

ns1:heldGovernmentOffice a owl:ObjectProperty ;
    rdfs:label "held government office"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:GovernmentOffice .

ns1:heldOfficeDuring a owl:ObjectProperty ;
    rdfs:label "held office during"^^xsd:string ;
    rdfs:domain ns1:GovernmentOffice ;
    rdfs:range ns1:YearRange ;
    rdfs:subPropertyOf ns1:temporallyLocatedAt .

ns1:horizonOf a owl:ObjectProperty ;
    rdfs:label "horizon of"^^xsd:string ;
    rdfs:domain ns1:DialogueConcept ;
    rdfs:range ns1:ScientificArea .

ns1:professorEmeritusAt a owl:ObjectProperty ;
    rdfs:label "professor emeritus at"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:University .

ns1:receivedAward a owl:ObjectProperty ;
    rdfs:label "received award"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Award .

ns1:startYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "start year"^^xsd:string ;
    rdfs:domain ns1:YearRange ;
    rdfs:range xsd:integer .

ns1:temporalPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "temporal part of"^^xsd:string ;
    rdfs:domain ns1:Perdurant ;
    rdfs:range ns1:Perdurant ;
    rdfs:subPropertyOf ns1:partOf .

ns1:yearNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "year number"^^xsd:string ;
    rdfs:domain ns1:CalendarYear ;
    rdfs:range xsd:integer .

ns1:Achievement a owl:Class ;
    rdfs:label "Achievement"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:Atom ],
        ns1:Event .

ns1:AmericanUniversityInBulgaria a owl:NamedIndividual,
        ns1:University ;
    rdfs:label "American University in Bulgaria"^^xsd:string .

ns1:ArbitrarySum a owl:Class ;
    rdfs:label "Arbitrary Sum"^^xsd:string ;
    rdfs:subClassOf ns1:Endurant .

ns1:August24_1941 a owl:NamedIndividual,
        ns1:CalendarDate ;
    rdfs:label "August 24 , 1941"^^xsd:string ;
    ns1:dateValue "1941-08-24"^^xsd:string .

ns1:Bulgaria a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Bulgaria"^^xsd:string .

ns1:BulgarianMelancholy a owl:NamedIndividual,
        ns1:Book ;
    rdfs:label "Bulgarian melancholy"^^xsd:string ;
    ns1:illuminatesTheme ns1:TheDramaticFateOfTheBulgarianNationalSociety .

ns1:BulgarianNationalSociety a owl:NamedIndividual,
        ns1:NationalSociety ;
    rdfs:label "the Bulgarian national society"^^xsd:string .

ns1:ConstantAtom a owl:Class ;
    rdfs:label "Constant Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf ns1:constantProperPartOf ] ;
                    owl:someValuesFrom ns1:Particular ] ],
        ns1:Endurant .

ns1:CrisisOfLegitimacy a owl:NamedIndividual,
        ns1:DisciplinaryField ;
    rdfs:label "the crisis of legitimacy"^^xsd:string ;
    ns1:disciplinaryFieldOf ns1:ModernSociology .

ns1:DialogueAsABaseAndHorizonOfMultipleParadigmSociology a owl:NamedIndividual,
        ns1:ResearchInterest ;
    rdfs:label "the dialogue as a base and horizon of multiple paradigm sociology"^^xsd:string .

ns1:DistinguishedServiceAward a owl:NamedIndividual,
        ns1:Award ;
    rdfs:label "Distinguished Service Award"^^xsd:string ;
    ns1:awardedIn ns1:Year2003 ;
    ns1:grantedBy ns1:AmericanUniversityInBulgaria .

ns1:Ethnosociology a owl:NamedIndividual,
        ns1:DisciplinaryField ;
    rdfs:label "ethnosociology"^^xsd:string ;
    ns1:disciplinaryFieldOf ns1:ModernSociology .

ns1:Feature a owl:Class ;
    rdfs:label "Feature"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointWith ns1:PhysicalObject .

ns1:HistoricalSociology a owl:NamedIndividual,
        ns1:DisciplinaryField ;
    rdfs:label "historical sociology"^^xsd:string ;
    ns1:disciplinaryFieldOf ns1:ModernSociology .

ns1:HistoryOfSociology a owl:NamedIndividual,
        ns1:ScientificArea ;
    rdfs:label "history of sociology"^^xsd:string .

ns1:MinisterOfEducationAndScience a owl:NamedIndividual,
        ns1:GovernmentOffice ;
    rdfs:label "Minister of Education and Science"^^xsd:string ;
    ns1:heldOfficeDuring ns1:Years1991_1992 .

ns1:MultipleParadigmScience a owl:NamedIndividual,
        ns1:ScientificCharacterization ;
    rdfs:label "multiple paradigm science"^^xsd:string .

ns1:NatureOfSociologyAsAMultipleParadigmScience a owl:NamedIndividual,
        ns1:ResearchInterest ;
    rdfs:label "the nature of sociology as a multiple paradigm science"^^xsd:string .

ns1:NewBulgarianUniversity a owl:NamedIndividual,
        ns1:University ;
    rdfs:label "New Bulgarian University"^^xsd:string .

ns1:NonAgentivePhysicalObject a owl:Class ;
    rdfs:label "Non-Agentive Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalObject .

ns1:Sociologist a owl:Class ;
    rdfs:label "Sociologist"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasScientificWorkInArea ;
            owl:someValuesFrom ns1:ScientificArea ],
        ns1:Person .

ns1:SociologyOfPolitics a owl:NamedIndividual,
        ns1:DisciplinaryField ;
    rdfs:label "sociology of politics"^^xsd:string ;
    ns1:disciplinaryFieldOf ns1:ModernSociology .

ns1:SociologyOfValues a owl:NamedIndividual,
        ns1:DisciplinaryField ;
    rdfs:label "sociology of values"^^xsd:string ;
    ns1:disciplinaryFieldOf ns1:ModernSociology .

ns1:TemporalLocation a owl:Class ;
    rdfs:label "Temporal Location"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:qualeOf ] ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:TemporalQuality .

ns1:TheLongNightOfCommunismInBulgaria a owl:NamedIndividual,
        ns1:Book ;
    rdfs:label "The long night of communism in Bulgaria"^^xsd:string ;
    ns1:illuminatesTheme ns1:TheDramaticFateOfTheBulgarianNationalSociety .

ns1:TheoryOfSociology a owl:NamedIndividual,
        ns1:ScientificArea ;
    rdfs:label "theory of sociology"^^xsd:string .

ns1:Year2003 a owl:NamedIndividual,
        ns1:CalendarYear ;
    rdfs:label "2003"^^xsd:string ;
    ns1:yearNumber 2003 .

ns1:Years1991_1992 a owl:NamedIndividual,
        ns1:YearRange ;
    rdfs:label "1991 - 1992"^^xsd:string ;
    ns1:endYear 1992 ;
    ns1:startYear 1991 .

ns1:constantAtomicPartOf a owl:ObjectProperty ;
    rdfs:label "constant atomic part of"^^xsd:string ;
    rdfs:domain ns1:ConstantAtom ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantPartOf .

ns1:constantParticipantOf a owl:ObjectProperty ;
    rdfs:label "constant participation of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Perdurant ;
    rdfs:subPropertyOf [ owl:inverseOf ns1:specificallyDependsOn ] .

ns1:grantedBy a owl:ObjectProperty ;
    rdfs:label "granted by"^^xsd:string ;
    rdfs:domain ns1:Award ;
    rdfs:range ns1:University .

ns1:hasScientificWorkInArea a owl:ObjectProperty ;
    rdfs:label "has scientific work in area"^^xsd:string ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ScientificArea .

ns1:illuminatesTheme a owl:ObjectProperty ;
    rdfs:label "illuminates theme"^^xsd:string ;
    rdfs:domain ns1:ScientificWork ;
    rdfs:range ns1:BookTheme .

ns1:properPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "proper part of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:partOf .

ns1:Book a owl:Class ;
    rdfs:label "Book"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:illuminatesTheme ;
            owl:someValuesFrom ns1:BookTheme ],
        ns1:ScientificWork .

ns1:Country a owl:Class ;
    rdfs:label "Country"^^xsd:string ;
    rdfs:subClassOf ns1:Society .

ns1:Event a owl:Class ;
    rdfs:label "Event"^^xsd:string ;
    rdfs:subClassOf ns1:Perdurant ;
    owl:disjointWith ns1:Stative .

ns1:MultipleParadigmSociology a owl:NamedIndividual,
        ns1:ScientificArea ;
    rdfs:label "multiple paradigm sociology"^^xsd:string .

ns1:NationalSociety a owl:Class ;
    rdfs:label "National Society"^^xsd:string ;
    rdfs:subClassOf ns1:Society .

ns1:NonPhysicalObject a owl:Class ;
    rdfs:label "Non-Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:NonPhysicalEndurant .

ns1:ScientificCharacterization a owl:Class ;
    rdfs:label "Scientific Characterization"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:SpaceRegion a owl:Class ;
    rdfs:label "Space Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpatialLocation ;
            owl:onProperty ns1:constantQualeOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpaceRegion ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpaceRegion ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:PhysicalRegion .

ns1:SpatialLocation a owl:Class ;
    rdfs:label "Spatial Location"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalQuality .

ns1:State a owl:Class ;
    rdfs:label "State"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:State ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Stative .

ns1:TheDramaticFateOfTheBulgarianNationalSociety a owl:NamedIndividual,
        ns1:BookTheme ;
    rdfs:label "the dramatic fate of the Bulgarian national society"^^xsd:string ;
    ns1:concernsSociety ns1:BulgarianNationalSociety .

ns1:constantProperPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant proper part of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantPartOf .

ns1:constantlyOverlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "constantly overlaps"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns1:constantPartOf ] ns1:constantPartOf ) .

ns1:qualeOf a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "quale of"^^xsd:string ;
    rdfs:domain ns1:TemporalRegion ;
    rdfs:range ns1:TemporalQuality .

ns1:AgentivePhysicalObject a owl:Class ;
    rdfs:label "Agentive Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalObject .

ns1:AgentiveSocialObject a owl:Class ;
    rdfs:label "Agentive Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:Atom a owl:Class ;
    rdfs:label "Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf ns1:properPartOf ] ;
                    owl:someValuesFrom ns1:Particular ] ],
        ns1:Particular .

ns1:CalendarDate a owl:Class ;
    rdfs:label "Calendar Date"^^xsd:string ;
    rdfs:subClassOf ns1:TimeInterval .

ns1:CalendarYear a owl:Class ;
    rdfs:label "Calendar Year"^^xsd:string ;
    rdfs:subClassOf ns1:TimeInterval .

ns1:DialogueConcept a owl:Class ;
    rdfs:label "Dialogue Concept"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:GovernmentOffice a owl:Class ;
    rdfs:label "Government Office"^^xsd:string ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:Region a owl:Class ;
    rdfs:label "Region"^^xsd:string ;
    rdfs:subClassOf ns1:Abstract ;
    owl:disjointUnionOf ( ns1:AbstractRegion ns1:PhysicalRegion ns1:TemporalRegion ) .

ns1:ResearchInterest a owl:Class ;
    rdfs:label "Research Interest"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:ScientificWork a owl:Class ;
    rdfs:label "Scientific Work"^^xsd:string ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:Stative a owl:Class ;
    rdfs:label "Stative"^^xsd:string ;
    rdfs:subClassOf ns1:Perdurant .

ns1:TemporalRegion a owl:Class ;
    rdfs:label "Temporal Region"^^xsd:string ;
    rdfs:subClassOf ns1:Region .

ns1:overlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "overlaps"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns1:partOf ] ns1:partOf ),
        ( [ owl:inverseOf ns1:presentAt ] ns1:temporallyLocatedAt ) .

ns1:AbstractQuality a owl:Class ;
    rdfs:label "Abstract Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty [ owl:inverseOf ns1:constantQualeOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:Award a owl:Class ;
    rdfs:label "Award"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:grantedBy ;
            owl:someValuesFrom ns1:University ],
        ns1:NonAgentiveSocialObject .

ns1:BookTheme a owl:Class ;
    rdfs:label "Book Theme"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:NonAgentiveSocialObject a owl:Class ;
    rdfs:label "Non-Agentive Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:PhysicalObject a owl:Class ;
    rdfs:label "Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointUnionOf ( ns1:AgentivePhysicalObject ns1:NonAgentivePhysicalObject ) .

ns1:PhysicalRegion a owl:Class ;
    rdfs:label "Physical Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalQuality ;
            owl:onProperty ns1:constantQualeOf ],
        ns1:Region .

ns1:Society a owl:Class ;
    rdfs:label "Society"^^xsd:string ;
    rdfs:subClassOf ns1:AgentiveSocialObject .

ns1:TemporalQuality a owl:Class ;
    rdfs:label "Temporal Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:qualeOf ] ;
            owl:someValuesFrom ns1:Particular ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:YearRange a owl:Class ;
    rdfs:label "Year Range"^^xsd:string ;
    rdfs:subClassOf ns1:TimeInterval .

ns1:AbstractRegion a owl:Class ;
    rdfs:label "Abstract Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractQuality ;
            owl:onProperty ns1:constantQualeOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Region .

ns1:PhysicalQuality a owl:Class ;
    rdfs:label "Physical Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalRegion ;
            owl:onProperty [ owl:inverseOf ns1:constantQualeOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:University a owl:Class ;
    rdfs:label "University"^^xsd:string ;
    rdfs:subClassOf ns1:Society .

ns1:constantQualeOf a owl:ObjectProperty ;
    rdfs:label "constant quale of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:AbstractRegion ns1:PhysicalRegion ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:AbstractQuality ns1:PhysicalQuality ) ] .

ns1:specificallyDependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "specifically depends on"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] .

ns1:ModernSociology a owl:NamedIndividual,
        ns1:ScientificArea ;
    rdfs:label "modern sociology"^^xsd:string .

ns1:DisciplinaryField a owl:Class ;
    rdfs:label "Disciplinary Field"^^xsd:string ;
    rdfs:subClassOf ns1:ScientificArea .

ns1:constantConstituentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant constituent of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:NonPhysicalEndurant ns1:Perdurant ns1:PhysicalEndurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:NonPhysicalEndurant ns1:Perdurant ns1:PhysicalEndurant ) ] ;
    rdfs:subPropertyOf [ owl:inverseOf ns1:specificallyDependsOn ] .

ns1:constantPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant part of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantlyOverlaps .

ns1:NonPhysicalEndurant a owl:Class ;
    rdfs:label "Non-Physical Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:constantlyOverlaps ;
                    owl:someValuesFrom ns1:PhysicalEndurant ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantPartOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty ns1:constantConstituentOf ],
        ns1:Endurant .

ns1:SocialObject a owl:Class ;
    rdfs:label "Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:NonPhysicalObject ;
    owl:disjointUnionOf ( ns1:AgentiveSocialObject ns1:NonAgentiveSocialObject ) .

ns1:Particular a owl:Class ;
    rdfs:label "Particular"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ns1:Abstract ns1:Endurant ns1:Perdurant ns1:Quality ) .

ns1:Quality a owl:Class ;
    rdfs:label "Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns1:directQualityOf ;
            owl:someValuesFrom ns1:Particular ],
        ns1:Particular ;
    owl:disjointUnionOf ( ns1:AbstractQuality ns1:PhysicalQuality ns1:TemporalQuality ) .

ns1:temporallyLocatedAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temporally located at"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range ns1:TimeInterval ;
    rdfs:subPropertyOf ns1:presentAt .

ns1:ScientificArea a owl:Class ;
    rdfs:label "Scientific Area"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:TimeInterval a owl:Class ;
    rdfs:label "Time Interval"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:TimeInterval ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:TemporalRegion .

ns1:Person a owl:Class ;
    rdfs:label "Person"^^xsd:string ;
    rdfs:subClassOf ns1:AgentivePhysicalObject .

ns1:PhysicalEndurant a owl:Class ;
    rdfs:label "Physical Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty ns1:constantConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ;
            owl:someValuesFrom ns1:SpatialLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantPartOf ] ],
        ns1:Endurant .

ns1:directQualityOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "direct quality of"^^xsd:string ;
    rdfs:domain ns1:Quality ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:specificallyDependsOn .

ns1:presentAt a owl:ObjectProperty ;
    rdfs:label "present at"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range ns1:TimeInterval ;
    owl:propertyChainAxiom ( ns1:constantAtomicPartOf ns1:presentAt ),
        ( ns1:constantConstituentOf ns1:presentAt ),
        ( ns1:constantPartOf ns1:presentAt ),
        ( ns1:constantParticipantOf ns1:presentAt ),
        ( ns1:constantProperPartOf ns1:presentAt ),
        ( ns1:directQualityOf ns1:presentAt ),
        ( ns1:presentAt [ owl:inverseOf ns1:partOf ] ),
        ( [ owl:inverseOf ns1:directQualityOf ] ns1:presentAt ),
        ( [ owl:inverseOf ns1:partOf ] ns1:presentAt ),
        ( [ owl:inverseOf ns1:specificallyDependsOn ] ns1:presentAt ) .

ns1:Abstract a owl:Class ;
    rdfs:label "Abstract"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty ns1:overlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Particular .

ns1:Endurant a owl:Class ;
    rdfs:label "Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:Particular ;
    owl:disjointUnionOf ( ns1:ArbitrarySum ns1:NonPhysicalEndurant ns1:PhysicalEndurant ) .

ns1:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:overlaps .

ns1:Perdurant a owl:Class ;
    rdfs:label "Perdurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:overlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:constantConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:TemporalQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ;
            owl:someValuesFrom ns1:TemporalLocation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:Particular .