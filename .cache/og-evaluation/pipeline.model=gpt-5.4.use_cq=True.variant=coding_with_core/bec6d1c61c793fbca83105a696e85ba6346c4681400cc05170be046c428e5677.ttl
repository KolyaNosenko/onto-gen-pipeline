@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Accomplishment a owl:Class ;
    rdfs:label "Accomplishment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:temporallyLocatedAt ;
                    owl:someValuesFrom ns1:Atom ] ],
        ns1:Event ;
    owl:disjointWith ns1:Achievement .

ns1:AmountOfMatter a owl:Class ;
    rdfs:label "Amount of Matter"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointWith ns1:Feature,
        ns1:PhysicalObject .

ns1:CommonLaw a owl:NamedIndividual,
        ns1:CommonLawDoctrine ;
    rdfs:label "common law"^^xsd:string ;
    ns1:citesDecision ns1:BowsherVSynar ;
    ns1:supportsRemovalPowerDescription "the President has the power to remove an official engaged in purely executive functions or an official whose duties immediately affect the President's ability to fulfill his constitutional responsibilities"^^xsd:string .

ns1:MentalObject a owl:Class ;
    rdfs:label "Mental Object"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:specificallyDependsOn ;
            owl:someValuesFrom ns1:AgentivePhysicalObject ],
        ns1:NonPhysicalObject ;
    owl:disjointWith ns1:SocialObject .

ns1:Process a owl:Class ;
    rdfs:label "Process"^^xsd:string ;
    rdfs:subClassOf ns1:Stative ;
    owl:disjointWith ns1:State .

ns1:RemovableExecutiveOfficial a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:removalPowerSupportedBy ;
            owl:someValuesFrom ns1:CommonLawDoctrine ],
        [ a owl:Restriction ;
            owl:onProperty ns1:mayBeRemovedBy ;
            owl:someValuesFrom ns1:PresidentOffice ],
        ns1:ExecutiveBranchOfficial ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns1:OfficialEngagedInPurelyExecutiveFunctions ns1:OfficialWhoseDutiesAffectPresidentialResponsibilities ) ] .

ns1:UnitedStates a owl:NamedIndividual,
        ns1:NationState ;
    rdfs:label "United States"^^xsd:string .

ns1:UnitedStatesAttorneyGeneral a owl:NamedIndividual,
        ns1:AttorneyGeneral ;
    rdfs:label "A.G."^^xsd:string,
        "Attorney General"^^xsd:string,
        "United States Attorney General"^^xsd:string,
        "United States Attorney General ( A.G. )"^^xsd:string ;
    ns1:appointedBy ns1:PresidentOfficeInstance ;
    ns1:appointedUnderClause ns1:AppointmentsClause ;
    ns1:appointedWithAdviceAndConsentOf ns1:SenateBody ;
    ns1:chiefLawyerOf ns1:UnitedStatesGovernment ;
    ns1:concernScopeDescription "all legal affairs"^^xsd:string ;
    ns1:hasPowerToSeekPenalty ns1:FederalDeathPenaltyInstance ;
    ns1:headsOrganization ns1:UnitedStatesDepartmentOfJustice ;
    ns1:impeachableFor ns1:BriberyGround,
        ns1:HighCrimesAndMisdemeanorsGround,
        ns1:TreasonGround ;
    ns1:mayBeImpeachedBy ns1:CongressBody ;
    ns1:mayBeRemovedBy ns1:PresidentOfficeInstance ;
    ns1:nominatedBy ns1:PresidentOfficeInstance ;
    ns1:removalAuthorityEstablishedBy ns1:MyersVUnitedStates ;
    ns1:removalDoesNotRequireConsentOf ns1:SenateBody .

ns1:atomicPartOf a owl:ObjectProperty ;
    rdfs:label "atomic part of"^^xsd:string ;
    rdfs:domain ns1:Atom ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:partOf .

ns1:citesDecision a owl:ObjectProperty ;
    rdfs:domain ns1:LegalDoctrine ;
    rdfs:range ns1:JudicialDecision .

ns1:concernScopeDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:AttorneyGeneral ;
    rdfs:range xsd:string .

ns1:decidedAt a owl:ObjectProperty ;
    rdfs:domain ns1:JudicialDecision ;
    rdfs:range ns1:TimeInterval ;
    rdfs:subPropertyOf ns1:temporallyLocatedAt .

ns1:establishesRuleDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:JudicialDecision ;
    rdfs:range xsd:string .

ns1:removalAuthorityEstablishedBy a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:JudicialDecision .

ns1:supportsRemovalPowerDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:LegalDoctrine ;
    rdfs:range xsd:string .

ns1:temporalPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "temporal part of"^^xsd:string ;
    rdfs:domain ns1:Perdurant ;
    rdfs:range ns1:Perdurant ;
    rdfs:subPropertyOf ns1:partOf .

ns1:Achievement a owl:Class ;
    rdfs:label "Achievement"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:Atom ],
        ns1:Event .

ns1:AppointmentsClause a owl:NamedIndividual,
        ns1:AppointmentsClauseClass ;
    rdfs:label "Appointments Clause"^^xsd:string ;
    ns1:partOfLegalSource ns1:ConstitutionDocumentInstance .

ns1:ArbitrarySum a owl:Class ;
    rdfs:label "Arbitrary Sum"^^xsd:string ;
    rdfs:subClassOf ns1:Endurant .

ns1:BowsherVSynar a owl:NamedIndividual,
        ns1:SupremeCourtDecision ;
    rdfs:label "Bowsher v. Synar"^^xsd:string ;
    ns1:decidedAt ns1:Year1986 ;
    ns1:issuedByCourt ns1:SupremeCourt .

ns1:BriberyGround a owl:NamedIndividual,
        ns1:ImpeachmentGround ;
    rdfs:label "bribery"^^xsd:string .

ns1:CongressBody a owl:NamedIndividual,
        ns1:LegislativeBody ;
    rdfs:label "Congress"^^xsd:string .

ns1:ConstantAtom a owl:Class ;
    rdfs:label "Constant Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf ns1:constantProperPartOf ] ;
                    owl:someValuesFrom ns1:Particular ] ],
        ns1:Endurant .

ns1:ConstitutionDocumentInstance a owl:NamedIndividual,
        ns1:ConstitutionDocument ;
    rdfs:label "Constitution"^^xsd:string .

ns1:DeathPenalty a owl:Class ;
    rdfs:subClassOf ns1:LegalPenalty .

ns1:DutyAffectingPresidentialResponsibilities a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:immediatelyAffectsAbilityToFulfill ;
            owl:someValuesFrom ns1:ConstitutionalResponsibility ],
        ns1:OfficialDuty .

ns1:Feature a owl:Class ;
    rdfs:label "Feature"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointWith ns1:PhysicalObject .

ns1:FederalDeathPenaltyInstance a owl:NamedIndividual,
        ns1:FederalDeathPenalty ;
    rdfs:label "federal death penalty"^^xsd:string .

ns1:HighCrimesAndMisdemeanorsGround a owl:NamedIndividual,
        ns1:ImpeachmentGround ;
    rdfs:label "\"high crimes and misdemeanors\""^^xsd:string .

ns1:LegalDocument a owl:Class ;
    rdfs:subClassOf ns1:LegalSource .

ns1:LegalGround a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:MyersVUnitedStates a owl:NamedIndividual,
        ns1:SupremeCourtDecision ;
    rdfs:label "Myers v. United States"^^xsd:string ;
    ns1:establishesRuleDescription "the President may remove executive branch officials without the consent of the Senate or any other entity"^^xsd:string ;
    ns1:issuedByCourt ns1:SupremeCourt .

ns1:NonAgentivePhysicalObject a owl:Class ;
    rdfs:label "Non-Agentive Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalObject .

ns1:OfficialEngagedInPurelyExecutiveFunctions a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:engagedInFunction ;
            owl:someValuesFrom ns1:PurelyExecutiveFunction ],
        ns1:ExecutiveBranchOfficial .

ns1:OfficialWhoseDutiesAffectPresidentialResponsibilities a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasDuty ;
            owl:someValuesFrom ns1:DutyAffectingPresidentialResponsibilities ],
        ns1:ExecutiveBranchOfficial .

ns1:PurelyExecutiveFunction a owl:Class ;
    rdfs:subClassOf ns1:OfficialFunction .

ns1:SocialAgent a owl:Class ;
    rdfs:label "Social Agent"^^xsd:string ;
    rdfs:subClassOf ns1:AgentiveSocialObject ;
    owl:disjointWith ns1:Society .

ns1:TemporalLocation a owl:Class ;
    rdfs:label "Temporal Location"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:qualeOf ] ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:TemporalQuality .

ns1:TreasonGround a owl:NamedIndividual,
        ns1:ImpeachmentGround ;
    rdfs:label "treason"^^xsd:string .

ns1:UnitedStatesDepartmentOfJustice a owl:NamedIndividual,
        ns1:GovernmentDepartment ;
    rdfs:label "United States Department of Justice"^^xsd:string .

ns1:UnitedStatesGovernment a owl:NamedIndividual,
        ns1:Government ;
    rdfs:label "United States government"^^xsd:string .

ns1:Year a owl:Class ;
    rdfs:subClassOf ns1:TimeInterval .

ns1:Year1986 a owl:NamedIndividual,
        ns1:Year ;
    rdfs:label "1986"^^xsd:string .

ns1:appointedBy a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:PresidentOffice .

ns1:appointedUnderClause a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:ConstitutionalClause .

ns1:appointedWithAdviceAndConsentOf a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:LegislativeBody .

ns1:chiefLawyerOf a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:Government .

ns1:civilOfficerOf a owl:ObjectProperty ;
    rdfs:domain ns1:CivilOfficer ;
    rdfs:range ns1:NationState .

ns1:constantAtomicPartOf a owl:ObjectProperty ;
    rdfs:label "constant atomic part of"^^xsd:string ;
    rdfs:domain ns1:ConstantAtom ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantPartOf .

ns1:constantParticipantOf a owl:ObjectProperty ;
    rdfs:label "constant participation of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Perdurant ;
    rdfs:subPropertyOf [ owl:inverseOf ns1:specificallyDependsOn ] .

ns1:engagedInFunction a owl:ObjectProperty ;
    rdfs:domain ns1:ExecutiveBranchOfficial ;
    rdfs:range ns1:OfficialFunction .

ns1:hasDuty a owl:ObjectProperty ;
    rdfs:domain ns1:ExecutiveBranchOfficial ;
    rdfs:range ns1:OfficialDuty .

ns1:hasPowerToSeekPenalty a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:LegalPenalty .

ns1:headsOrganization a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:GovernmentOrganization .

ns1:immediatelyAffectsAbilityToFulfill a owl:ObjectProperty ;
    rdfs:domain ns1:OfficialDuty ;
    rdfs:range ns1:ConstitutionalResponsibility .

ns1:impeachableFor a owl:ObjectProperty ;
    rdfs:domain ns1:CivilOfficer ;
    rdfs:range ns1:ImpeachmentGround .

ns1:issuedByCourt a owl:ObjectProperty ;
    rdfs:domain ns1:JudicialDecision ;
    rdfs:range ns1:Court .

ns1:mayBeImpeachedBy a owl:ObjectProperty ;
    rdfs:domain ns1:CivilOfficer ;
    rdfs:range ns1:LegislativeBody .

ns1:nominatedBy a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:PresidentOffice .

ns1:partOfLegalSource a owl:ObjectProperty ;
    rdfs:domain ns1:LegalSource ;
    rdfs:range ns1:LegalSource .

ns1:properPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "proper part of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:partOf .

ns1:removalDoesNotRequireConsentOf a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:LegalInstitution .

ns1:removalPowerSupportedBy a owl:ObjectProperty ;
    rdfs:domain ns1:ExecutiveBranchOfficial ;
    rdfs:range ns1:LegalDoctrine .

ns1:AgentivePhysicalObject a owl:Class ;
    rdfs:label "Agentive Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalObject .

ns1:AppointmentsClauseClass a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:partOfLegalSource ;
            owl:someValuesFrom ns1:ConstitutionDocument ],
        ns1:ConstitutionalClause .

ns1:AttorneyGeneral a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:chiefLawyerOf ;
            owl:someValuesFrom ns1:Government ],
        [ a owl:Restriction ;
            owl:onProperty ns1:mayBeImpeachedBy ;
            owl:someValuesFrom ns1:LegislativeBody ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasPowerToSeekPenalty ;
            owl:someValuesFrom ns1:FederalDeathPenalty ],
        [ a owl:Restriction ;
            owl:onProperty ns1:mayBeRemovedBy ;
            owl:someValuesFrom ns1:PresidentOffice ],
        [ a owl:Restriction ;
            owl:onProperty ns1:appointedBy ;
            owl:someValuesFrom ns1:PresidentOffice ],
        [ a owl:Restriction ;
            owl:onProperty ns1:nominatedBy ;
            owl:someValuesFrom ns1:PresidentOffice ],
        [ a owl:Restriction ;
            owl:onProperty ns1:appointedWithAdviceAndConsentOf ;
            owl:someValuesFrom ns1:LegislativeBody ],
        [ a owl:Restriction ;
            owl:onProperty ns1:removalDoesNotRequireConsentOf ;
            owl:someValuesFrom ns1:LegalInstitution ],
        [ a owl:Restriction ;
            owl:onProperty ns1:appointedUnderClause ;
            owl:someValuesFrom ns1:AppointmentsClauseClass ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:LegalAffair ;
            owl:onProperty ns1:concernedWith ],
        [ a owl:Restriction ;
            owl:onProperty ns1:impeachableFor ;
            owl:someValuesFrom ns1:ImpeachmentGround ],
        [ a owl:Restriction ;
            owl:onProperty ns1:headsOrganization ;
            owl:someValuesFrom ns1:GovernmentDepartment ],
        [ a owl:Restriction ;
            owl:onProperty ns1:concernedWith ;
            owl:someValuesFrom ns1:LegalAffair ],
        ns1:ExecutiveBranchOfficial .

ns1:CommonLawDoctrine a owl:Class ;
    rdfs:subClassOf ns1:LegalDoctrine .

ns1:ConstitutionDocument a owl:Class ;
    rdfs:subClassOf ns1:LegalDocument .

ns1:ConstitutionalClause a owl:Class ;
    rdfs:subClassOf ns1:LegalSource .

ns1:ConstitutionalResponsibility a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:Event a owl:Class ;
    rdfs:label "Event"^^xsd:string ;
    rdfs:subClassOf ns1:Perdurant ;
    owl:disjointWith ns1:Stative .

ns1:FederalDeathPenalty a owl:Class ;
    rdfs:subClassOf ns1:DeathPenalty .

ns1:GovernmentDepartment a owl:Class ;
    rdfs:subClassOf ns1:GovernmentOrganization .

ns1:GovernmentOrganization a owl:Class ;
    rdfs:subClassOf ns1:LegalInstitution .

ns1:LegalMatter a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:LegalPenalty a owl:Class ;
    rdfs:subClassOf ns1:LegalMatter .

ns1:NonPhysicalObject a owl:Class ;
    rdfs:label "Non-Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:NonPhysicalEndurant .

ns1:OfficialFunction a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:SenateBody a owl:NamedIndividual,
        ns1:LegislativeBody ;
    rdfs:label "Senate"^^xsd:string .

ns1:SpaceRegion a owl:Class ;
    rdfs:label "Space Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpatialLocation ;
            owl:onProperty ns1:constantQualeOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpaceRegion ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpaceRegion ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:PhysicalRegion .

ns1:SpatialLocation a owl:Class ;
    rdfs:label "Spatial Location"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalQuality .

ns1:State a owl:Class ;
    rdfs:label "State"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:State ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Stative .

ns1:SupremeCourt a owl:NamedIndividual,
        ns1:Court ;
    rdfs:label "Supreme Court"^^xsd:string .

ns1:SupremeCourtDecision a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:issuedByCourt ;
            owl:someValuesFrom ns1:Court ],
        ns1:JudicialDecision .

ns1:concernedWith a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:LegalAffair .

ns1:constantProperPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant proper part of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantPartOf .

ns1:constantlyOverlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "constantly overlaps"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns1:constantPartOf ] ns1:constantPartOf ) .

ns1:mayBeRemovedBy a owl:ObjectProperty ;
    rdfs:domain ns1:GovernmentOfficial ;
    rdfs:range ns1:PresidentOffice .

ns1:qualeOf a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "quale of"^^xsd:string ;
    rdfs:domain ns1:TemporalRegion ;
    rdfs:range ns1:TemporalQuality .

ns1:AgentiveSocialObject a owl:Class ;
    rdfs:label "Agentive Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:Atom a owl:Class ;
    rdfs:label "Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf ns1:properPartOf ] ;
                    owl:someValuesFrom ns1:Particular ] ],
        ns1:Particular .

ns1:Court a owl:Class ;
    rdfs:subClassOf ns1:LegalInstitution .

ns1:Government a owl:Class ;
    rdfs:subClassOf ns1:Society .

ns1:LegalAffair a owl:Class ;
    rdfs:subClassOf ns1:LegalMatter .

ns1:NationState a owl:Class ;
    rdfs:subClassOf ns1:Society .

ns1:OfficialDuty a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:PresidentOfficeInstance a owl:NamedIndividual,
        ns1:PresidentOffice ;
    rdfs:label "President"^^xsd:string .

ns1:Region a owl:Class ;
    rdfs:label "Region"^^xsd:string ;
    rdfs:subClassOf ns1:Abstract ;
    owl:disjointUnionOf ( ns1:AbstractRegion ns1:PhysicalRegion ns1:TemporalRegion ) .

ns1:SocialObject a owl:Class ;
    rdfs:label "Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:NonPhysicalObject ;
    owl:disjointUnionOf ( ns1:AgentiveSocialObject ns1:NonAgentiveSocialObject ) .

ns1:Stative a owl:Class ;
    rdfs:label "Stative"^^xsd:string ;
    rdfs:subClassOf ns1:Perdurant .

ns1:TemporalRegion a owl:Class ;
    rdfs:label "Temporal Region"^^xsd:string ;
    rdfs:subClassOf ns1:Region .

ns1:overlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "overlaps"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns1:partOf ] ns1:partOf ),
        ( [ owl:inverseOf ns1:presentAt ] ns1:temporallyLocatedAt ) .

ns1:AbstractQuality a owl:Class ;
    rdfs:label "Abstract Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty [ owl:inverseOf ns1:constantQualeOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:CivilOfficer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:civilOfficerOf ;
            owl:someValuesFrom ns1:NationState ],
        ns1:GovernmentOfficial .

ns1:LegalDoctrine a owl:Class ;
    rdfs:subClassOf ns1:LegalSource .

ns1:PhysicalObject a owl:Class ;
    rdfs:label "Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointUnionOf ( ns1:AgentivePhysicalObject ns1:NonAgentivePhysicalObject ) .

ns1:PhysicalRegion a owl:Class ;
    rdfs:label "Physical Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalQuality ;
            owl:onProperty ns1:constantQualeOf ],
        ns1:Region .

ns1:Society a owl:Class ;
    rdfs:label "Society"^^xsd:string ;
    rdfs:subClassOf ns1:AgentiveSocialObject .

ns1:TemporalQuality a owl:Class ;
    rdfs:label "Temporal Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:qualeOf ] ;
            owl:someValuesFrom ns1:Particular ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:AbstractRegion a owl:Class ;
    rdfs:label "Abstract Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractQuality ;
            owl:onProperty ns1:constantQualeOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Region .

ns1:ImpeachmentGround a owl:Class ;
    rdfs:subClassOf ns1:LegalGround .

ns1:LegalInstitution a owl:Class ;
    rdfs:subClassOf ns1:Society .

ns1:PhysicalQuality a owl:Class ;
    rdfs:label "Physical Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalRegion ;
            owl:onProperty [ owl:inverseOf ns1:constantQualeOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:constantQualeOf a owl:ObjectProperty ;
    rdfs:label "constant quale of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:AbstractRegion ns1:PhysicalRegion ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:AbstractQuality ns1:PhysicalQuality ) ] .

ns1:specificallyDependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "specifically depends on"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] .

ns1:JudicialDecision a owl:Class ;
    rdfs:subClassOf ns1:LegalSource .

ns1:LegalSource a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:LegislativeBody a owl:Class ;
    rdfs:subClassOf ns1:LegalInstitution .

ns1:NonAgentiveSocialObject a owl:Class ;
    rdfs:label "Non-Agentive Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:constantConstituentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant constituent of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:NonPhysicalEndurant ns1:Perdurant ns1:PhysicalEndurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:NonPhysicalEndurant ns1:Perdurant ns1:PhysicalEndurant ) ] ;
    rdfs:subPropertyOf [ owl:inverseOf ns1:specificallyDependsOn ] .

ns1:constantPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant part of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantlyOverlaps .

ns1:temporallyLocatedAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temporally located at"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range ns1:TimeInterval ;
    rdfs:subPropertyOf ns1:presentAt .

ns1:ExecutiveBranchOfficial a owl:Class ;
    rdfs:subClassOf ns1:CivilOfficer .

ns1:NonPhysicalEndurant a owl:Class ;
    rdfs:label "Non-Physical Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:constantlyOverlaps ;
                    owl:someValuesFrom ns1:PhysicalEndurant ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantPartOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty ns1:constantConstituentOf ],
        ns1:Endurant .

ns1:PresidentOffice a owl:Class ;
    rdfs:subClassOf ns1:ExecutiveBranchOfficial .

ns1:Particular a owl:Class ;
    rdfs:label "Particular"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ns1:Abstract ns1:Endurant ns1:Perdurant ns1:Quality ) .

ns1:Quality a owl:Class ;
    rdfs:label "Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns1:directQualityOf ;
            owl:someValuesFrom ns1:Particular ],
        ns1:Particular ;
    owl:disjointUnionOf ( ns1:AbstractQuality ns1:PhysicalQuality ns1:TemporalQuality ) .

ns1:TimeInterval a owl:Class ;
    rdfs:label "Time Interval"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:TimeInterval ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:TemporalRegion .

ns1:PhysicalEndurant a owl:Class ;
    rdfs:label "Physical Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty ns1:constantConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ;
            owl:someValuesFrom ns1:SpatialLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantPartOf ] ],
        ns1:Endurant .

ns1:directQualityOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "direct quality of"^^xsd:string ;
    rdfs:domain ns1:Quality ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:specificallyDependsOn .

ns1:GovernmentOfficial a owl:Class ;
    rdfs:subClassOf ns1:SocialAgent .

ns1:presentAt a owl:ObjectProperty ;
    rdfs:label "present at"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range ns1:TimeInterval ;
    owl:propertyChainAxiom ( ns1:constantAtomicPartOf ns1:presentAt ),
        ( ns1:constantConstituentOf ns1:presentAt ),
        ( ns1:constantPartOf ns1:presentAt ),
        ( ns1:constantParticipantOf ns1:presentAt ),
        ( ns1:constantProperPartOf ns1:presentAt ),
        ( ns1:directQualityOf ns1:presentAt ),
        ( ns1:presentAt [ owl:inverseOf ns1:partOf ] ),
        ( [ owl:inverseOf ns1:directQualityOf ] ns1:presentAt ),
        ( [ owl:inverseOf ns1:partOf ] ns1:presentAt ),
        ( [ owl:inverseOf ns1:specificallyDependsOn ] ns1:presentAt ) .

ns1:Abstract a owl:Class ;
    rdfs:label "Abstract"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty ns1:overlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Particular .

ns1:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:overlaps .

ns1:Endurant a owl:Class ;
    rdfs:label "Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:Particular ;
    owl:disjointUnionOf ( ns1:ArbitrarySum ns1:NonPhysicalEndurant ns1:PhysicalEndurant ) .

ns1:Perdurant a owl:Class ;
    rdfs:label "Perdurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:overlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:constantConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:TemporalQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ;
            owl:someValuesFrom ns1:TemporalLocation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:Particular .