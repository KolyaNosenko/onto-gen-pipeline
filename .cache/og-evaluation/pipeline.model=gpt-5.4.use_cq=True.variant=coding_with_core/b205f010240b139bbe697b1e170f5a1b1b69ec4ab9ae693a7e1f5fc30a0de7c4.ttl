@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:AmountOfMatter a owl:Class ;
    rdfs:label "Amount of Matter"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointWith ns1:Feature,
        ns1:PhysicalObject .

ns1:MentalObject a owl:Class ;
    rdfs:label "Mental Object"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:specificallyDependsOn ;
            owl:someValuesFrom ns1:AgentivePhysicalObject ],
        ns1:NonPhysicalObject ;
    owl:disjointWith ns1:SocialObject .

ns1:Process a owl:Class ;
    rdfs:label "Process"^^xsd:string ;
    rdfs:subClassOf ns1:Stative ;
    owl:disjointWith ns1:State .

ns1:ShadowrunHongKongKickstarterCampaign a owl:NamedIndividual,
        ns1:KickstarterCampaign ;
    rdfs:label "a Kickstarter campaign"^^xsd:string ;
    ns1:endedIn ns1:FollowingMonthInterval ;
    ns1:fundsAdditionOf ns1:AdditionalFeaturesAndContentSet ;
    ns1:goalReachedWithin ns1:FewHoursDuration ;
    ns1:hasFundingGoal ns1:USD100000Amount ;
    ns1:hostedOn ns1:KickstarterPlatform ;
    ns1:launchedBy ns1:HarebrainedSchemesStudio ;
    ns1:launchedIn ns1:January2015Interval ;
    ns1:receivedTotalFunding ns1:USD1200000Amount ;
    ns1:targetsGame ns1:ShadowrunHongKongGame .

ns1:SocialAgent a owl:Class ;
    rdfs:label "Social Agent"^^xsd:string ;
    rdfs:subClassOf ns1:AgentiveSocialObject ;
    owl:disjointWith ns1:Society .

ns1:atomicPartOf a owl:ObjectProperty ;
    rdfs:label "atomic part of"^^xsd:string ;
    rdfs:domain ns1:Atom ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:partOf .

ns1:avoidedHardwareLimitation a owl:ObjectProperty ;
    rdfs:domain ns1:GameStudio ;
    rdfs:range ns1:HardwareLimitation .

ns1:avoidsHardwareLimitation a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:HardwareLimitation .

ns1:developedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameStudio .

ns1:developedForPlatform a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:OperatingSystem .

ns1:developedWith a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameEngine .

ns1:endedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:TimeInterval .

ns1:freeForOwnersOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGameEdition ;
    rdfs:range ns1:VideoGame .

ns1:fundsAdditionOf a owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:FeatureContentSet .

ns1:goalReachedWithin a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:DurationDescription .

ns1:hasEdition a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGameEdition .

ns1:hostedOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:CrowdfundingPlatform .

ns1:intendedForGame a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:FeatureContentSet ;
    rdfs:range ns1:VideoGame .

ns1:launchedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:TimeInterval .

ns1:ofDevice a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:HardwareLimitation ;
    rdfs:range ns1:TabletDevice .

ns1:previouslyDeveloped a owl:ObjectProperty ;
    rdfs:domain ns1:GameStudio ;
    rdfs:range ns1:VideoGame .

ns1:publishedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameStudio .

ns1:releasedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGameEdition ;
    rdfs:range ns1:TimeInterval .

ns1:releasedWorldwideIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:TimeInterval .

ns1:setIn a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:FictionalUniverse .

ns1:shippedWith a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:LevelEditor .

ns1:targetsGame a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:VideoGame .

ns1:temporalPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "temporal part of"^^xsd:string ;
    rdfs:domain ns1:Perdurant ;
    rdfs:range ns1:Perdurant ;
    rdfs:subPropertyOf ns1:partOf .

ns1:usedWith a owl:ObjectProperty ;
    rdfs:domain ns1:GameEngine ;
    rdfs:range ns1:VideoGame .

ns1:Accomplishment a owl:Class ;
    rdfs:label "Accomplishment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:temporallyLocatedAt ;
                    owl:someValuesFrom ns1:Atom ] ],
        ns1:Event ;
    owl:disjointWith ns1:Achievement .

ns1:Achievement a owl:Class ;
    rdfs:label "Achievement"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:Atom ],
        ns1:Event .

ns1:AdditionalFeaturesAndContentSet a owl:NamedIndividual,
        ns1:FeatureContentSet ;
    rdfs:label "additional features and content"^^xsd:string ;
    ns1:intendedForGame ns1:ShadowrunHongKongGame .

ns1:ArbitrarySum a owl:Class ;
    rdfs:label "Arbitrary Sum"^^xsd:string ;
    rdfs:subClassOf ns1:Endurant .

ns1:August2015Interval a owl:NamedIndividual,
        ns1:TimeInterval ;
    rdfs:label "August 2015"^^xsd:string .

ns1:ConstantAtom a owl:Class ;
    rdfs:label "Constant Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf ns1:constantProperPartOf ] ;
                    owl:someValuesFrom ns1:Particular ] ],
        ns1:Endurant .

ns1:CrowdfundingCampaign a owl:Class ;
    rdfs:subClassOf ns1:Accomplishment .

ns1:ExtendedEdition a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:editionOf ;
            owl:someValuesFrom ns1:VideoGame ],
        [ a owl:Restriction ;
            owl:onProperty ns1:includesContent ;
            owl:someValuesFrom ns1:GameCampaign ],
        [ a owl:Restriction ;
            owl:onProperty ns1:includesContent ;
            owl:someValuesFrom ns1:DeveloperCommentary ],
        [ a owl:Restriction ;
            owl:onProperty ns1:includesContent ;
            owl:someValuesFrom ns1:BugFixCollection ],
        ns1:VideoGameEdition .

ns1:Feature a owl:Class ;
    rdfs:label "Feature"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointWith ns1:PhysicalObject .

ns1:February2016Interval a owl:NamedIndividual,
        ns1:TimeInterval ;
    rdfs:label "February 2016"^^xsd:string .

ns1:FewHoursDuration a owl:NamedIndividual,
        ns1:DurationDescription ;
    rdfs:label "a few hours"^^xsd:string .

ns1:FollowingMonthInterval a owl:NamedIndividual,
        ns1:TimeInterval ;
    rdfs:label "the following month"^^xsd:string .

ns1:ImprovedShadowrunEngine a owl:NamedIndividual,
        ns1:ImprovedGameEngine ;
    rdfs:label "an improved version of the engine used with Shadowrun Returns and Dragonfall"^^xsd:string ;
    ns1:improvesOn ns1:ShadowrunReturnsDragonfallEngine .

ns1:January2015Interval a owl:NamedIndividual,
        ns1:TimeInterval ;
    rdfs:label "January 2015"^^xsd:string .

ns1:KickstarterPlatform a owl:NamedIndividual,
        ns1:CrowdfundingPlatform ;
    rdfs:label "Kickstarter"^^xsd:string .

ns1:LinuxPlatform a owl:NamedIndividual,
        ns1:OperatingSystem ;
    rdfs:label "Linux"^^xsd:string .

ns1:MicrosoftWindowsPlatform a owl:NamedIndividual,
        ns1:OperatingSystem ;
    rdfs:label "Microsoft Windows"^^xsd:string .

ns1:OSXPlatform a owl:NamedIndividual,
        ns1:OperatingSystem ;
    rdfs:label "OS X"^^xsd:string .

ns1:ShadowrunCampaign a owl:Class ;
    rdfs:subClassOf ns1:GameCampaign .

ns1:ShadowrunHongKongBugFixes a owl:NamedIndividual,
        ns1:BugFixCollection ;
    rdfs:label "bug fixes for the original game"^^xsd:string .

ns1:ShadowrunHongKongDeveloperCommentary a owl:NamedIndividual,
        ns1:DeveloperCommentary ;
    rdfs:label "a developer commentary"^^xsd:string .

ns1:ShadowrunHongKongExtendedEdition a owl:NamedIndividual,
        ns1:ExtendedEdition ;
    rdfs:label "an extended edition"^^xsd:string ;
    ns1:editionOf ns1:ShadowrunHongKongGame ;
    ns1:freeForOwnersOf ns1:ShadowrunHongKongGame ;
    ns1:includesContent ns1:ShadowrunHongKongBugFixes,
        ns1:ShadowrunHongKongDeveloperCommentary,
        ns1:ShadowrunHongKongExtendedEditionCampaign ;
    ns1:releasedIn ns1:February2016Interval .

ns1:ShadowrunHongKongExtendedEditionCampaign a owl:NamedIndividual,
        ns1:GameCampaign ;
    rdfs:label "a new campaign"^^xsd:string .

ns1:ShadowrunHongKongLevelEditor a owl:NamedIndividual,
        ns1:LevelEditor ;
    rdfs:label "a level editor"^^xsd:string ;
    ns1:allowsCreationOf ns1:PlayerCreatedShadowrunCampaigns ;
    ns1:allowsSharingOf ns1:PlayerCreatedShadowrunCampaigns .

ns1:ShadowrunHongKongSinglePlayerCampaign a owl:NamedIndividual,
        ns1:SinglePlayerCampaign ;
    rdfs:label "a new single - player campaign"^^xsd:string .

ns1:ShadowrunReturnsDragonfallEngine a owl:NamedIndividual,
        ns1:GameEngine ;
    rdfs:label "the engine used with Shadowrun Returns and Dragonfall"^^xsd:string ;
    ns1:usedWith ns1:DragonfallExpansion,
        ns1:ShadowrunReturnsGame .

ns1:ShadowrunUniverseSetting a owl:NamedIndividual,
        ns1:FictionalUniverse ;
    rdfs:label "Shadowrun universe"^^xsd:string .

ns1:SinglePlayerCampaign a owl:Class ;
    rdfs:subClassOf ns1:GameCampaign .

ns1:TabletDevices a owl:NamedIndividual,
        ns1:TabletDevice ;
    rdfs:label "tablets"^^xsd:string .

ns1:TemporalLocation a owl:Class ;
    rdfs:label "Temporal Location"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:qualeOf ] ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:TemporalQuality .

ns1:TurnBasedTacticalRolePlayingVideoGame a owl:Class ;
    rdfs:subClassOf ns1:StandaloneVideoGame .

ns1:USD100000Amount a owl:NamedIndividual,
        ns1:MonetaryAmount ;
    rdfs:label "US$ 100,000"^^xsd:string .

ns1:USD1200000Amount a owl:NamedIndividual,
        ns1:MonetaryAmount ;
    rdfs:label "$ 1.2 million"^^xsd:string .

ns1:VideoGameExpansion a owl:Class ;
    rdfs:subClassOf ns1:VideoGame .

ns1:allowsCreationOf a owl:ObjectProperty ;
    rdfs:domain ns1:LevelEditor ;
    rdfs:range ns1:PlayerCreatedShadowrunCampaign .

ns1:allowsSharingOf a owl:ObjectProperty ;
    rdfs:domain ns1:LevelEditor ;
    rdfs:range ns1:PlayerCreatedShadowrunCampaign .

ns1:constantAtomicPartOf a owl:ObjectProperty ;
    rdfs:label "constant atomic part of"^^xsd:string ;
    rdfs:domain ns1:ConstantAtom ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantPartOf .

ns1:constantParticipantOf a owl:ObjectProperty ;
    rdfs:label "constant participation of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Perdurant ;
    rdfs:subPropertyOf [ owl:inverseOf ns1:specificallyDependsOn ] .

ns1:editionOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:VideoGameEdition ;
    rdfs:range ns1:VideoGame .

ns1:hasFundingGoal a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:MonetaryAmount .

ns1:improvesOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:ImprovedGameEngine ;
    rdfs:range ns1:GameEngine .

ns1:launchedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:GameStudio .

ns1:properPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "proper part of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:partOf .

ns1:receivedTotalFunding a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:KickstarterCampaign ;
    rdfs:range ns1:MonetaryAmount .

ns1:AgentivePhysicalObject a owl:Class ;
    rdfs:label "Agentive Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalObject .

ns1:BugFixCollection a owl:Class ;
    rdfs:subClassOf ns1:GameContent .

ns1:CrowdfundingPlatform a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:DeveloperCommentary a owl:Class ;
    rdfs:subClassOf ns1:GameContent .

ns1:DragonfallExpansion a owl:NamedIndividual,
        ns1:VideoGameExpansion ;
    rdfs:label "Dragonfall"^^xsd:string .

ns1:DurationDescription a owl:Class ;
    rdfs:subClassOf ns1:Abstract .

ns1:Event a owl:Class ;
    rdfs:label "Event"^^xsd:string ;
    rdfs:subClassOf ns1:Perdurant ;
    owl:disjointWith ns1:Stative .

ns1:FictionalUniverse a owl:Class ;
    rdfs:subClassOf ns1:SocialObject .

ns1:ImprovedGameEngine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:improvesOn ;
            owl:someValuesFrom ns1:GameEngine ],
        ns1:GameEngine .

ns1:NonAgentivePhysicalObject a owl:Class ;
    rdfs:label "Non-Agentive Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalObject .

ns1:NonPhysicalObject a owl:Class ;
    rdfs:label "Non-Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:NonPhysicalEndurant .

ns1:PlayerCreatedShadowrunCampaigns a owl:NamedIndividual,
        ns1:PlayerCreatedShadowrunCampaign ;
    rdfs:label "their own Shadowrun campaigns"^^xsd:string .

ns1:ShadowrunReturnsGame a owl:NamedIndividual,
        ns1:StandaloneVideoGame ;
    rdfs:label "Shadowrun Returns"^^xsd:string .

ns1:Society a owl:Class ;
    rdfs:label "Society"^^xsd:string ;
    rdfs:subClassOf ns1:AgentiveSocialObject .

ns1:SpaceRegion a owl:Class ;
    rdfs:label "Space Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpatialLocation ;
            owl:onProperty ns1:constantQualeOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpaceRegion ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:SpaceRegion ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:PhysicalRegion .

ns1:SpatialLocation a owl:Class ;
    rdfs:label "Spatial Location"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalQuality .

ns1:StandaloneVideoGame a owl:Class ;
    rdfs:subClassOf ns1:VideoGame .

ns1:State a owl:Class ;
    rdfs:label "State"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:State ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Stative .

ns1:TabletDevice a owl:Class ;
    rdfs:subClassOf ns1:NonAgentivePhysicalObject .

ns1:TabletHardwareLimitations a owl:NamedIndividual,
        ns1:HardwareLimitation ;
    rdfs:label "hardware limitations"^^xsd:string ;
    ns1:ofDevice ns1:TabletDevices .

ns1:constantProperPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant proper part of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantPartOf .

ns1:constantlyOverlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "constantly overlaps"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns1:constantPartOf ] ns1:constantPartOf ) .

ns1:qualeOf a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "quale of"^^xsd:string ;
    rdfs:domain ns1:TemporalRegion ;
    rdfs:range ns1:TemporalQuality .

ns1:AgentiveSocialObject a owl:Class ;
    rdfs:label "Agentive Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:Atom a owl:Class ;
    rdfs:label "Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf ns1:properPartOf ] ;
                    owl:someValuesFrom ns1:Particular ] ],
        ns1:Particular .

ns1:FeatureContentSet a owl:Class ;
    rdfs:subClassOf ns1:GameContent .

ns1:HarebrainedSchemesStudio a owl:NamedIndividual,
        ns1:GameStudio ;
    rdfs:label "Harebrained Schemes"^^xsd:string ;
    ns1:avoidedHardwareLimitation ns1:TabletHardwareLimitations ;
    ns1:previouslyDeveloped ns1:DragonfallExpansion,
        ns1:ShadowrunReturnsGame .

ns1:Region a owl:Class ;
    rdfs:label "Region"^^xsd:string ;
    rdfs:subClassOf ns1:Abstract ;
    owl:disjointUnionOf ( ns1:AbstractRegion ns1:PhysicalRegion ns1:TemporalRegion ) .

ns1:Stative a owl:Class ;
    rdfs:label "Stative"^^xsd:string ;
    rdfs:subClassOf ns1:Perdurant .

ns1:TemporalRegion a owl:Class ;
    rdfs:label "Temporal Region"^^xsd:string ;
    rdfs:subClassOf ns1:Region .

ns1:includesContent a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameContent .

ns1:overlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "overlaps"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns1:partOf ] ns1:partOf ),
        ( [ owl:inverseOf ns1:presentAt ] ns1:temporallyLocatedAt ) .

ns1:AbstractQuality a owl:Class ;
    rdfs:label "Abstract Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty [ owl:inverseOf ns1:constantQualeOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:GameCampaign a owl:Class ;
    rdfs:subClassOf ns1:GameContent .

ns1:HardwareLimitation a owl:Class ;
    rdfs:subClassOf ns1:Abstract .

ns1:LevelEditor a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:allowsCreationOf ;
            owl:someValuesFrom ns1:PlayerCreatedShadowrunCampaign ],
        [ a owl:Restriction ;
            owl:onProperty ns1:allowsSharingOf ;
            owl:someValuesFrom ns1:PlayerCreatedShadowrunCampaign ],
        ns1:GameContent .

ns1:OperatingSystem a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:PhysicalObject a owl:Class ;
    rdfs:label "Physical Object"^^xsd:string ;
    rdfs:subClassOf ns1:PhysicalEndurant ;
    owl:disjointUnionOf ( ns1:AgentivePhysicalObject ns1:NonAgentivePhysicalObject ) .

ns1:PhysicalRegion a owl:Class ;
    rdfs:label "Physical Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalQuality ;
            owl:onProperty ns1:constantQualeOf ],
        ns1:Region .

ns1:ShadowrunHongKongGame a owl:NamedIndividual,
        ns1:TurnBasedTacticalRolePlayingVideoGame ;
    rdfs:label "Shadowrun : Hong Kong"^^xsd:string ;
    ns1:avoidsHardwareLimitation ns1:TabletHardwareLimitations ;
    ns1:developedBy ns1:HarebrainedSchemesStudio ;
    ns1:developedForPlatform ns1:LinuxPlatform,
        ns1:MicrosoftWindowsPlatform,
        ns1:OSXPlatform ;
    ns1:developedWith ns1:ImprovedShadowrunEngine ;
    ns1:hasEdition ns1:ShadowrunHongKongExtendedEdition ;
    ns1:includesContent ns1:ShadowrunHongKongSinglePlayerCampaign ;
    ns1:publishedBy ns1:HarebrainedSchemesStudio ;
    ns1:releasedWorldwideIn ns1:August2015Interval ;
    ns1:setIn ns1:ShadowrunUniverseSetting ;
    ns1:shippedWith ns1:ShadowrunHongKongLevelEditor .

ns1:SocialObject a owl:Class ;
    rdfs:label "Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:NonPhysicalObject ;
    owl:disjointUnionOf ( ns1:AgentiveSocialObject ns1:NonAgentiveSocialObject ) .

ns1:TemporalQuality a owl:Class ;
    rdfs:label "Temporal Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:qualeOf ] ;
            owl:someValuesFrom ns1:Particular ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:AbstractRegion a owl:Class ;
    rdfs:label "Abstract Region"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractQuality ;
            owl:onProperty ns1:constantQualeOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractRegion ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Region .

ns1:PhysicalQuality a owl:Class ;
    rdfs:label "Physical Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalRegion ;
            owl:onProperty [ owl:inverseOf ns1:constantQualeOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty ns1:directQualityOf ],
        ns1:Quality .

ns1:PlayerCreatedShadowrunCampaign a owl:Class ;
    rdfs:subClassOf ns1:ShadowrunCampaign .

ns1:VideoGameEdition a owl:Class ;
    rdfs:subClassOf ns1:VideoGame .

ns1:constantQualeOf a owl:ObjectProperty ;
    rdfs:label "constant quale of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:AbstractRegion ns1:PhysicalRegion ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:AbstractQuality ns1:PhysicalQuality ) ] .

ns1:specificallyDependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "specifically depends on"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] .

ns1:GameContent a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:GameEngine a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:MonetaryAmount a owl:Class ;
    rdfs:subClassOf ns1:Abstract .

ns1:NonAgentiveSocialObject a owl:Class ;
    rdfs:label "Non-Agentive Social Object"^^xsd:string ;
    rdfs:subClassOf ns1:SocialObject .

ns1:temporallyLocatedAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temporally located at"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range ns1:TimeInterval ;
    rdfs:subPropertyOf ns1:presentAt .

ns1:GameStudio a owl:Class ;
    rdfs:subClassOf ns1:Society .

ns1:constantConstituentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant constituent of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:NonPhysicalEndurant ns1:Perdurant ns1:PhysicalEndurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:NonPhysicalEndurant ns1:Perdurant ns1:PhysicalEndurant ) ] ;
    rdfs:subPropertyOf [ owl:inverseOf ns1:specificallyDependsOn ] .

ns1:constantPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "constant part of"^^xsd:string ;
    rdfs:domain ns1:Endurant ;
    rdfs:range ns1:Endurant ;
    rdfs:subPropertyOf ns1:constantlyOverlaps .

ns1:NonPhysicalEndurant a owl:Class ;
    rdfs:label "Non-Physical Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AbstractQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:constantlyOverlaps ;
                    owl:someValuesFrom ns1:PhysicalEndurant ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantPartOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:NonPhysicalEndurant ;
            owl:onProperty ns1:constantConstituentOf ],
        ns1:Endurant .

ns1:Particular a owl:Class ;
    rdfs:label "Particular"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ns1:Abstract ns1:Endurant ns1:Perdurant ns1:Quality ) .

ns1:Quality a owl:Class ;
    rdfs:label "Quality"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns1:directQualityOf ;
            owl:someValuesFrom ns1:Particular ],
        ns1:Particular ;
    owl:disjointUnionOf ( ns1:AbstractQuality ns1:PhysicalQuality ns1:TemporalQuality ) .

ns1:KickstarterCampaign a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:launchedBy ;
            owl:someValuesFrom ns1:GameStudio ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasFundingGoal ;
            owl:someValuesFrom ns1:MonetaryAmount ],
        [ a owl:Restriction ;
            owl:onProperty ns1:receivedTotalFunding ;
            owl:someValuesFrom ns1:MonetaryAmount ],
        ns1:CrowdfundingCampaign .

ns1:PhysicalEndurant a owl:Class ;
    rdfs:label "Physical Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty ns1:constantConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ;
            owl:someValuesFrom ns1:SpatialLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalEndurant ;
            owl:onProperty [ owl:inverseOf ns1:constantPartOf ] ],
        ns1:Endurant .

ns1:directQualityOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "direct quality of"^^xsd:string ;
    rdfs:domain ns1:Quality ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:specificallyDependsOn .

ns1:presentAt a owl:ObjectProperty ;
    rdfs:label "present at"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Endurant ns1:Perdurant ns1:Quality ) ] ;
    rdfs:range ns1:TimeInterval ;
    owl:propertyChainAxiom ( ns1:constantAtomicPartOf ns1:presentAt ),
        ( ns1:constantConstituentOf ns1:presentAt ),
        ( ns1:constantPartOf ns1:presentAt ),
        ( ns1:constantParticipantOf ns1:presentAt ),
        ( ns1:constantProperPartOf ns1:presentAt ),
        ( ns1:directQualityOf ns1:presentAt ),
        ( ns1:presentAt [ owl:inverseOf ns1:partOf ] ),
        ( [ owl:inverseOf ns1:directQualityOf ] ns1:presentAt ),
        ( [ owl:inverseOf ns1:partOf ] ns1:presentAt ),
        ( [ owl:inverseOf ns1:specificallyDependsOn ] ns1:presentAt ) .

ns1:TimeInterval a owl:Class ;
    rdfs:label "Time Interval"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:TimeInterval ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:TemporalRegion .

ns1:Abstract a owl:Class ;
    rdfs:label "Abstract"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty ns1:overlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Abstract ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        ns1:Particular .

ns1:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Abstract ns1:Perdurant ) ] ;
    rdfs:subPropertyOf ns1:overlaps .

ns1:Endurant a owl:Class ;
    rdfs:label "Endurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:Particular ;
    owl:disjointUnionOf ( ns1:ArbitrarySum ns1:NonPhysicalEndurant ns1:PhysicalEndurant ) .

ns1:VideoGame a owl:Class ;
    rdfs:subClassOf ns1:NonAgentiveSocialObject .

ns1:Perdurant a owl:Class ;
    rdfs:label "Perdurant"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:overlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty [ owl:inverseOf ns1:partOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty ns1:constantConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Perdurant ;
            owl:onProperty [ owl:inverseOf ns1:constantConstituentOf ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:TemporalQuality ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:directQualityOf ] ;
            owl:someValuesFrom ns1:TemporalLocation ],
        [ a owl:Restriction ;
            owl:onProperty ns1:temporallyLocatedAt ;
            owl:someValuesFrom ns1:TimeInterval ],
        ns1:Particular .