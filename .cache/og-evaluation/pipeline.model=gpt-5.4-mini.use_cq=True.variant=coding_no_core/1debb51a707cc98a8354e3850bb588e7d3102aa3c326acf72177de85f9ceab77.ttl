@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:BoomBloxBashParty a owl:NamedIndividual,
        ns1:PhysicsBasedPuzzleVideoGame ;
    rdfs:label "Boom Blox Bash Party"^^xsd:string ;
    ns1:allowsDownloadingNewLevels true ;
    ns1:allowsUploadingCustomCreatedLevels true ;
    ns1:canUploadAndDownloadUserCreatedGames false ;
    ns1:countsAsOneOfOriginalProperties false ;
    ns1:createdAsPartOfDealWith ns1:ElectronicArts,
        ns1:StevenSpielberg ;
    ns1:designedBy ns1:StevenSpielberg ;
    ns1:developedBy ns1:AmblinEntertainment,
        ns1:EALosAngeles ;
    ns1:developmentBeganAfterCompletionOf ns1:BoomBlox ;
    ns1:formallyAnnouncedOn ns1:January28_2009 ;
    ns1:hasNonEnglishTitle ns1:BoomBloxSmashPartyInNonEnglishTerritories ;
    ns1:lessEmphasisOn ns1:ShootingMode ;
    ns1:levelCountDescription "more than 400"^^xsd:string ;
    ns1:onlineServersShutDown true ;
    ns1:onlineServersShutDownBy ns1:ElectronicArts ;
    ns1:onlineServersShutDownOn ns1:April2012 ;
    ns1:originalPropertyTargetCount 3 ;
    ns1:publishedBy ns1:ElectronicArts ;
    ns1:releasedForConsole ns1:WiiVideoGameConsole ;
    ns1:releasedInEuropeOn ns1:May29_2009 ;
    ns1:releasedInNorthAmericaOn ns1:May19_2009 ;
    ns1:releasedInRegion ns1:Europe,
        ns1:NorthAmerica ;
    ns1:resembles ns1:BoomBlox ;
    ns1:sequelTo ns1:BoomBlox .

ns1:allowsDownloadingNewLevels a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:allowsUploadingCustomCreatedLevels a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:canUploadAndDownloadUserCreatedGames a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:countsAsOneOfOriginalProperties a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:createdAsPartOfDealWith a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Organization,
        ns1:Person .

ns1:designedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Person .

ns1:developedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Organization .

ns1:developmentBeganAfterCompletionOf a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGame .

ns1:formallyAnnouncedOn a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:DatePoint .

ns1:hasNonEnglishTitle a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Title .

ns1:lessEmphasisOn a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameMode .

ns1:levelCountDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:string .

ns1:onlineServersShutDown a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:onlineServersShutDownBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Organization .

ns1:onlineServersShutDownOn a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:DatePoint .

ns1:originalPropertyTargetCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:integer .

ns1:publishedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Organization .

ns1:releasedForConsole a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:GameConsole .

ns1:releasedInEuropeOn a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:DatePoint .

ns1:releasedInNorthAmericaOn a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:DatePoint .

ns1:releasedInRegion a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Region .

ns1:resembles a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGame .

ns1:sequelTo a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGame .

ns1:AmblinEntertainment a owl:NamedIndividual,
        ns1:Organization ;
    rdfs:label "Amblin Entertainment"^^xsd:string .

ns1:April2012 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "April 2012"^^xsd:string .

ns1:BoomBloxSmashPartyInNonEnglishTerritories a owl:NamedIndividual,
        ns1:Title ;
    rdfs:label "Boom Blox Smash Party in non - English territories"^^xsd:string .

ns1:EALosAngeles a owl:NamedIndividual,
        ns1:Organization ;
    rdfs:label "EA Los Angeles"^^xsd:string .

ns1:Europe a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "Europe"^^xsd:string .

ns1:January28_2009 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "28 January 2009"^^xsd:string .

ns1:May19_2009 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "19 May 2009"^^xsd:string .

ns1:May29_2009 a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "29 May 2009"^^xsd:string .

ns1:NorthAmerica a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "North America"^^xsd:string .

ns1:PhysicsBasedPuzzleVideoGame a owl:Class ;
    rdfs:subClassOf ns1:PuzzleVideoGame .

ns1:PuzzleVideoGame a owl:Class ;
    rdfs:subClassOf ns1:VideoGame .

ns1:ShootingMode a owl:NamedIndividual,
        ns1:GameMode ;
    rdfs:label "shooting mode"^^xsd:string .

ns1:WiiVideoGameConsole a owl:NamedIndividual,
        ns1:GameConsole ;
    rdfs:label "Wii video game console"^^xsd:string .

ns1:GameConsole a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:GameMode a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:StevenSpielberg a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Steven Spielberg"^^xsd:string .

ns1:Title a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:BoomBlox a owl:NamedIndividual,
        ns1:VideoGame ;
    rdfs:label "Boom Blox"^^xsd:string .

ns1:ElectronicArts a owl:NamedIndividual,
        ns1:Organization ;
    rdfs:label "EA"^^xsd:string,
        "Electronic Arts"^^xsd:string .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Region a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:DatePoint a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VideoGame a owl:Class ;
    rdfs:subClassOf owl:Thing .