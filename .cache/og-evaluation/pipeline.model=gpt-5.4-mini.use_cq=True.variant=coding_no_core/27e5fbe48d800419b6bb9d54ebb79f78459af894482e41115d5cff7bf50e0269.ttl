@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:JoosVanCleve a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Joos van Cleve"^^xsd:string ;
    ns1:activeDuring "around 1511 to 1540"^^xsd:string ;
    ns1:activeIn ns1:Antwerp ;
    ns1:alsoKnownAs ns1:JoosVanDerBeke ;
    ns1:born "c. 1485"^^xsd:string ;
    ns1:combinesTechnique ns1:TraditionalNetherlandishPaintingTechniques ;
    ns1:died "1540/1541"^^xsd:string ;
    ns1:hasChild ns1:CornelisVanCleve ;
    ns1:hasQuality ns1:SensitivityToColor,
        ns1:UniqueSolidarityOfFigures ;
    ns1:heldRole ns1:CoDeaconRole ;
    ns1:influencedByStyle ns1:ContemporaryRenaissancePaintingStyles ;
    ns1:introducedInnovation ns1:BroadLandscapesInTheBackgroundsOfHisPaintings ;
    ns1:knownFor ns1:PortraitsOfRoyalty,
        ns1:ReligiousWorks ;
    ns1:memberOf ns1:GuildOfSaintLukeOfAntwerp .

ns1:activeDuring a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:activeIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:alsoKnownAs a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Appellation .

ns1:born a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:combinesTechnique a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:PaintingTechnique .

ns1:died a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:hasChild a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Person .

ns1:hasQuality a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ArtisticQuality .

ns1:heldRole a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:GuildRole .

ns1:influencedByStyle a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:PaintingStyle .

ns1:influencedTradition a owl:ObjectProperty ;
    rdfs:domain ns1:Innovation ;
    rdfs:range ns1:PaintingTradition .

ns1:introducedInnovation a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Innovation .

ns1:knownFor a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ArtworkType .

ns1:memberOf a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Guild .

ns1:nicknameMeaning a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Nickname ;
    rdfs:range xsd:string .

ns1:nicknameReason a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:residedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Country .

ns1:Alias a owl:Class ;
    rdfs:subClassOf ns1:Appellation .

ns1:Antwerp a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Antwerp"^^xsd:string .

ns1:BroadLandscapesInTheBackgroundsOfHisPaintings a owl:NamedIndividual,
        ns1:Innovation ;
    rdfs:label "broad landscapes in the backgrounds of his paintings"^^xsd:string ;
    ns1:influencedTradition ns1:SixteenthCenturyNorthernRenaissancePaintings .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:CoDeaconRole a owl:NamedIndividual,
        ns1:GuildRole ;
    rdfs:label "co-deacon"^^xsd:string .

ns1:ContemporaryRenaissancePaintingStyles a owl:NamedIndividual,
        ns1:PaintingStyle ;
    rdfs:label "more contemporary Renaissance painting styles"^^xsd:string .

ns1:CornelisVanCleve a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Cornelis van Cleve"^^xsd:string ;
    ns1:alsoKnownAs ns1:SotteCleef ;
    ns1:born "1520"^^xsd:string ;
    ns1:died "1567"^^xsd:string ;
    ns1:nicknameReason "became mentally ill during a residence in England"^^xsd:string ;
    ns1:residedIn ns1:England .

ns1:England a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "England"^^xsd:string .

ns1:GuildOfSaintLukeOfAntwerp a owl:NamedIndividual,
        ns1:Guild ;
    rdfs:label "Guild of Saint Luke of Antwerp"^^xsd:string .

ns1:JoosVanDerBeke a owl:NamedIndividual,
        ns1:Alias ;
    rdfs:label "Joos van der Beke"^^xsd:string .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PortraitsOfRoyalty a owl:NamedIndividual,
        ns1:ArtworkType ;
    rdfs:label "portraits of royalty"^^xsd:string .

ns1:ReligiousWorks a owl:NamedIndividual,
        ns1:ArtworkType ;
    rdfs:label "religious works"^^xsd:string .

ns1:SensitivityToColor a owl:NamedIndividual,
        ns1:ArtisticQuality ;
    rdfs:label "sensitivity to color"^^xsd:string .

ns1:SixteenthCenturyNorthernRenaissancePaintings a owl:NamedIndividual,
        ns1:PaintingTradition ;
    rdfs:label "sixteenth century northern Renaissance paintings"^^xsd:string .

ns1:SotteCleef a owl:NamedIndividual,
        ns1:Nickname ;
    rdfs:label "Sotte Cleef"^^xsd:string ;
    ns1:nicknameMeaning "mad Cleef"^^xsd:string .

ns1:TraditionalNetherlandishPaintingTechniques a owl:NamedIndividual,
        ns1:PaintingTechnique ;
    rdfs:label "traditional Netherlandish painting techniques"^^xsd:string .

ns1:UniqueSolidarityOfFigures a owl:NamedIndividual,
        ns1:ArtisticQuality ;
    rdfs:label "unique solidarity of figures"^^xsd:string .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Guild a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:GuildRole a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:Nickname a owl:Class ;
    rdfs:subClassOf ns1:Appellation .

ns1:Painter a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:PaintingStyle a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:PaintingTechnique a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:PaintingTradition a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:Appellation a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ArtisticQuality a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:ArtworkType a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:Innovation a owl:Class ;
    rdfs:subClassOf ns1:ArtisticConcept .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ArtisticConcept a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .