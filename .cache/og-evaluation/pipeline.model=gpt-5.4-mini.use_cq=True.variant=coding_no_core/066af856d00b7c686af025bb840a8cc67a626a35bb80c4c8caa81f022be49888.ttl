@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Bank a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Boutique a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Cafe a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:HeritageBuilding a owl:Class ;
    rdfs:subClassOf ns1:Building .

ns1:InsuranceCompany a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:MostPrestigiousOfficeBlocksAndSkyscrapers a owl:NamedIndividual,
        ns1:Collection ;
    rdfs:label "the most prestigious office blocks and skyscrapers"^^xsd:string ;
    ns1:foundAlong ns1:CollinsStreet .

ns1:OfficeBlock a owl:Class ;
    rdfs:subClassOf ns1:Building .

ns1:Skyscraper a owl:Class ;
    rdfs:subClassOf ns1:Building .

ns1:StreetTree a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:becameFinancialHeartOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:BlockArea ;
    rdfs:range ns1:City .

ns1:centeredAround a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:BlockArea ;
    rdfs:range ns1:Street .

ns1:colloquiallyKnownAs a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range ns1:Nickname .

ns1:createdYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:SurveyPlan ;
    rdfs:range xsd:integer .

ns1:dueToFeature a owl:ObjectProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range ns1:Collection .

ns1:establishedYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Settlement ;
    rdfs:range xsd:integer .

ns1:firstLocationFor a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range ns1:Collection .

ns1:foundAlong a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Collection ;
    rdfs:range ns1:Street .

ns1:foundAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Collection ;
    rdfs:range ns1:Location .

ns1:helpedEstablish a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Settlement .

ns1:inCentreOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:City .

ns1:knownSince a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range xsd:string .

ns1:laidOutIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:SurveyPlan .

ns1:locatedAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Settlement ;
    rdfs:range ns1:Location .

ns1:locatedInCity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Location ;
    rdfs:range ns1:City .

ns1:locatedInCountry a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Location ;
    rdfs:range ns1:Country .

ns1:locatedInState a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Location ;
    rdfs:range ns1:State .

ns1:namedAfter a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Street ;
    rdfs:range ns1:Person .

ns1:partOfStreet a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:StreetSection ;
    rdfs:range ns1:Street .

ns1:preferredHomeOf a owl:ObjectProperty ;
    rdfs:domain ns1:BlockArea ;
    rdfs:range ns1:Collection .

ns1:sinceCentury a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:BlockArea ;
    rdfs:range xsd:string .

ns1:surveyedCity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:SurveyPlan ;
    rdfs:range ns1:City .

ns1:BlocksFurtherWestAroundQueenStreet a owl:NamedIndividual,
        ns1:BlockArea ;
    rdfs:label "Blocks further west centred around Queen Street"^^xsd:string ;
    ns1:becameFinancialHeartOf ns1:Melbourne ;
    ns1:centeredAround ns1:QueenStreet ;
    ns1:partOfStreet ns1:CollinsStreet ;
    ns1:preferredHomeOf ns1:MajorBanksAndInsuranceCompanies ;
    ns1:sinceCentury "19th century"^^xsd:string .

ns1:DavidCollins a owl:NamedIndividual,
        ns1:LieutenantGovernor ;
    rdfs:label "Lieutenant-Governor David Collins"^^xsd:string ;
    ns1:helpedEstablish ns1:ShortLivedSettlementAtSorrento .

ns1:HighEndShoppingBoutiques a owl:NamedIndividual,
        ns1:Collection ;
    rdfs:label "high-end shopping boutiques"^^xsd:string ;
    ns1:foundAt ns1:CollinsStreetEasternEnd .

ns1:HoddleGridOriginal1837 a owl:NamedIndividual,
        ns1:SurveyPlan ;
    rdfs:label "the original 1837 Hoddle Grid"^^xsd:string ;
    ns1:createdYear 1837 ;
    ns1:surveyedCity ns1:Melbourne .

ns1:LieutenantGovernor a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:MajorBanksAndInsuranceCompanies a owl:NamedIndividual,
        ns1:Collection ;
    rdfs:label "major banks and insurance companies"^^xsd:string ;
    ns1:foundAt ns1:BlocksFurtherWestAroundQueenStreet .

ns1:MajorStreet a owl:Class ;
    rdfs:subClassOf ns1:Street .

ns1:NumerousHeritageBuildings a owl:NamedIndividual,
        ns1:Collection ;
    rdfs:label "numerous heritage buildings"^^xsd:string ;
    ns1:foundAt ns1:CollinsStreetEasternEnd .

ns1:OldStreetTrees a owl:NamedIndividual,
        ns1:Collection ;
    rdfs:label "old street trees"^^xsd:string ;
    ns1:foundAt ns1:CollinsStreetEasternEnd .

ns1:ParisEnd a owl:NamedIndividual,
        ns1:Nickname ;
    rdfs:label "the ' Paris End '"^^xsd:string .

ns1:QueenStreet a owl:NamedIndividual,
        ns1:Street ;
    rdfs:label "Queen Street"^^xsd:string .

ns1:ShortLivedSettlementAtSorrento a owl:NamedIndividual,
        ns1:Settlement ;
    rdfs:label "a short-lived settlement at Sorrento"^^xsd:string ;
    ns1:establishedYear 1803 ;
    ns1:locatedAt ns1:Sorrento .

ns1:Sorrento a owl:NamedIndividual,
        ns1:Location ;
    rdfs:label "Sorrento"^^xsd:string .

ns1:Country a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:FirstSidewalkCafesInTheCity a owl:NamedIndividual,
        ns1:Collection ;
    rdfs:label "the first sidewalk cafes in the city"^^xsd:string ;
    ns1:foundAt ns1:CollinsStreetEasternEnd .

ns1:Nickname a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:State a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:Victoria a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "Victoria"^^xsd:string ;
    ns1:locatedInCountry ns1:Australia .

ns1:Australia a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Australia"^^xsd:string .

ns1:Building a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:CollinsStreet a owl:NamedIndividual,
        ns1:MajorStreet ;
    rdfs:label "Collins Street"^^xsd:string ;
    ns1:inCentreOf ns1:Melbourne ;
    ns1:laidOutIn ns1:HoddleGridOriginal1837 ;
    ns1:locatedInCity ns1:Melbourne ;
    ns1:locatedInCountry ns1:Australia ;
    ns1:locatedInState ns1:Victoria ;
    ns1:namedAfter ns1:DavidCollins .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:CollinsStreetEasternEnd a owl:NamedIndividual,
        ns1:StreetSection ;
    rdfs:label "the eastern end of Collins Street"^^xsd:string ;
    ns1:colloquiallyKnownAs ns1:ParisEnd ;
    ns1:dueToFeature ns1:FirstSidewalkCafesInTheCity,
        ns1:HighEndShoppingBoutiques,
        ns1:NumerousHeritageBuildings,
        ns1:OldStreetTrees ;
    ns1:firstLocationFor ns1:FirstSidewalkCafesInTheCity ;
    ns1:knownSince "the 1950s"^^xsd:string ;
    ns1:partOfStreet ns1:CollinsStreet .

ns1:Melbourne a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Melbourne"^^xsd:string ;
    ns1:locatedInCountry ns1:Australia ;
    ns1:locatedInState ns1:Victoria .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Settlement a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:SurveyPlan a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:BlockArea a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:StreetSection a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:Street a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:Collection a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Location a owl:Class ;
    rdfs:subClassOf owl:Thing .