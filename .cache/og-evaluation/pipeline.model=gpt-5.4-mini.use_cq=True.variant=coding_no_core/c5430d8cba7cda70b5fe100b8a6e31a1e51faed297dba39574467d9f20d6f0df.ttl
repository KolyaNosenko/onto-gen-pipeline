@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Hades a owl:NamedIndividual,
        ns1:MythologicalPlace ;
    rdfs:label "Hades"^^xsd:string .

ns1:MarissaNadler a owl:NamedIndividual,
        ns1:FineArtist,
        ns1:SingerSongwriter ;
    rdfs:label "Marissa Nadler"^^xsd:string ;
    ns1:activeSince ns1:Year2000 ;
    ns1:basedIn ns1:Boston,
        ns1:Massachusetts ;
    ns1:bornOn ns1:April51981 ;
    ns1:bostonGlobeDescription "She has a voice that, in mythological times, could have lured men to their deaths at sea, an intoxicating soprano drenched in gauzy reverb that hits bell - clear heights, lingers, and tapers off like rings of smoke"^^xsd:string ;
    ns1:bringsInElementsOf ns1:BlackMetal,
        ns1:Experimental ;
    ns1:describedAsTerm ns1:DreamFolk ;
    ns1:describedBy ns1:Pitchfork,
        ns1:TheBostonGlobe ;
    ns1:musicClassification "defies simple classification"^^xsd:string ;
    ns1:nationality ns1:American ;
    ns1:pitchforkDescription "textured and angelic, with just a hint of pain captured within her iridescent falsetto"^^xsd:string,
        "you would follow straight into Hades"^^xsd:string ;
    ns1:receivedAcclaimFor ns1:Vocals ;
    ns1:releasedAlbum ns1:Strangers ;
    ns1:rootedIn ns1:Folk,
        ns1:OldSchoolCountry ;
    ns1:signedTo ns1:BellaUnion,
        ns1:SacredBonesRecords ;
    ns1:singsIn ns1:MezzoSoprano .

ns1:activeSince a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Year .

ns1:basedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:bornOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:FullDate .

ns1:bostonGlobeDescription a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:bringsInElementsOf a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Genre .

ns1:describedAsTerm a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Style .

ns1:describedBy a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Publication .

ns1:musicClassification a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:nationality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Nationality .

ns1:pitchforkDescription a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string .

ns1:receivedAcclaimFor a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:ArtisticQuality .

ns1:releaseDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:MonthYear .

ns1:releasedAlbum a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Album .

ns1:rootedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Genre .

ns1:signedTo a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:RecordLabel .

ns1:singsIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:VocalRange .

ns1:American a owl:NamedIndividual,
        ns1:Nationality ;
    rdfs:label "American"^^xsd:string .

ns1:April51981 a owl:NamedIndividual,
        ns1:FullDate ;
    rdfs:label "April 5 , 1981"^^xsd:string .

ns1:BellaUnion a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Bella Union"^^xsd:string .

ns1:BlackMetal a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "black metal"^^xsd:string .

ns1:Boston a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Boston"^^xsd:string .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:DreamFolk a owl:NamedIndividual,
        ns1:Style ;
    rdfs:label "dream folk"^^xsd:string .

ns1:Experimental a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "experimental"^^xsd:string .

ns1:FineArtist a owl:Class ;
    rdfs:subClassOf ns1:Artist .

ns1:Folk a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "folk"^^xsd:string .

ns1:Massachusetts a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "Massachusetts"^^xsd:string .

ns1:May2016 a owl:NamedIndividual,
        ns1:MonthYear ;
    rdfs:label "May 2016"^^xsd:string .

ns1:MezzoSoprano a owl:NamedIndividual,
        ns1:VocalRange ;
    rdfs:label "mezzo - soprano"^^xsd:string .

ns1:Musician a owl:Class ;
    rdfs:subClassOf ns1:Artist .

ns1:MythologicalPlace a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:OldSchoolCountry a owl:NamedIndividual,
        ns1:Genre ;
    rdfs:label "old - school country"^^xsd:string .

ns1:Pitchfork a owl:NamedIndividual,
        ns1:Publication ;
    rdfs:label "Pitchfork"^^xsd:string .

ns1:SacredBonesRecords a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Sacred Bones Records"^^xsd:string .

ns1:SingerSongwriter a owl:Class ;
    rdfs:subClassOf ns1:Musician .

ns1:State a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:Strangers a owl:NamedIndividual,
        ns1:StudioAlbum ;
    rdfs:label "Strangers"^^xsd:string ;
    ns1:releaseDate ns1:May2016 .

ns1:StudioAlbum a owl:Class ;
    rdfs:subClassOf ns1:Album .

ns1:TheBostonGlobe a owl:NamedIndividual,
        ns1:Publication ;
    rdfs:label "The Boston Globe"^^xsd:string .

ns1:Vocals a owl:NamedIndividual,
        ns1:ArtisticQuality ;
    rdfs:label "vocals"^^xsd:string .

ns1:Year2000 a owl:NamedIndividual,
        ns1:Year ;
    rdfs:label "2000"^^xsd:string .

ns1:Artist a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:ArtisticQuality a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:FullDate a owl:Class ;
    rdfs:subClassOf ns1:TimeMention .

ns1:MonthYear a owl:Class ;
    rdfs:subClassOf ns1:TimeMention .

ns1:Nationality a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Style a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VocalRange a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Year a owl:Class ;
    rdfs:subClassOf ns1:TimeMention .

ns1:Album a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Publication a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:RecordLabel a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:TimeMention a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Genre a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .