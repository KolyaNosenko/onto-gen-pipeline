@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:TheTimeBenderSong a owl:NamedIndividual,
        ns1:Single ;
    rdfs:label "The Time Bender"^^xsd:string ;
    ns1:accompaniedBy ns1:LyricVideoMedia,
        ns1:OfficialVideoMedia ;
    ns1:promotesAlbum ns1:IAmAlbum ;
    ns1:releasedOnDate ns1:August28_2012Date .

ns1:accompaniedBy a owl:ObjectProperty ;
    rdfs:domain ns1:Single ;
    rdfs:range ns1:PromotionalVideo .

ns1:dateValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:DatePoint ;
    rdfs:range xsd:date .

ns1:featuresPerson a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Person .

ns1:hasDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:hasMusicalElement a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:MusicalElement .

ns1:hasRole a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Role .

ns1:isOriginalMemberOfBand a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Band .

ns1:lacksMusicalElement a owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:MusicalElement .

ns1:previousEffort a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Album .

ns1:promotesAlbum a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Single ;
    rdfs:range ns1:Album .

ns1:recordedByBand a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:Band .

ns1:recordedEndDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:DatePoint .

ns1:recordedStartDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:DatePoint .

ns1:releasedOnDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:DatePoint .

ns1:releasedThroughLabel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Album ;
    rdfs:range ns1:RecordLabel .

ns1:studioAlbumOrdinal a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:StudioAlbum ;
    rdfs:range xsd:integer .

ns1:August28_2012Date a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "August 28 , 2012"^^xsd:string ;
    ns1:dateValue "2012-08-28"^^xsd:date .

ns1:BassRole a owl:NamedIndividual,
        ns1:Role ;
    rdfs:label "bass"^^xsd:string .

ns1:CelestialCompletionAlbum a owl:NamedIndividual,
        ns1:StudioAlbum ;
    rdfs:label "Celestial Completion"^^xsd:string ;
    ns1:hasMusicalElement ns1:HornsElement,
        ns1:SitarsElement .

ns1:ChrisHeatonPerson a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Chris Heaton"^^xsd:string ;
    ns1:hasRole ns1:DrumsRole .

ns1:ChrisMcCanePerson a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Chris McCane"^^xsd:string ;
    ns1:hasRole ns1:VocalsRole .

ns1:CodeyWatkinsPerson a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Codey Watkins"^^xsd:string ;
    ns1:hasRole ns1:BassRole .

ns1:DrumsRole a owl:NamedIndividual,
        ns1:Role ;
    rdfs:label "drums"^^xsd:string .

ns1:GuitaristVocalistRole a owl:NamedIndividual,
        ns1:Role ;
    rdfs:label "Guitarist / vocalist"^^xsd:string .

ns1:IAmAlbum a owl:NamedIndividual,
        ns1:StudioAlbum ;
    rdfs:label "I Am"^^xsd:string ;
    ns1:featuresPerson ns1:ChrisHeatonPerson,
        ns1:ChrisMcCanePerson,
        ns1:CodeyWatkinsPerson,
        ns1:SethHecoxPerson ;
    ns1:hasDescription "gone are the sitars and horns of Celestial Completion. Instead, we've crafted an album full of the heaviest and most technical songs we've ever written."^^xsd:string ;
    ns1:lacksMusicalElement ns1:HornsElement,
        ns1:SitarsElement ;
    ns1:previousEffort ns1:CelestialCompletionAlbum ;
    ns1:recordedByBand ns1:BecomingTheArchetypeBand ;
    ns1:recordedEndDate ns1:June17Date ;
    ns1:recordedStartDate ns1:May21Date ;
    ns1:releasedOnDate ns1:September18_2012Date ;
    ns1:releasedThroughLabel ns1:SolidStateRecordsLabel ;
    ns1:studioAlbumOrdinal 5 .

ns1:June17Date a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "June 17"^^xsd:string ;
    ns1:dateValue "2012-06-17"^^xsd:date .

ns1:LyricVideoMedia a owl:NamedIndividual,
        ns1:PromotionalVideo ;
    rdfs:label "lyric video"^^xsd:string .

ns1:May21Date a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "May 21"^^xsd:string ;
    ns1:dateValue "2012-05-21"^^xsd:date .

ns1:OfficialVideoMedia a owl:NamedIndividual,
        ns1:PromotionalVideo ;
    rdfs:label "official video"^^xsd:string .

ns1:September18_2012Date a owl:NamedIndividual,
        ns1:DatePoint ;
    rdfs:label "September 18 , 2012"^^xsd:string ;
    ns1:dateValue "2012-09-18"^^xsd:date .

ns1:SethHecoxPerson a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Seth Hecox"^^xsd:string ;
    ns1:hasRole ns1:GuitaristVocalistRole ;
    ns1:isOriginalMemberOfBand ns1:BecomingTheArchetypeBand .

ns1:SolidStateRecordsLabel a owl:NamedIndividual,
        ns1:RecordLabel ;
    rdfs:label "Solid State Records"^^xsd:string .

ns1:Song a owl:Class ;
    rdfs:subClassOf ns1:MusicalWork .

ns1:Video a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VocalsRole a owl:NamedIndividual,
        ns1:Role ;
    rdfs:label "vocals"^^xsd:string .

ns1:BecomingTheArchetypeBand a owl:NamedIndividual,
        ns1:Band ;
    rdfs:label "Becoming the Archetype"^^xsd:string .

ns1:HornsElement a owl:NamedIndividual,
        ns1:MusicalElement ;
    rdfs:label "horns"^^xsd:string .

ns1:MusicalWork a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:RecordLabel a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:SitarsElement a owl:NamedIndividual,
        ns1:MusicalElement ;
    rdfs:label "sitars"^^xsd:string .

ns1:Band a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:PromotionalVideo a owl:Class ;
    rdfs:subClassOf ns1:Video .

ns1:Single a owl:Class ;
    rdfs:subClassOf ns1:Song .

ns1:StudioAlbum a owl:Class ;
    rdfs:subClassOf ns1:Album .

ns1:MusicalElement a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Role a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:DatePoint a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Album a owl:Class ;
    rdfs:subClassOf ns1:MusicalWork .