@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:JoosVanCleve a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Joos van Cleve"^^xsd:string,
        "Joos van der Beke"^^xsd:string ;
    ns1:activeFrom 1511 ;
    ns1:activeIn ns1:Antwerp ;
    ns1:activeTo 1540 ;
    ns1:birthYear 1485 ;
    ns1:combinedStyles ns1:RenaissancePainting ;
    ns1:combinedTechniques ns1:NetherlandishTechnique ;
    ns1:hasArtisticQuality "sensitivity to color"^^xsd:string,
        "unique solidarity of figures"^^xsd:string ;
    ns1:hasChild ns1:CornelisVanCleve ;
    ns1:hasRoleIn ns1:CoDeaconRole ;
    ns1:introduced "broad landscapes in backgrounds of paintings"^^xsd:string ;
    ns1:memberOf ns1:GuildOfSaintLukeOfAntwerp ;
    ns1:paintsPrimaryly ns1:ReligiousWorks,
        ns1:RoyaltyPortraits .

ns1:activeFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:integer .

ns1:activeIn a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Place .

ns1:activeTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:integer .

ns1:becameMentallyIll a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:boolean .

ns1:birthYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:integer .

ns1:combinedStyles a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingStyle .

ns1:combinedTechniques a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:PaintingTechnique .

ns1:deathYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:integer .

ns1:hasArtisticQuality a owl:DatatypeProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:string .

ns1:hasChild a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Painter .

ns1:hasRoleIn a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Role .

ns1:introduced a owl:DatatypeProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range xsd:string .

ns1:memberOf a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Guild .

ns1:paintsPrimaryly a owl:ObjectProperty ;
    rdfs:domain ns1:Painter ;
    rdfs:range ns1:Subject .

ns1:residedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:CoDeacon a owl:Class ;
    rdfs:subClassOf ns1:Role .

ns1:CoDeaconRole a owl:NamedIndividual,
        ns1:CoDeacon ;
    rdfs:label "Co-Deacon"^^xsd:string .

ns1:CornelisVanCleve a owl:NamedIndividual,
        ns1:Painter ;
    rdfs:label "Cornelis van Cleve"^^xsd:string,
        "Sotte Cleef"^^xsd:string ;
    ns1:activeIn ns1:Antwerp ;
    ns1:becameMentallyIll true ;
    ns1:birthYear 1520 ;
    ns1:deathYear 1567 ;
    ns1:residedIn ns1:England .

ns1:England a owl:NamedIndividual,
        ns1:Place ;
    rdfs:label "England"^^xsd:string .

ns1:GuildOfSaintLukeOfAntwerp a owl:NamedIndividual,
        ns1:Guild ;
    rdfs:label "Guild of Saint Luke of Antwerp"^^xsd:string .

ns1:NetherlandishTechnique a owl:NamedIndividual,
        ns1:PaintingTechnique ;
    rdfs:label "Netherlandish painting techniques"^^xsd:string .

ns1:ReligiousWorks a owl:NamedIndividual,
        ns1:Subject ;
    rdfs:label "Religious works"^^xsd:string .

ns1:RenaissancePainting a owl:NamedIndividual,
        ns1:PaintingStyle ;
    rdfs:label "Renaissance painting styles"^^xsd:string .

ns1:RoyaltyPortraits a owl:NamedIndividual,
        ns1:Subject ;
    rdfs:label "Portraits of royalty"^^xsd:string .

ns1:Antwerp a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Antwerp"^^xsd:string .

ns1:Guild a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PaintingStyle a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PaintingTechnique a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Role a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Subject a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Painter a owl:Class ;
    rdfs:subClassOf ns1:Person .