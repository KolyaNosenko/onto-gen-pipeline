@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:ClimateChange_instance a owl:NamedIndividual,
        ns1:ClimateChange ;
    rdfs:label "climate change"^^xsd:string ;
    ns1:affects ns1:Germany ;
    ns1:causes ns1:AgriculturalImpact_instance,
        ns1:CoastalFloodingImpact_instance,
        ns1:ColdWaveImpact_instance,
        ns1:FlashFloodingImpact_instance,
        ns1:HeatWaveImpact_instance,
        ns1:WaterAvailabilityImpact_instance ;
    ns1:sparksEnergyTransition ns1:Energiewende .

ns1:Poland a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Poland"^^xsd:string .

ns1:affects a owl:ObjectProperty ;
    rdfs:domain ns1:ClimateChange ;
    rdfs:range ns1:Country .

ns1:causes a owl:ObjectProperty ;
    rdfs:domain ns1:ClimateChange ;
    rdfs:range ns1:ClimateImpact .

ns1:coalProductionGlobalPercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Country ;
    rdfs:range xsd:decimal .

ns1:coalProductionRankInEU a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Country ;
    rdfs:range xsd:integer .

ns1:demonstrates a owl:ObjectProperty ;
    rdfs:domain ns1:Delegation ;
    rdfs:range ns1:CommitmentToCarbonNeutrality .

ns1:hasLeader a owl:ObjectProperty ;
    rdfs:domain ns1:PoliticalParty ;
    rdfs:range ns1:Person .

ns1:hosted a owl:ObjectProperty ;
    rdfs:domain ns1:Country ;
    rdfs:range ns1:Conference .

ns1:importsCoal a owl:ObjectProperty ;
    rdfs:domain ns1:Country ;
    rdfs:range ns1:CoalImport .

ns1:investedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Country ;
    rdfs:range ns1:RenewableEnergyInvestment .

ns1:involves a owl:ObjectProperty ;
    rdfs:domain ns1:Conference ;
    rdfs:range ns1:Delegation .

ns1:isPoliticalIssueFor a owl:ObjectProperty ;
    rdfs:domain ns1:EnergyTransition ;
    rdfs:range ns1:Country .

ns1:locatedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Conference ;
    rdfs:range ns1:Location .

ns1:makesCoalitionTalksDifficult a owl:ObjectProperty ;
    rdfs:domain ns1:EnergyTransition ;
    rdfs:range ns1:PoliticalParty .

ns1:sparksEnergyTransition a owl:ObjectProperty ;
    rdfs:domain ns1:ClimateChange ;
    rdfs:range ns1:EnergyTransition .

ns1:traveledUsing a owl:ObjectProperty ;
    rdfs:domain ns1:Delegation ;
    rdfs:range ns1:Transport .

ns1:AgriculturalImpact a owl:Class ;
    rdfs:subClassOf ns1:ClimateImpact .

ns1:AgriculturalImpact_instance a owl:NamedIndividual,
        ns1:AgriculturalImpact .

ns1:AngelaMerkel a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Angela Merkel"^^xsd:string .

ns1:Bonn a owl:NamedIndividual,
        ns1:Location ;
    rdfs:label "Bonn"^^xsd:string .

ns1:CDU a owl:NamedIndividual,
        ns1:PoliticalParty ;
    rdfs:label "CDU"^^xsd:string ;
    ns1:hasLeader ns1:AngelaMerkel .

ns1:COP23 a owl:NamedIndividual,
        ns1:Conference ;
    rdfs:label "COP23"^^xsd:string ;
    ns1:involves ns1:GermanDelegation ;
    ns1:locatedIn ns1:Bonn .

ns1:CarbonNeutralTrain a owl:NamedIndividual,
        ns1:CarbonNeutralTransport ;
    rdfs:label "carbon-neutral train"^^xsd:string .

ns1:CarbonNeutralTransport a owl:Class ;
    rdfs:subClassOf ns1:Transport .

ns1:CoalImport_instance a owl:NamedIndividual,
        ns1:CoalImport .

ns1:CoastalFloodingImpact a owl:Class ;
    rdfs:subClassOf ns1:FloodingImpact .

ns1:CoastalFloodingImpact_instance a owl:NamedIndividual,
        ns1:CoastalFloodingImpact .

ns1:ColdWaveImpact a owl:Class ;
    rdfs:subClassOf ns1:WeatherImpact .

ns1:ColdWaveImpact_instance a owl:NamedIndividual,
        ns1:ColdWaveImpact .

ns1:CommitmentToCarbonNeutrality_instance a owl:NamedIndividual,
        ns1:CommitmentToCarbonNeutrality ;
    rdfs:label "commitment to carbon neutrality"^^xsd:string .

ns1:Energiewende a owl:NamedIndividual,
        ns1:EnergyTransition ;
    rdfs:label "energiewende"^^xsd:string ;
    ns1:isPoliticalIssueFor ns1:Germany ;
    ns1:makesCoalitionTalksDifficult ns1:CDU .

ns1:FlashFloodingImpact a owl:Class ;
    rdfs:subClassOf ns1:FloodingImpact .

ns1:FlashFloodingImpact_instance a owl:NamedIndividual,
        ns1:FlashFloodingImpact .

ns1:GermanDelegation a owl:NamedIndividual,
        ns1:Delegation ;
    rdfs:label "German delegation"^^xsd:string ;
    ns1:demonstrates ns1:CommitmentToCarbonNeutrality_instance ;
    ns1:traveledUsing ns1:CarbonNeutralTrain .

ns1:HeatWaveImpact a owl:Class ;
    rdfs:subClassOf ns1:WeatherImpact .

ns1:HeatWaveImpact_instance a owl:NamedIndividual,
        ns1:HeatWaveImpact .

ns1:RenewableEnergyInvestment_instance a owl:NamedIndividual,
        ns1:RenewableEnergyInvestment .

ns1:WaterAvailabilityImpact a owl:Class ;
    rdfs:subClassOf ns1:ClimateImpact .

ns1:WaterAvailabilityImpact_instance a owl:NamedIndividual,
        ns1:WaterAvailabilityImpact .

ns1:CoalImport a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:CommitmentToCarbonNeutrality a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:FloodingImpact a owl:Class ;
    rdfs:subClassOf ns1:WeatherImpact .

ns1:Germany a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "Germany"^^xsd:string ;
    ns1:coalProductionGlobalPercentage 1.0 ;
    ns1:coalProductionRankInEU 2 ;
    ns1:hosted ns1:COP23 ;
    ns1:importsCoal ns1:CoalImport_instance ;
    ns1:investedIn ns1:RenewableEnergyInvestment_instance .

ns1:Location a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:RenewableEnergyInvestment a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Transport a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:PoliticalParty a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:WeatherImpact a owl:Class ;
    rdfs:subClassOf ns1:ClimateImpact .

ns1:ClimateChange a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ClimateImpact a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Conference a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Delegation a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:EnergyTransition a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Country a owl:Class ;
    rdfs:subClassOf owl:Thing .