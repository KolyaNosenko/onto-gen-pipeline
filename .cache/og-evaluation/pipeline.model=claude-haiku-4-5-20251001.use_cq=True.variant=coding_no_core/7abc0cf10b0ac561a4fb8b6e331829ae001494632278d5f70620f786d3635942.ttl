@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Artisan a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:ArtisticWatch a owl:Class ;
    rdfs:subClassOf ns1:Watch .

ns1:BovetFleurierSA a owl:NamedIndividual,
        ns1:WatchmakingCompany ;
    rdfs:label "Bovet Fleurier SA"^^xsd:string ;
    ns1:charterCountry ns1:UnitedKingdom ;
    ns1:currentOwner ns1:PascalRaffy ;
    ns1:currentProducts "Artistic Watches"^^xsd:string ;
    ns1:designInnovations "decorative movements"^^xsd:string,
        "second hand"^^xsd:string,
        "skeletonized views"^^xsd:string ;
    ns1:employmentPractices "tradition of employing women artisans"^^xsd:string ;
    ns1:foundedBy ns1:EdouardBovet ;
    ns1:foundedDate "May 1, 1822"^^xsd:string ;
    ns1:foundedIn ns1:London ;
    ns1:historicalProducts "Pocket Watches"^^xsd:string ;
    ns1:knownFeatures "decorative movements"^^xsd:string,
        "engraving"^^xsd:string,
        "high-quality dials"^^xsd:string,
        "second hand"^^xsd:string,
        "skeletonized views"^^xsd:string ;
    ns1:knownForDialModel ns1:FleurierMiniaturePaintingModels ;
    ns1:knownForMovement ns1:SevenDayTourbillon ;
    ns1:nationality "Swiss"^^xsd:string ;
    ns1:priceRange "US$ 18,000 to US$ 2.5 million"^^xsd:string ;
    ns1:servedMarket ns1:China ;
    ns1:styleDescription "references its history"^^xsd:string .

ns1:NineteenthCentury a owl:NamedIndividual,
        ns1:Era ;
    rdfs:label "19th century"^^xsd:string .

ns1:PocketWatch a owl:Class ;
    rdfs:subClassOf ns1:Watch .

ns1:charterCountry a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:Country .

ns1:currentOwner a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:Person .

ns1:currentProducts a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:designInnovations a owl:DatatypeProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:employmentPractices a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:employs a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:Person .

ns1:foundedBy a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:Person .

ns1:foundedDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:foundedIn a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:City .

ns1:historicalProducts a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:knownFeatures a owl:DatatypeProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:knownForDialModel a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:DialModel .

ns1:knownForMovement a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:MovementType .

ns1:nationality a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:priceRange a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:servedMarket a owl:ObjectProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range ns1:Country .

ns1:styleDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:WatchmakingCompany ;
    rdfs:range xsd:string .

ns1:China a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "China"^^xsd:string .

ns1:EdouardBovet a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Édouard Bovet"^^xsd:string .

ns1:Era a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:FleurierMiniaturePaintingModels a owl:NamedIndividual,
        ns1:DialModel ;
    rdfs:label "Fleurier Miniature Painting models"^^xsd:string .

ns1:London a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "London"^^xsd:string .

ns1:PascalRaffy a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Pascal Raffy"^^xsd:string .

ns1:SevenDayTourbillon a owl:NamedIndividual,
        ns1:MovementType ;
    rdfs:label "seven-day tourbillon"^^xsd:string .

ns1:UnitedKingdom a owl:NamedIndividual,
        ns1:Country ;
    rdfs:label "U.K."^^xsd:string .

ns1:City a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:DialModel a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:MovementType a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Watch a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Country a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:WatchmakingCompany a owl:Class ;
    rdfs:subClassOf owl:Thing .