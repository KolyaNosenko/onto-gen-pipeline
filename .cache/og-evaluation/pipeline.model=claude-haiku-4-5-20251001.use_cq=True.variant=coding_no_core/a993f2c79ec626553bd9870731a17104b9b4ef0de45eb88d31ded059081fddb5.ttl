@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:BritishSkyBroadcasting a owl:NamedIndividual,
        ns1:Organization ;
    rdfs:label "British Sky Broadcasting"^^xsd:string,
        "SKY"^^xsd:string ;
    ns1:holdsUKTVRights ns1:OdeonSkyFilmworks ;
    ns1:operatesIn ns1:UnitedKingdom ;
    ns1:partnerInJointVenture ns1:OdeonSkyFilmworks .

ns1:OdeonCinemas a owl:NamedIndividual,
        ns1:Organization ;
    rdfs:label "ODEON"^^xsd:string,
        "Odeon Cinemas"^^xsd:string ;
    ns1:partnerInJointVenture ns1:OdeonSkyFilmworks .

ns1:OdeonDirect a owl:NamedIndividual,
        ns1:DistributionChannel ;
    rdfs:label "ODEON Direct"^^xsd:string .

ns1:SkyMoviesByBroadband a owl:NamedIndividual,
        ns1:TVService ;
    rdfs:label "Sky Movies By Broadband"^^xsd:string ;
    ns1:precedes ns1:SkyBoxOffice .

ns1:availableThrough a owl:ObjectProperty ;
    rdfs:domain ns1:Film ;
    rdfs:range ns1:DistributionChannel .

ns1:filmsPerYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:JointVenture ;
    rdfs:range xsd:integer .

ns1:holdsUKTVRights a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:JointVenture .

ns1:makesAvailable a owl:ObjectProperty ;
    rdfs:domain ns1:TVService ;
    rdfs:range ns1:Film .

ns1:operatesIn a owl:ObjectProperty ;
    rdfs:domain ns1:Organization,
        ns1:TVService ;
    rdfs:range ns1:Territory .

ns1:partnerInJointVenture a owl:ObjectProperty ;
    rdfs:domain ns1:Organization ;
    rdfs:range ns1:JointVenture .

ns1:precedes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:DistributionChannel ;
    rdfs:range ns1:DistributionChannel .

ns1:releasedAt a owl:ObjectProperty ;
    rdfs:domain ns1:Film ;
    rdfs:range ns1:Venue .

ns1:signsFilmsFrom a owl:ObjectProperty ;
    rdfs:domain ns1:JointVenture ;
    rdfs:range ns1:Filmmaker .

ns1:Filmmaker a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:SkyBoxOffice a owl:NamedIndividual,
        ns1:TVService ;
    rdfs:label "Sky Box Office"^^xsd:string ;
    ns1:precedes ns1:SkyMovies .

ns1:SkyMovies a owl:NamedIndividual,
        ns1:TVService ;
    rdfs:label "Sky Movies"^^xsd:string .

ns1:Venue a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Territory a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:UnitedKingdom a owl:NamedIndividual,
        ns1:Territory ;
    rdfs:label "UK"^^xsd:string .

ns1:Film a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:OdeonSkyFilmworks a owl:NamedIndividual,
        ns1:JointVenture ;
    rdfs:label "FILMWORKS"^^xsd:string,
        "Odeon Sky Filmworks"^^xsd:string,
        "Odeon and Sky Filmworks"^^xsd:string ;
    ns1:filmsPerYear 6 ;
    ns1:operatesIn ns1:UnitedKingdom .

ns1:DistributionChannel a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:JointVenture a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:TVService a owl:Class ;
    rdfs:subClassOf ns1:DistributionChannel .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .