@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:AllanCunningham a owl:NamedIndividual,
        ns1:Explorer ;
    rdfs:label "Allan Cunningham"^^xsd:string ;
    ns1:visited ns1:Southwood .

ns1:Brisbane a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Brisbane"^^xsd:string .

ns1:CypressPine a owl:NamedIndividual,
        ns1:PlantSpecies ;
    rdfs:label "Cypress pine"^^xsd:string ;
    ns1:growsIn ns1:Southwood .

ns1:FalseSandalwood a owl:NamedIndividual,
        ns1:PlantSpecies ;
    rdfs:label "false sandalwood"^^xsd:string ;
    ns1:growsIn ns1:Southwood .

ns1:Gilgai a owl:NamedIndividual,
        ns1:GeologicalFeature ;
    rdfs:label "gilgais"^^xsd:string ;
    ns1:formedBy "constant wetting and drying"^^xsd:string ;
    ns1:foundIn ns1:Southwood .

ns1:PoplarBox a owl:NamedIndividual,
        ns1:PlantSpecies ;
    rdfs:label "poplar box"^^xsd:string ;
    ns1:growsIn ns1:Southwood .

ns1:ThomasMitchell a owl:NamedIndividual,
        ns1:Explorer ;
    rdfs:label "Thomas Mitchell"^^xsd:string ;
    ns1:visited ns1:Southwood .

ns1:WesternTeatree a owl:NamedIndividual,
        ns1:PlantSpecies ;
    rdfs:label "western teatree"^^xsd:string ;
    ns1:growsIn ns1:Southwood .

ns1:WilgaBush a owl:NamedIndividual,
        ns1:PlantSpecies ;
    rdfs:label "wilga bush"^^xsd:string ;
    ns1:growsIn ns1:Southwood .

ns1:WongaPigeon a owl:NamedIndividual,
        ns1:BirdSpecies ;
    rdfs:label "wonga pigeon"^^xsd:string ;
    ns1:hasRangeLimitAt ns1:Southwood .

ns1:becameNationalParkYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:NationalPark ;
    rdfs:range xsd:integer .

ns1:conservesVegetationType a owl:ObjectProperty ;
    rdfs:domain ns1:NationalPark ;
    rdfs:range ns1:VegetationType .

ns1:distanceFromBrisbane a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:NationalPark ;
    rdfs:range xsd:integer .

ns1:formedBy a owl:DatatypeProperty ;
    rdfs:domain ns1:GeologicalFeature ;
    rdfs:range xsd:string .

ns1:foundIn a owl:ObjectProperty ;
    rdfs:domain ns1:GeologicalFeature ;
    rdfs:range ns1:Place .

ns1:growsIn a owl:ObjectProperty ;
    rdfs:domain ns1:PlantSpecies ;
    rdfs:range ns1:Place .

ns1:hasRangeLimitAt a owl:ObjectProperty ;
    rdfs:domain ns1:BirdSpecies ;
    rdfs:range ns1:Place .

ns1:hasSoilType a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:SoilType .

ns1:inhabitedBy a owl:ObjectProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:IndigenousPeople .

ns1:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:Place ;
    rdfs:range ns1:Place .

ns1:previousName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:NationalPark ;
    rdfs:range xsd:string .

ns1:recordedBirdSpeciesCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:NationalPark ;
    rdfs:range xsd:integer .

ns1:visited a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Place .

ns1:Australia a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "Australia"^^xsd:string .

ns1:BigambulPeople a owl:NamedIndividual,
        ns1:IndigenousPeople ;
    rdfs:label "Bigambul people"^^xsd:string .

ns1:BrigalowBelahForest a owl:NamedIndividual,
        ns1:VegetationType ;
    rdfs:label "Brigalow - belah forest remnants"^^xsd:string .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:DarlingDowns a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "Darling Downs"^^xsd:string ;
    ns1:locatedIn ns1:Queensland .

ns1:HeavyClayLoils a owl:NamedIndividual,
        ns1:SoilType ;
    rdfs:label "heavy clay soils"^^xsd:string .

ns1:Queensland a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "Queensland"^^xsd:string ;
    ns1:locatedIn ns1:Australia .

ns1:BirdSpecies a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Explorer a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:IndigenousPeople a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:SoilType a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VegetationType a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:GeologicalFeature a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Region a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:NationalPark a owl:Class ;
    rdfs:subClassOf ns1:Place .

ns1:PlantSpecies a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Southwood a owl:NamedIndividual,
        ns1:NationalPark ;
    rdfs:label "Southwood"^^xsd:string ;
    ns1:becameNationalParkYear 1970 ;
    ns1:conservesVegetationType ns1:BrigalowBelahForest ;
    ns1:distanceFromBrisbane 288 ;
    ns1:hasSoilType ns1:HeavyClayLoils ;
    ns1:inhabitedBy ns1:BigambulPeople ;
    ns1:locatedIn ns1:DarlingDowns ;
    ns1:previousName "Wild Horse Paradise"^^xsd:string ;
    ns1:recordedBirdSpeciesCount 92 .

ns1:Place a owl:Class ;
    rdfs:subClassOf owl:Thing .