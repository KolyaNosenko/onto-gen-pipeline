@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:BoomBloxBashParty a owl:NamedIndividual,
        ns1:VideoGame ;
    rdfs:label "Boom Blox Bash Party"^^xsd:string,
        "Boom Blox Smash Party"^^xsd:string ;
    ns1:announcementDate "2009-01-28"^^xsd:date ;
    ns1:countsAsDealProperty false ;
    ns1:dealPropertyTargetCount 3 ;
    ns1:designedBy ns1:StevenSpielberg ;
    ns1:developedBy ns1:AmblinEntertainment,
        ns1:EALosAngeles ;
    ns1:hasLevelDownloadFeature true ;
    ns1:hasLevelUploadFeature true ;
    ns1:numberOfLevels 400 ;
    ns1:publishedBy ns1:ElectronicArts ;
    ns1:releaseDate "2009-05-19"^^xsd:date,
        "2009-05-29"^^xsd:date ;
    ns1:releasedForConsole ns1:Wii ;
    ns1:releasedInRegion ns1:Europe,
        ns1:NorthAmerica ;
    ns1:sequelOf ns1:BoomBlox ;
    ns1:serverShutdownDate "2012-04-01"^^xsd:date ;
    ns1:shootingModeEmphasisLevel "low"^^xsd:string .

ns1:announcementDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:date .

ns1:countsAsDealProperty a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:dealPropertyTargetCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:integer .

ns1:designedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Person .

ns1:developedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Company .

ns1:hasLevelDownloadFeature a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:hasLevelUploadFeature a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:boolean .

ns1:numberOfLevels a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:integer .

ns1:publishedBy a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Company .

ns1:releaseDate a owl:DatatypeProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:date .

ns1:releasedForConsole a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGameConsole .

ns1:releasedInRegion a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:Region .

ns1:sequelOf a owl:ObjectProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range ns1:VideoGame .

ns1:serverShutdownDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:date .

ns1:shootingModeEmphasisLevel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:VideoGame ;
    rdfs:range xsd:string .

ns1:AmblinEntertainment a owl:NamedIndividual,
        ns1:Company ;
    rdfs:label "Amblin Entertainment"^^xsd:string .

ns1:BoomBlox a owl:NamedIndividual,
        ns1:VideoGame ;
    rdfs:label "Boom Blox"^^xsd:string .

ns1:EALosAngeles a owl:NamedIndividual,
        ns1:Company ;
    rdfs:label "EA Los Angeles"^^xsd:string .

ns1:ElectronicArts a owl:NamedIndividual,
        ns1:Company ;
    rdfs:label "Electronic Arts"^^xsd:string .

ns1:Europe a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "Europe"^^xsd:string .

ns1:NorthAmerica a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "North America"^^xsd:string .

ns1:StevenSpielberg a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Steven Spielberg"^^xsd:string .

ns1:Wii a owl:NamedIndividual,
        ns1:VideoGameConsole ;
    rdfs:label "Wii"^^xsd:string .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VideoGameConsole a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Region a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Company a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:VideoGame a owl:Class ;
    rdfs:subClassOf owl:Thing .