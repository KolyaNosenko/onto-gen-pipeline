@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:BobGreenblatt a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Bob Greenblatt"^^xsd:string ;
    ns1:hasRole ns1:Chairman_inst .

ns1:MusicIndustry a owl:Class ;
    rdfs:subClassOf ns1:MediaField .

ns1:ProfessionalSports a owl:Class ;
    rdfs:subClassOf ns1:MediaField .

ns1:Radio a owl:Class ;
    rdfs:subClassOf ns1:MediaField .

ns1:RealityTelevision a owl:Class ;
    rdfs:subClassOf ns1:MediaField .

ns1:Sitcom a owl:Class ;
    rdfs:subClassOf ns1:MediaField .

ns1:TheCelebrityApprentice a owl:NamedIndividual,
        ns1:RealityCompetitionSeries ;
    rdfs:label "The Celebrity Apprentice"^^xsd:string ;
    ns1:cancelledDate "August 3, 2017"^^xsd:string ;
    ns1:hasHosting ns1:Hosting_Schwarzenegger,
        ns1:Hosting_Trump ;
    ns1:hasOpeningThemeSong ns1:ForTheLoveOfMoney ;
    ns1:isVariationOf ns1:TheApprentice ;
    ns1:seasonNumbers 7,
        8,
        9,
        11,
        12,
        13,
        14,
        15 .

ns1:cancelledDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:TelevisionSeries ;
    rdfs:range xsd:string .

ns1:competesFor a owl:ObjectProperty ;
    rdfs:domain ns1:Celebrity ;
    rdfs:range ns1:CharitableOrganization .

ns1:composedBy a owl:ObjectProperty ;
    rdfs:domain ns1:Song ;
    rdfs:range ns1:MusicGroup .

ns1:hasHosting a owl:ObjectProperty ;
    rdfs:domain ns1:TelevisionSeries ;
    rdfs:range ns1:Hosting .

ns1:hasMediaBackground a owl:ObjectProperty ;
    rdfs:domain ns1:Celebrity ;
    rdfs:range ns1:MediaField .

ns1:hasOpeningThemeSong a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:TelevisionSeries ;
    rdfs:range ns1:Song .

ns1:hasRole a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Role .

ns1:host a owl:ObjectProperty ;
    rdfs:domain ns1:Hosting ;
    rdfs:range ns1:Person .

ns1:hostingEndYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Hosting ;
    rdfs:range xsd:integer .

ns1:hostingStartYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Hosting ;
    rdfs:range xsd:integer .

ns1:isVariationOf a owl:ObjectProperty ;
    rdfs:domain ns1:TelevisionSeries ;
    rdfs:range ns1:TelevisionSeries .

ns1:seasonNumbers a owl:DatatypeProperty ;
    rdfs:domain ns1:TelevisionSeries ;
    rdfs:range xsd:integer .

ns1:Actor a owl:Class ;
    rdfs:subClassOf ns1:Role .

ns1:Actor_inst a owl:NamedIndividual,
        ns1:Actor ;
    rdfs:label "actor"^^xsd:string .

ns1:ArnoldSchwarzenegger a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Arnold Schwarzenegger"^^xsd:string ;
    ns1:hasRole ns1:Actor_inst,
        ns1:Governor_inst .

ns1:Chairman a owl:Class ;
    rdfs:subClassOf ns1:Role .

ns1:Chairman_inst a owl:NamedIndividual,
        ns1:Chairman ;
    rdfs:label "NBC Entertainment Chairman"^^xsd:string .

ns1:CharitableOrganization a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:DonaldTrump a owl:NamedIndividual,
        ns1:Person ;
    rdfs:label "Donald Trump"^^xsd:string ;
    ns1:hasRole ns1:President_inst,
        ns1:RealEstateDeveloper_inst .

ns1:Governor a owl:Class ;
    rdfs:subClassOf ns1:Role .

ns1:Governor_inst a owl:NamedIndividual,
        ns1:Governor ;
    rdfs:label "former California Governor"^^xsd:string .

ns1:Hosting_Schwarzenegger a owl:NamedIndividual,
        ns1:Hosting ;
    rdfs:label "Hosting by Arnold Schwarzenegger (January 2017)"^^xsd:string ;
    ns1:host ns1:ArnoldSchwarzenegger ;
    ns1:hostingStartYear 2017 .

ns1:Hosting_Trump a owl:NamedIndividual,
        ns1:Hosting ;
    rdfs:label "Hosting by Donald Trump (2008-2015)"^^xsd:string ;
    ns1:host ns1:DonaldTrump ;
    ns1:hostingEndYear 2015 ;
    ns1:hostingStartYear 2008 .

ns1:President a owl:Class ;
    rdfs:subClassOf ns1:Role .

ns1:President_inst a owl:NamedIndividual,
        ns1:President ;
    rdfs:label "U.S. President"^^xsd:string .

ns1:RealEstateDeveloper a owl:Class ;
    rdfs:subClassOf ns1:Role .

ns1:RealEstateDeveloper_inst a owl:NamedIndividual,
        ns1:RealEstateDeveloper ;
    rdfs:label "real estate developer"^^xsd:string .

ns1:RealityCompetitionSeries a owl:Class ;
    rdfs:subClassOf ns1:TelevisionSeries .

ns1:TheApprentice a owl:NamedIndividual,
        ns1:TelevisionSeries ;
    rdfs:label "The Apprentice"^^xsd:string ;
    ns1:hasOpeningThemeSong ns1:ForTheLoveOfMoney ;
    ns1:seasonNumbers 1,
        2,
        3,
        4,
        5,
        6,
        10 .

ns1:TheOJays a owl:NamedIndividual,
        ns1:MusicGroup ;
    rdfs:label "The O'Jays"^^xsd:string .

ns1:Celebrity a owl:Class ;
    rdfs:subClassOf ns1:Person .

ns1:ForTheLoveOfMoney a owl:NamedIndividual,
        ns1:Song ;
    rdfs:label "For the Love of Money"^^xsd:string ;
    ns1:composedBy ns1:TheOJays .

ns1:MusicGroup a owl:Class ;
    rdfs:subClassOf ns1:Organization .

ns1:Organization a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Song a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Hosting a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:MediaField a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Person a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Role a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:TelevisionSeries a owl:Class ;
    rdfs:subClassOf owl:Thing .