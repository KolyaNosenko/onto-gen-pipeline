@prefix ns1: <https://og.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<https://og.example.org/ontology> a owl:Ontology .

ns1:Chicago a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Chicago"^^xsd:string .

ns1:MississippiRiver a owl:NamedIndividual,
        ns1:GeographicFeature ;
    rdfs:label "Mississippi River"^^xsd:string .

ns1:NewYorkCity a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "New York City"^^xsd:string .

ns1:ObservationDeck a owl:Class ;
    rdfs:subClassOf ns1:Component .

ns1:OfficeSpace a owl:Class ;
    rdfs:subClassOf ns1:Component .

ns1:Philadelphia a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Philadelphia"^^xsd:string .

ns1:RetailFacility a owl:Class ;
    rdfs:subClassOf ns1:Component .

ns1:ShoppingMall a owl:Class ;
    rdfs:subClassOf ns1:Component .

ns1:WilshireGrandCenter a owl:NamedIndividual,
        ns1:Skyscraper ;
    rdfs:label "Wilshire Grand Center"^^xsd:string ;
    ns1:isPartOf ns1:WilshireGrandComplex ;
    ns1:isTallestBuildingIn ns1:California,
        ns1:LosAngeles,
        ns1:WestOfMississippiExcludingNYCChicagoPhilly ;
    ns1:locatedIn ns1:FinancialDistrict ;
    ns1:rankingAmongTallestBuildings 11 ;
    ns1:tallerThan ns1:USBankTower .

ns1:developmentCost a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:MixedUseComplex ;
    rdfs:range xsd:string .

ns1:includes a owl:ObjectProperty ;
    rdfs:domain ns1:MixedUseComplex ;
    rdfs:range ns1:Component .

ns1:isPartOf a owl:ObjectProperty ;
    rdfs:domain ns1:Building ;
    rdfs:range ns1:MixedUseComplex .

ns1:isTallestBuildingIn a owl:ObjectProperty ;
    rdfs:domain ns1:Building ;
    rdfs:range ns1:Location .

ns1:locatedIn a owl:ObjectProperty ;
    rdfs:domain ns1:Building ;
    rdfs:range ns1:Location .

ns1:locatedInRegion a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:Location ;
    rdfs:range ns1:Location .

ns1:numberOfHotelRooms a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Hotel ;
    rdfs:range xsd:integer .

ns1:rankingAmongTallestBuildings a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Building ;
    rdfs:range xsd:integer .

ns1:tallerThan a owl:ObjectProperty ;
    rdfs:domain ns1:Building ;
    rdfs:range ns1:Building .

ns1:DowntownLosAngeles a owl:NamedIndividual,
        ns1:District ;
    rdfs:label "Downtown Los Angeles"^^xsd:string ;
    ns1:locatedInRegion ns1:LosAngeles .

ns1:FinancialDistrict a owl:NamedIndividual,
        ns1:District ;
    rdfs:label "Financial District"^^xsd:string ;
    ns1:locatedInRegion ns1:DowntownLosAngeles .

ns1:GeographicFeature a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:InterContinentalHotel a owl:NamedIndividual,
        ns1:Hotel ;
    rdfs:label "InterContinental"^^xsd:string ;
    ns1:numberOfHotelRooms 900 .

ns1:Region a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:Skyscraper a owl:Class ;
    rdfs:subClassOf ns1:Building .

ns1:USBankTower a owl:NamedIndividual,
        ns1:Building ;
    rdfs:label "U.S. Bank Tower"^^xsd:string .

ns1:UnitedStates a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "United States"^^xsd:string .

ns1:WestOfMississippiExcludingNYCChicagoPhilly a owl:NamedIndividual,
        ns1:Region ;
    rdfs:label "West of Mississippi River excluding New York City, Chicago, and Philadelphia"^^xsd:string .

ns1:WilshireGrandComplex a owl:NamedIndividual,
        ns1:MixedUseComplex ;
    rdfs:label "Wilshire Grand Complex"^^xsd:string ;
    ns1:developmentCost "$1.2 billion"^^xsd:string ;
    ns1:includes ns1:InterContinentalHotel .

ns1:California a owl:NamedIndividual,
        ns1:State ;
    rdfs:label "California"^^xsd:string ;
    ns1:locatedInRegion ns1:UnitedStates .

ns1:District a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:Hotel a owl:Class ;
    rdfs:subClassOf ns1:Component .

ns1:LosAngeles a owl:NamedIndividual,
        ns1:City ;
    rdfs:label "Los Angeles"^^xsd:string ;
    ns1:locatedInRegion ns1:California .

ns1:State a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:City a owl:Class ;
    rdfs:subClassOf ns1:Location .

ns1:MixedUseComplex a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Component a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Building a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Location a owl:Class ;
    rdfs:subClassOf owl:Thing .