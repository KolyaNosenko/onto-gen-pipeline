:Organization a owl:Class .
:NaturistOrganization a owl:Class ;
    rdfs:subClassOf :Organization .
:Association a owl:Class ;
    rdfs:subClassOf :Organization .
:PersonGroup a owl:Class .
:Resort a owl:Class .
:Club a owl:Class .
:Business a owl:Class .
:Member a owl:Class .
:Country a owl:Class .
:Territory a owl:Class .
:Place a owl:Class .
:CityLikePlace a owl:Class ;
    rdfs:subClassOf :Place .
:Region a owl:Class ;
    rdfs:subClassOf :Place .
:Continent a owl:Class ;
    rdfs:subClassOf :Region .
:Event a owl:Class .
:FoundingEvent a owl:Class ;
    rdfs:subClassOf :Event .
:Name a owl:Class .
:Date a owl:Class .
