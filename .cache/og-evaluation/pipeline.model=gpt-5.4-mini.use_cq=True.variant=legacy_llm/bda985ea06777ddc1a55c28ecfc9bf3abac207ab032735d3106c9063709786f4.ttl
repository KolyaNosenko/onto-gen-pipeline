:Lobbying a owl:Class .
:Nudism a owl:Class .
:NudeRecreation a owl:Class .
:FamilyRecreation a owl:Class .
:MembershipFee a owl:Class .
:NaturalistActivity a owl:Class .

:hasAcronym a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Name .
:basedIn a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Place .
:foundedIn a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Date .
:hasPreviousName a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Name .
:hasSizeRank a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Quantity .
:hasAffiliatedOrganization a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Organization .
:servesMember a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Member .
:servesInPlace a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Place .
:promotes a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Benefit .
:worksToProtect a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Right .
:supportsNudismIn a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Setting .
:settingType a owl:ObjectProperty ;
    rdfs:domain :Setting ;
    rdfs:range :Place .
:usesPortionOf a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :MembershipFee .
:usesFor a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Campaign .
:usesForLobbying a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Lobbying .
:campaignsIn a owl:ObjectProperty ;
    rdfs:domain :Campaign ;
    rdfs:range :Country .
:lobbiesIn a owl:ObjectProperty ;
    rdfs:domain :Lobbying ;
    rdfs:range :Country .
:allowsNudismIn a owl:ObjectProperty ;
    rdfs:domain :Government ;
    rdfs:range :Country .

