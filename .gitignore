# coding-agent sandboxes: main.py + output.txt are transient (regenerated each run);
# engine/ and core/ duplicates are committed (sync via scripts/sync_envs.py).
src/og_sandbox_with_core/main.py
src/og_sandbox_with_core/output.txt
src/og_sandbox_with_core/**/__pycache__/
src/og_sandbox_no_core/main.py
src/og_sandbox_no_core/output.txt
src/og_sandbox_no_core/**/__pycache__/

# Per-run coding-agent event logs (transcript.md, events.jsonl, raw LLM completions)
logs/
